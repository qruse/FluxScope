{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fluxscope",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/_astro/*", "!/images/*", "!/pagefind/*", "!/favicon.svg", "!/comments.js", "!/image-dimensions.json"]
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "hslab.space", "custom_domain": true },
    { "pattern": "www.hslab.space", "custom_domain": true },
    { "pattern": "hslblog.com", "custom_domain": true },
    { "pattern": "www.hslblog.com", "custom_domain": true }
  ],
  "triggers": { "crons": ["17 0 * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "hsl-blog-posts",
    "database_id": "3c931e30-7828-4c30-b7e3-0a69441a5b25",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{
    "binding": "IMAGES",
    "bucket_name": "hsl-blog-images"
  }]
}
