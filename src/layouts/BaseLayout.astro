---
import '../styles/global.css';
import { site, withBase } from '../lib/site';
import { getLangFromUrl, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  lang?: Lang;
}

const {
  image = '/images/og-default.png',
  imageAlt = "HSL's Blog wordmark beside concentric focus rings",
  imageWidth = image === '/images/og-default.png' ? 1200 : undefined,
  imageHeight = image === '/images/og-default.png' ? 630 : undefined,
  noindex = false,
  type = 'website',
  publishedAt,
  updatedAt,
  jsonLd,
  lang,
} = Astro.props;

const currentLang: Lang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const defaultTitle = t('site.title');
const title = Astro.props.title || defaultTitle;
const description = Astro.props.description || t('site.description');

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(withBase(image), Astro.site);
const fullTitle = !Astro.props.title || title === defaultTitle || title === site.name ? defaultTitle : `${title} | ${defaultTitle}`;

// Language switcher link resolution
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname.slice(base.length).replace(/\/$/, '') || '/';
let koPath = '/';
let enPath = '/en/';

if (currentLang === 'en') {
  enPath = pathname === '/en' ? '/en/' : `${pathname}/`;
  const stripped = pathname.replace(/^\/en/, '');
  koPath = stripped ? `${stripped}/` : '/';
} else {
  koPath = pathname === '/' ? '/' : `${pathname}/`;
  enPath = pathname === '/' ? '/en/' : `/en${pathname}/`;
}

// Home pages declare the site name so search engines show and match "HSL의 블로그" / "HSL's Blog".
const websiteJsonLd = pathname === '/' || pathname === '/en' ? {
  '@context': 'https://schema.org', '@type': 'WebSite', name: defaultTitle,
  alternateName: [...new Set(['HSL의 블로그', "HSL's Blog", 'HSL Blog', 'hslblog'])].filter((name) => name !== defaultTitle),
  url: new URL(withBase(currentLang === 'en' ? '/en/' : '/'), Astro.site).href, inLanguage: currentLang,
  publisher: {
    '@type': 'Organization', name: defaultTitle, url: new URL(withBase(currentLang === 'en' ? '/en/' : '/'), Astro.site).href,
    logo: { '@type': 'ImageObject', url: new URL(withBase('/images/logo.png'), Astro.site).href, width: 512, height: 512 },
  },
} : undefined;

if (pathname === '/404' || pathname === '/404.html') {
  koPath = '/';
  enPath = '/en/';
}

const koUrl = withBase(koPath);
const enUrl = withBase(enPath);
const homeUrl = withBase(currentLang === 'en' ? '/en/' : '/');
const aiUrl = withBase(currentLang === 'en' ? '/en/ai/' : '/ai/');
const mobilityUrl = withBase(currentLang === 'en' ? '/en/mobility/' : '/mobility/');
const itDevicesUrl = withBase(currentLang === 'en' ? '/en/it-devices/' : '/it-devices/');
const rssUrl = withBase(currentLang === 'en' ? '/en/rss.xml' : '/rss.xml');
const searchUrl = withBase(currentLang === 'en' ? '/en/search/' : '/search/');
---
<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f6f5f1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="ko" href={new URL(koUrl, Astro.site).href} />
    <link rel="alternate" hreflang="en" href={new URL(enUrl, Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(enUrl, Astro.site).href} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/images/logo.png')} type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href={withBase('/images/logo.png')} />
    <link rel="alternate" type="application/rss+xml" title={`${defaultTitle} RSS`} href={rssUrl} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={defaultTitle} />
    <meta property="og:locale" content={currentLang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:locale:alternate" content={currentLang === 'ko' ? 'en_US' : 'ko_KR'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:alt" content={imageAlt} />
    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.href} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    {websiteJsonLd && <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd).replace(/</g, '\\u003c')} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
    <script is:inline>
      addEventListener('load', () => { try { if (navigator.sendBeacon && !navigator.webdriver) navigator.sendBeacon('/api/views', JSON.stringify({ page: location.pathname })); } catch {} });
    </script>
    <script is:inline define:vars={{ base: import.meta.env.BASE_URL }}>
      try {
        const savedTheme = localStorage.getItem('theme');
        document.documentElement.dataset.theme = savedTheme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch (_) {}

      try {
        // Only a language the visitor chose is remembered. Never redirect by browser language:
        // crawlers render with en-US and would never see the Korean home page.
        const currentPath = window.location.pathname;
        const normalizedBase = base.replace(/\/$/, '');
        const relativePath = normalizedBase ? currentPath.replace(normalizedBase, '') : currentPath;
        const trimmed = relativePath.replace(/\/$/, '') || '/';
        const isRoot = trimmed === '/' || trimmed === '/en';

        const savedLang = localStorage.getItem('lang-pref');

        if (isRoot) {
          if (savedLang === 'en' && trimmed === '/') {
            window.location.replace(`${normalizedBase}/en/`);
          } else if (savedLang === 'ko' && trimmed === '/en') {
            window.location.replace(`${normalizedBase}/`);
          }
        }
      } catch (_) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={homeUrl} aria-label={`${t('site.title')} home`}>
          <span class="brand-mark" aria-hidden="true"><span></span></span>
          <span>HSL<span class="brand-accent">{currentLang === 'ko' ? '의 블로그' : "'s Blog"}</span></span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          <a href={aiUrl} class="nav-link-major">{t('nav.ai')}</a>
          <a href={mobilityUrl} class="nav-link-major">{t('nav.mobility')}</a>
          <a href={itDevicesUrl} class="nav-link-major">{t('nav.it_devices')}</a>
        </nav>
        <div class="header-actions">
          <div class="lang-switcher" aria-label="Language selection">
            <a href={koUrl} class:list={[{ active: currentLang === 'ko' }]} hreflang="ko">KO</a>
            <span class="lang-divider" aria-hidden="true">/</span>
            <a href={enUrl} class:list={[{ active: currentLang === 'en' }]} hreflang="en">EN</a>
          </div>
          <a class="icon-link" href={searchUrl} aria-label={t('nav.search')} title={t('nav.search')}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.6"></circle><path d="m16 16 5 5"></path></svg>
          </a>
          <button class="theme-toggle" type="button" aria-label="Toggle color theme" title="Toggle color theme">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.2A8.8 8.8 0 0 1 8.8 3.8 8.8 8.8 0 1 0 20.2 15.2Z"></path></svg>
          </button>
        </div>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="footer-brand" href={homeUrl}>{t('site.title')}<span class="brand-dot" aria-hidden="true"></span></a>
          <p>{t('footer.motto')}</p>
        </div>
        <div class="footer-links">
          <a href={rssUrl}>{t('footer.rss')}</a>
          <a href={searchUrl}>{t('footer.search')}</a>
          <a href={withBase(currentLang === 'en' ? '/en/privacy/' : '/privacy/')}>{t('footer.privacy')}</a>
        </div>
        <p class="footer-copy">© {new Date().getFullYear()} {t('site.title')}</p>
      </div>
    </footer>
    <div id="image-lightbox" class="image-lightbox" role="dialog" aria-modal="true" aria-label="Image Zoom Preview" aria-hidden="true">
      <button class="image-lightbox-close" type="button" aria-label="Close image zoom" title="Close (Esc)">
        <svg viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"></path></svg>
      </button>
      <div class="image-lightbox-dialog" id="image-lightbox-dialog">
        <div id="image-lightbox-caption" class="image-lightbox-caption"></div>
      </div>
    </div>
    <script>
      const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
      button?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (_) {}
      });

      // 언어 스위처 클릭 시 사용자 선호 언어 저장
      document.querySelectorAll<HTMLAnchorElement>('.lang-switcher a').forEach((link) => {
        link.addEventListener('click', () => {
          const lang = link.getAttribute('hreflang');
          if (lang) {
            try { localStorage.setItem('lang-pref', lang); } catch (_) {}
          }
        });
      });

      // 이미지 클릭 시 확대 (Image Zoom Lightbox)
      const lightbox = document.getElementById('image-lightbox');
      const dialog = document.getElementById('image-lightbox-dialog');
      const lightboxCaption = document.getElementById('image-lightbox-caption');

      function openLightbox(img: HTMLImageElement) {
        if (!lightbox || !dialog) return;

        // Clean up previous image if any
        const existingImg = dialog.querySelector<HTMLImageElement>('.image-lightbox-img');
        if (existingImg) existingImg.remove();

        const newImg = document.createElement('img');
        newImg.className = 'image-lightbox-img';
        newImg.src = img.currentSrc || img.src;
        newImg.alt = img.alt || '';
        newImg.decoding = 'async';
        dialog.insertBefore(newImg, lightboxCaption);

        if (lightboxCaption) {
          lightboxCaption.textContent = img.alt || '';
          lightboxCaption.style.display = img.alt ? 'block' : 'none';
        }
        lightbox.classList.add('active');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        if (!lightbox) return;
        lightbox.classList.remove('active');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        setTimeout(() => {
          if (!lightbox.classList.contains('active')) {
            const activeImg = dialog?.querySelector<HTMLImageElement>('.image-lightbox-img');
            if (activeImg) activeImg.remove();
          }
        }, 250);
      }

      document.querySelectorAll<HTMLImageElement>('.article-body img, .article-visual').forEach((img) => {
        img.addEventListener('click', (e) => {
          e.stopPropagation();
          openLightbox(img);
        });
      });

      lightbox?.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target === lightbox || target.closest('.image-lightbox-close') || target.classList.contains('image-lightbox-img')) {
          closeLightbox();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && lightbox?.classList.contains('active')) {
          closeLightbox();
        }
      });
    </script>
  </body>
</html>
