---
// Portfolio: career, projects, research, awards and teaching, compiled from the owner's CVs.
// The owner's name, photo and personal contact details stay off the page; the only contact is the public email.
// Sections are numbered and ruled like the lab home entries; all styles are inline below.
import BaseLayout from '../layouts/BaseLayout.astro';
import LabMark from './LabMark.astro';
import LabSketch from './LabSketch.astro';
import { labSectionPath, labSections, projectPath, projects } from '../lib/site';
import { portfolio, portfolioEmail } from '../lib/portfolio';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const isKo = lang === 'ko';
const L = (ko: string, en: string) => (isKo ? ko : en);
const email = portfolioEmail;
const stories = labSections.find((section) => section.id === 'stories')!;
const weather = projects.find((p) => p.id === 'beat-kma')!;

const { career, education, domains, domainName, work, papers, awards, teaching, hours, longest, barWidth, stats, skills } = portfolio(lang);
// The three main client projects, each written up on the case-studies page.
const casesHref = `${labSectionPath(labSections.find((section) => section.id === 'portfolio')!, lang)}case-studies/`;
const cases = [
  { id: 'leak', field: L('이상 탐지 · 상수도', 'Anomaly detection · water'), title: L('유량 데이터로 누수 찾기', 'Finding leaks in flow data'), v: '90%', k: 'Accuracy', sub: 'F1 0.63 · XGBoost', d: L('기록이 불완전한 현장 데이터를 역추적 라벨링하고, 고정 직선 기준을 EMA 동적 기준선과 분류 모델로 바꿈.', 'Back-traced labels for incomplete field records, then a moving EMA baseline and a classifier in place of a fixed line.') },
  { id: 'greenhouse', field: L('시계열 예측 · 스마트팜', 'Forecasting · smart farming'), title: L('온실 환경 시계열 예측 AI', 'Forecasting the greenhouse climate'), v: '92%', k: 'R²', sub: 'MAE 1.1℃ · PatchTST', d: L('환경·제어·기상 예보를 스트림별로 학습하고, 추세 분해로 계절 변화에도 버티는 24시간 예측.', 'Climate, control and weather streams learned separately, with trend decomposition to hold up across seasons.') },
  { id: 'report', field: L('LLM Agent · 스마트팜', 'LLM agents · smart farming'), title: L('LLM Agent 컨설팅 리포트', 'LLM-agent consulting reports'), v: L('주간', 'Weekly'), k: L('농가별 리포트', 'per-farm report'), sub: 'LangGraph · PDF · Web', d: L('컨설턴트의 진단 과정을 에이전트 워크플로로 옮겨 그래프·표·실행 제언이 담긴 리포트를 자동 생성.', 'A consultant’s diagnosis rebuilt as an agent workflow that writes reports with charts, tables and concrete actions.') },
];

const sections = [
  ['pf-now', L('지금 만드는 것', 'Building now')],
  ['pf-cases', L('주요 프로젝트', 'Case studies')],
  ['pf-career', L('경력', 'Career')],
  ['pf-work', L('프로젝트', 'Projects')],
  ['pf-research', L('연구', 'Research')],
  ['pf-awards', L('수상', 'Awards')],
  ['pf-teaching', L('강의', 'Teaching')],
];
const num = (id: string) => String(sections.findIndex(([s]) => s === id) + 1).padStart(2, '0');
---
<BaseLayout lang={lang} title={L('포트폴리오', 'Portfolio')} description={L('2020년부터 해 온 데이터·AI 프로젝트, 논문, 수상, 강의를 한 페이지에 정리함.', 'Data and AI projects, papers, awards and teaching since 2020, on one page.')}>
  <header class="pf-hero"><div class="shell pf-hero-grid">
    <div>
      <div class="section-kicker"><LabMark id="portfolio" />{L('포트폴리오', 'Portfolio')}</div>
      <h1>{L('데이터로 문제를 풀어 온', 'Solving problems with data')} <em>{L('6년', 'for six years')}</em></h1>
      <p class="pf-lede">{L('경영정보시스템을 공부했고, 2020년부터 시계열 예측, 이상거래 탐지, 텍스트 분석, LLM 프로젝트를 해 옴. 공동 창업한 회사에서 분석팀과 연구소를 맡았고, 지금은 R&D 연구원으로 일함.', 'Trained in management information systems. Since 2020: forecasting, fraud detection, text analysis and LLM projects. Co-founded a company and ran its analysis team and lab; now an R&D researcher.')}</p>
      <dl class="pf-meta">
        <div><dt>{L('지금', 'Now')}</dt><dd>{L('스마트팜 기업 선임연구원', 'Senior researcher at a smart-farm company')}</dd></div>
        <div><dt>{L('분야', 'Focus')}</dt><dd>{L('시계열 예측 · 이상 탐지 · NLP/LLM', 'Forecasting · anomaly detection · NLP/LLM')}</dd></div>
        <div><dt>{L('이메일', 'Email')}</dt><dd><a class="pen-under" href={`mailto:${email}`}>{email}</a></dd></div>
      </dl>
    </div>
    <LabSketch />
  </div></header>

  <div class="shell">
    <dl class="pf-band">
      {stats.map((s) => <div><dt>{s.n}<small>{s.s}</small></dt><dd>{isKo ? s.ko : s.en}</dd></div>)}
    </dl>
  </div>

  <nav class="pf-toc" aria-label={L('목차', 'Contents')}><div class="shell">
    {sections.map(([id, label], i) => <a href={`#${id}`}><span>{String(i + 1).padStart(2, '0')}</span>{label}</a>)}
  </div></nav>

  <div class="shell pf-body">
    <section id="pf-now" class="pf-sec">
      <span class="pf-num">{num('pf-now')}</span>
      <div class="pf-sec-body">
        <h2>{L('지금 만드는 것', 'Building now')}</h2>
        <div class="pf-feature">
          <div>
            <p class="pf-eyebrow">{L('개인 프로젝트 · 2026', 'Side project · 2026')}</p>
            <h3><a class="pen-under" href={projectPath(weather.id, lang)}>{isKo ? weather.nameKo : weather.name}</a></h3>
            <p class="pf-copy">{isKo ? weather.summaryKo : weather.summary}</p>
            <p class="pf-stack">Aurora 1.5 <i>·</i> PyTorch <i>·</i> LightGBM <i>·</i> Cloudflare Workers</p>
            <div class="pf-actions">
              <a class="lab-cta" href={projectPath(weather.id, lang)}>{L('오늘 예보 보기', "See today's forecast")}<span aria-hidden="true">→</span></a>
              <a class="pf-link" href={labSectionPath(stories, lang)}>{L('만든 과정 1~4편', 'How it was built')} →</a>
            </div>
          </div>
          <a class="taped pf-shot" href={projectPath(weather.id, lang)} tabindex="-1"><img src="/images/projects/beat-kma-forecast.webp" width="1100" height="1051" loading="lazy" decoding="async" alt={L('97개 관측소 지도와 서울 예보 카드가 보이는 예보 화면', 'Forecast page with the Seoul card and the 97-station map')} /></a>
        </div>
      </div>
    </section>

    <section id="pf-cases" class="pf-sec">
      <span class="pf-num">{num('pf-cases')}</span>
      <div class="pf-sec-body">
        <div class="pf-cases-head">
          <h2>{L('주요 수행 프로젝트', 'Case studies')}</h2>
          <a class="pf-link" href={casesHref}>{L('문제와 해결 과정 자세히 보기', 'Read the full case studies')} →</a>
        </div>
        <ol class="pf-cases">
          {cases.map((c, i) => (
            <li><a href={`${casesHref}#${c.id}`}>
              <span class="pf-case-top"><b>{String(i + 1).padStart(2, '0')}</b>{c.field}</span>
              <h3>{c.title}</h3>
              <span class="pf-case-metric"><strong>{c.v}</strong><span>{c.k}<small>{c.sub}</small></span></span>
              <p>{c.d}</p>
              <span class="pf-case-go" aria-hidden="true">→</span>
            </a></li>
          ))}
        </ol>
      </div>
    </section>

    <section id="pf-career" class="pf-sec">
      <span class="pf-num">{num('pf-career')}</span>
      <div class="pf-sec-body pf-split">
        <div>
          <h2>{L('경력', 'Career')}</h2>
          <ol class="pf-rows">
            {career.map((c, i) => (
              <li>
                <span class="pf-when">{c.period}</span>
                <div><h3>{c.org}{i === 0 && <b class="pf-now">{L('재직 중', 'Current')}</b>}</h3><p class="pf-role">{c.role}</p><p>{c.text}</p></div>
              </li>
            ))}
          </ol>
        </div>
        <div>
          <h2 class="pf-h-sm">{L('학력', 'Education')}</h2>
          <ol class="pf-rows is-compact">
            {education.map((e) => <li><span class="pf-when">{e.year}</span><div><p class="pf-strong">{isKo ? e.ko : e.en}</p><p>{L('경북대학교 경영학부', 'Kyungpook National University')}</p></div></li>)}
          </ol>
          <h2 class="pf-h-sm">{L('기술', 'Skills')}</h2>
          <dl class="pf-skills">
            {skills.map((g) => <div><dt>{isKo ? g.ko : g.en}</dt><dd>{g.items.join(' · ')}</dd></div>)}
          </dl>
        </div>
      </div>
    </section>

    <section id="pf-work" class="pf-sec">
      <span class="pf-num">{num('pf-work')}</span>
      <div class="pf-sec-body">
        <h2>{L('프로젝트', 'Projects')}</h2>
        <div class="pf-tabs" role="radiogroup" aria-label={L('분야', 'Field')}>
          <label><input type="radio" name="pf-d" value="all" checked /><span>{L('전체', 'All')}<sup>{work.length}</sup></span></label>
          {domains.map((d) => <label><input type="radio" name="pf-d" value={d.id} /><span><i class={`pf-sw is-${d.id}`}></i>{isKo ? d.ko : d.en}<sup>{work.filter((w) => w.d === d.id).length}</sup></span></label>)}
        </div>
        <ol class="pf-list">
          {work.map((w) => (
            <li data-d={w.d}>
              <span class="pf-when">{w.period}</span>
              <div><h3>{w.case ? <a href={`${casesHref}#${w.case}`}>{isKo ? w.ko : w.en}<b class="pf-case-tag">{L('사례', 'Case study')} →</b></a> : (isKo ? w.ko : w.en)}</h3><p>{w.org}</p></div>
              <span class="pf-field"><i class={`pf-sw is-${w.d}`}></i>{domainName(w.d)}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="pf-research" class="pf-sec">
      <span class="pf-num">{num('pf-research')}</span>
      <div class="pf-sec-body">
        <h2>{L('연구', 'Research')}</h2>
        <div class="pf-patent">
          <span class="pf-badge">{L('특허 출원 · 2020', 'Patent filed · 2020')}</span>
          <h3>{L('악성 댓글 분류장치 및 그 방법', 'Device and method for classifying abusive comments')}</h3>
          <p>{L('하이웨이 네트워크 CNN 논문, 노코멘트 API와 같은 연구에서 나옴.', 'From the same work as the highway-network CNN paper and the Know Comment API.')}</p>
        </div>
        <h2 class="pf-h-sm">{L('논문', 'Papers')} <sup>{papers.length}</sup></h2>
        <ol class="pf-rows is-papers">
          {papers.map((p) => <li><span class="pf-when">{p.date}</span><div><h3>{p.title}</h3><p><b class="pf-kind">{p.conf ? L('학술대회', 'Conference') : 'KCI'}</b>{p.venue}</p></div></li>)}
        </ol>
      </div>
    </section>

    <section id="pf-awards" class="pf-sec">
      <span class="pf-num">{num('pf-awards')}</span>
      <div class="pf-sec-body">
        <h2>{L('수상', 'Awards')}</h2>
        <ul class="pf-awards">
          {awards.map((a) => (
            <li class={a.top ? 'is-top' : undefined}>
              <span class="pf-rank">{a.rank}</span>
              <h3>{isKo ? a.ko : a.en}</h3>
              <p class="pf-note">{a.note}</p>
              <p class="pf-by">{a.by} · {a.date}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="pf-teaching" class="pf-sec">
      <span class="pf-num">{num('pf-teaching')}</span>
      <div class="pf-sec-body">
        <h2>{L('강의 · 교육', 'Teaching')}</h2>
        <div class="pf-teach">
          <div class="pf-total">
            <strong>{hours}<small>h+</small></strong>
            <p>{L(`2020~2024년 ${teaching.length}개 과정. 시간이 기록된 과정만 더한 값이고, 교재 280쪽 집필과 강의 촬영도 포함.`, `${teaching.length} courses from 2020 to 2024. Only courses with recorded hours are summed; a 280-page textbook and recorded courses are among them.`)}</p>
          </div>
          <div class="pf-bars">
            <p class="pf-eyebrow">{L('가장 길었던 과정', 'Longest courses')}</p>
            {longest.map((t) => (
              <div class="pf-bar">
                <span class="pf-bar-label">{isKo ? t.ko : t.en}<small>{t.org}</small></span>
                <span class="pf-bar-track"><span style={barWidth(t.h)}></span></span>
                <span class="pf-bar-val">{t.h}h</span>
              </div>
            ))}
          </div>
        </div>
        <details class="pf-details">
          <summary>{L(`전체 ${teaching.length}개 과정 보기`, `All ${teaching.length} courses`)}</summary>
          <table>
            <thead><tr><th>{L('기간', 'When')}</th><th>{L('기관', 'Where')}</th><th>{L('주제', 'Topic')}</th><th>{L('시간', 'Hours')}</th></tr></thead>
            <tbody>{teaching.map((t) => <tr><td>{t.date}</td><td>{t.org}</td><td>{isKo ? t.ko : t.en}</td><td>{t.h ? `${t.h}h` : '—'}</td></tr>)}</tbody>
          </table>
        </details>
      </div>
    </section>
  </div>

<script is:inline>
  // Sections rise in as they scroll into view, and the contents bar marks the section being read.
  (() => {
    if (!('IntersectionObserver' in window)) return;
    const root = document.documentElement;
    const secs = [...document.querySelectorAll('.pf-sec')];
    const links = new Map([...document.querySelectorAll('.pf-toc a')].map((a) => [a.hash.slice(1), a]));
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.add('pf-motion');
      const reveal = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); reveal.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      secs.forEach((s) => reveal.observe(s));
    }
    const spy = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach((a) => a.removeAttribute('aria-current'));
      links.get(e.target.id)?.setAttribute('aria-current', 'true');
    }), { rootMargin: '-40% 0px -55% 0px' });
    secs.forEach((s) => spy.observe(s));
  })();
</script>

<style is:inline>
.pf-hero { padding: 4.6rem 0 2.6rem; }
.pf-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, 320px); gap: 3rem; align-items: end; }
.pf-hero h1 { max-width: 15ch; margin: .8rem 0 1.2rem; font-size: clamp(2.6rem, 5.6vw, 4.8rem); font-weight: 820; line-height: 1.04; letter-spacing: -.065em; word-break: keep-all; }
.pf-hero h1 em { font-style: normal; color: var(--accent); }
.pf-lede { max-width: 620px; margin: 0; color: var(--muted); font-size: 1.05rem; line-height: 1.75; word-break: keep-all; }
.pf-meta { display: flex; flex-wrap: wrap; gap: 1rem 2.6rem; margin: 2rem 0 0; }
.pf-meta div { display: grid; gap: .3rem; }
.pf-meta dt { color: var(--muted); font-size: .7rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
.pf-meta dd { margin: 0; font-size: .95rem; font-weight: 700; }
.pf-meta a { color: var(--pen); }
.pf-meta a:hover::after { clip-path: inset(0); }
.pf-hero .lab-sketch { max-width: 300px; margin-bottom: .5rem; }

.pf-band { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); margin: 0; border-top: 2px solid var(--ink); border-bottom: 1px solid var(--line); }
.pf-band div { padding: 1.5rem 1.2rem 1.4rem; }
.pf-band div + div { border-left: 1px solid var(--line); }
.pf-band dt { font-size: clamp(2.2rem, 4vw, 3.3rem); font-weight: 820; line-height: 1; letter-spacing: -.06em; font-variant-numeric: tabular-nums; }
.pf-band dt small { margin-left: .06em; color: var(--accent); font-size: .5em; letter-spacing: -.02em; }
.pf-band dd { margin: .6rem 0 0; color: var(--muted); font-size: .84rem; font-weight: 650; }

.pf-toc { position: sticky; top: 0; z-index: 5; margin-top: 2.4rem; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
.pf-toc .shell { display: flex; gap: 1.8rem; overflow-x: auto; scrollbar-width: none; }
.pf-toc a { position: relative; flex: none; display: inline-flex; gap: .45rem; padding: .95rem 0 .85rem; color: var(--muted); font-size: .86rem; font-weight: 750; transition: color .2s; }
.pf-toc a span { color: var(--pen); font-variant-numeric: tabular-nums; opacity: .7; }
.pf-toc a::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform .35s cubic-bezier(.2, .7, .2, 1); }
.pf-toc a:hover, .pf-toc a[aria-current] { color: var(--ink); }
.pf-toc a[aria-current]::after { transform: scaleX(1); }

.pf-body { padding-bottom: 6rem; }
.pf-sec { position: relative; display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: clamp(1.4rem, 3vw, 2.6rem); padding: 3.6rem 0 3rem; border-top: 1px solid var(--line); scroll-margin-top: 3.4rem; }
.pf-sec:first-child { border-top: 0; }
.pf-num { color: var(--ink); font-size: clamp(2rem, 3.4vw, 2.8rem); font-weight: 800; line-height: 1; letter-spacing: -.05em; font-variant-numeric: tabular-nums; transition: color .4s; }
.pf-sec.is-in .pf-num, .pf-sec:hover .pf-num { color: var(--accent); }
.pf-sec h2 { margin: 0 0 2rem; font-size: clamp(1.8rem, 3.2vw, 2.6rem); font-weight: 760; line-height: 1.08; letter-spacing: -.05em; }
.pf-sec h2.pf-h-sm { margin: 2.8rem 0 1.1rem; font-size: 1.05rem; font-weight: 800; letter-spacing: -.01em; }
.pf-split > div > h2.pf-h-sm:first-child { margin-top: .55rem; }
.pf-sec h2 sup, .pf-tabs sup { margin-left: .3em; color: var(--accent); font-size: .62em; font-weight: 800; vertical-align: super; }
.pf-eyebrow { margin: 0 0 .7rem; color: var(--accent); font-size: .72rem; font-weight: 850; letter-spacing: .16em; text-transform: uppercase; }
.pf-when { color: var(--muted); font-size: .8rem; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: .01em; white-space: nowrap; }

.pf-feature { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(2rem, 4vw, 3.6rem); align-items: start; }
.pf-feature h3 { display: inline-block; margin: 0 0 1rem; font-size: clamp(1.5rem, 2.6vw, 2.05rem); font-weight: 780; line-height: 1.15; letter-spacing: -.045em; }
.pf-feature h3 a:hover { color: var(--accent); }
.pf-feature h3 a:hover::after { clip-path: inset(0); }
.pf-copy { margin: 0; color: var(--muted); line-height: 1.75; word-break: keep-all; }
.pf-stack { margin: 1.2rem 0 0; font-size: .84rem; font-weight: 700; }
.pf-stack i { color: var(--accent); font-style: normal; margin: 0 .2rem; }
.pf-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.6rem; margin-top: 1.8rem; }
.pf-actions .lab-cta { margin-top: 0; }
.pf-link { font-size: .88rem; font-weight: 800; border-bottom: 1px solid var(--line); padding-bottom: .15rem; transition: border-color .2s, color .2s; }
.pf-link:hover { color: var(--accent); border-color: var(--accent); }
.pf-shot { --tilt: 1.2deg; --tape-tilt: -4deg; }

.pf-cases-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .6rem 2rem; margin-bottom: 2rem; }
.pf-cases-head h2 { margin: 0; }
.pf-cases { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem; margin: 0; padding: 0; list-style: none; }
.pf-cases a { position: relative; display: grid; grid-template-rows: auto auto auto 1fr; gap: .8rem; height: 100%; padding: 1.4rem 1.4rem 3rem; border-top: 3px solid var(--ink); background: var(--surface); box-shadow: 0 1px 2px rgba(0, 0, 0, .06), 0 18px 30px -26px rgba(0, 0, 0, .5); transition: transform .3s cubic-bezier(.2, .7, .2, 1), border-color .2s, box-shadow .3s; }
.pf-cases a:hover { transform: translateY(-4px); border-color: var(--accent); box-shadow: 0 1px 2px rgba(0, 0, 0, .06), 0 26px 40px -28px rgba(0, 0, 0, .6); }
