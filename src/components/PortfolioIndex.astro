---
// Portfolio: career, projects, research, awards and teaching, compiled from the owner's CVs.
// The owner's name, photo and personal contact details stay off the page; the only contact is the public email.
import BaseLayout from '../layouts/BaseLayout.astro';
import { labSectionPath, labSections, projectPath, projects } from '../lib/site';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const isKo = lang === 'ko';
const L = (ko: string, en: string) => (isKo ? ko : en);
const email = 'coolwin200@gmail.com';
const stories = labSections.find((section) => section.id === 'stories')!;
const weather = projects[0];

const stats = [
  { n: '6+', ko: '년차 실무', en: 'years in industry' },
  { n: '15+', ko: '분석·개발 프로젝트', en: 'analysis and build projects' },
  { n: '5', ko: 'KCI 논문 · 특허 1', en: 'KCI papers · 1 patent' },
  { n: '470h+', ko: '강의 (기록된 것만)', en: 'of teaching on record' },
];

const career = [
  { period: '2024.12 –', org: L('그리트㈜', 'Grit Inc.'), role: L('연구개발팀 선임연구원', 'Senior researcher, R&D team'), text: L('AI·데이터 연구개발.', 'AI and data R&D.'), now: true },
  { period: '2020.07 – 2024.11', org: L('㈜빅웨이브에이아이', 'BigWave AI'), role: L('공동 창업 · 데이터분석 팀장 · 기업부설연구소장', 'Co-founder · data analysis lead · head of the corporate lab'), text: L('AI·빅데이터 분석 연구 총괄, 프로젝트 관리, 분석 실무, 백엔드 개발, 교육, 특허.', 'Led AI and data research, ran projects, did the analysis, built back ends, taught and filed a patent.') },
];

const education = [
  { year: '2022.02', ko: '경북대학교 경영학부 경영정보시스템 박사과정 수료', en: 'PhD coursework completed, Management Information Systems, Kyungpook National University' },
  { year: '2020.02', ko: '경북대학교 경영학부 경영정보시스템 석사', en: 'MS, Management Information Systems, Kyungpook National University' },
  { year: '2018.02', ko: '경북대학교 경영학부 학사', en: 'BBA, Kyungpook National University' },
];

type Domain = 'ts' | 'anomaly' | 'nlp' | 'data';
const domains: { id: Domain; ko: string; en: string }[] = [
  { id: 'ts', ko: '시계열 예측', en: 'Forecasting' },
  { id: 'anomaly', ko: '이상 탐지', en: 'Anomaly detection' },
  { id: 'nlp', ko: '텍스트 · LLM', en: 'Text · LLM' },
  { id: 'data', ko: '데이터 분석', en: 'Data analysis' },
];
const work: { period: string; org: string; d: Domain; ko: string; en: string; tags: string[] }[] = [
  { period: '2024.06 – 2024.10', org: L('㈜오든', 'Oden'), d: 'anomaly', ko: '스마트부표 센서 바이오파울링 이상 탐지 시스템 개발', en: 'Biofouling anomaly detection for smart-buoy sensors', tags: ['Python', L('이상 탐지', 'Anomaly detection')] },
  { period: '2024.06 – 2024.07', org: 'DIP', d: 'data', ko: '지역 메가프로젝트 중복성 검토 사업 자문', en: 'Overlap review advisory for regional mega projects', tags: [L('자문', 'Advisory')] },
  { period: '2023.07 – 2023.11', org: L('그리트㈜', 'Grit Inc.'), d: 'ts', ko: '스마트팜 온실 환경 시뮬레이션 시스템 개발', en: 'Greenhouse environment simulation for smart farms', tags: ['Python', L('시계열 예측', 'Forecasting')] },
  { period: '2023.06 – 2023.11', org: L('대구일보', 'Daegu Ilbo'), d: 'nlp', ko: 'LLM 기반 자동 기사 생성 프롬프트 엔지니어링', en: 'Prompt engineering for LLM-written news articles', tags: ['LLM', L('프롬프트', 'Prompting')] },
  { period: '2022.08 –', org: 'KB', d: 'anomaly', ko: 'FDS(이상거래 탐지) 시스템 구축', en: 'Fraud detection system build', tags: ['PyTorch', 'FDS'] },
  { period: '2022.06 – 2022.10', org: L('㈜오든', 'Oden'), d: 'ts', ko: '스마트부표 수온 예측 시스템 개발 (데이터바우처)', en: 'Water-temperature forecasting for smart buoys (data voucher)', tags: ['PyTorch', L('시계열 예측', 'Forecasting')] },
  { period: '2022.05 – 2022.07', org: 'DIP', d: 'data', ko: '대구시 3대 주력산업 정책보고서 분석', en: "Policy report on Daegu's three key industries", tags: [L('정책 분석', 'Policy analysis')] },
  { period: '2022.01 – 2022.03', org: 'KERIS', d: 'nlp', ko: '텍스트마이닝 프로젝트', en: 'Text mining project', tags: ['TensorFlow', L('텍스트마이닝', 'Text mining')] },
  { period: '2020.06 – 2021.12', org: L('경북대학교 · DYETEC', 'KNU · DYETEC'), d: 'nlp', ko: '섬유소재 산업 빅데이터 플랫폼: 딥러닝 텍스트마이닝, 토픽모델링, 비즈니스 모델 연구', en: 'Textile industry data platform: deep-learning text mining, topic models, business models', tags: [L('토픽모델링', 'Topic models'), 'DETM'] },
  { period: '2021.02 – 2021.05', org: 'DYETEC', d: 'data', ko: '염가공 색채 예측 알고리즘 고도화', en: 'Better colour prediction for textile dyeing', tags: ['Python', L('정형 데이터', 'Tabular')] },
  { period: '2020.11 – 2021.03', org: L('한국가스공사', 'KOGAS'), d: 'ts', ko: '에너지 사용량 예측 모델 고도화, 관련 알고리즘 연구', en: 'Energy-use forecasting model upgrade and algorithm research', tags: [L('딥러닝', 'Deep learning'), L('시계열 예측', 'Forecasting')] },
  { period: '2020', org: L('노코멘트 API', 'Know Comment API'), d: 'nlp', ko: '악성 댓글 분류 API (논문·특허로 이어짐)', en: 'Abusive-comment classification API (led to a paper and a patent)', tags: ['CNN', 'NLP'] },
  { period: '2020.10 – 2020.12', org: L('한국건설기술연구원', 'KICT'), d: 'data', ko: '학습 데이터 수집·레이블링, 프로세스 관리', en: 'Training data collection, labelling and process management', tags: [L('데이터 구축', 'Data building')] },
  { period: '2020.07 – 2021.09', org: L('대구시설공단', 'Daegu Facilities Corp.'), d: 'data', ko: '나드리콜(교통약자 이동 지원) 운영 데이터 지리 분석·시각화, 2회 수행', en: 'Geographic analysis of accessible-transport operations, done twice', tags: ['Python', L('시각화', 'Visualization')] },
  { period: '2019.03 – 2019.12', org: L('경북대학교', 'KNU'), d: 'data', ko: '빅데이터 분석·시각화 프로젝트와 보고서', en: 'Data analysis and visualization project with reports', tags: ['Python', 'Excel'] },
];

const papers = [
  { date: '2021.09', venue: L('정보시스템연구', 'The Journal of Information Systems'), title: L('섬유소재 분야 특허 기술 동향 분석: DETM & STM 텍스트마이닝 방법론 활용', 'Patent trends in textile materials with DETM and STM text mining') },
  { date: '2020.12', venue: L('한국정보통신학회', 'KIICE'), title: 'Bias & Hate Speech Detection Using Deep Learning: Multi-channel CNN Modeling with Attention' },
  { date: '2020.09', venue: L('정보시스템연구 29(3)', 'The Journal of Information Systems 29(3)'), title: L('하이웨이 네트워크 기반 CNN 모델링 및 사전 외 어휘 처리 기술을 활용한 악성 댓글 분류 연구', 'Abusive comment classification with highway-network CNNs and out-of-vocabulary handling') },
  { date: '2020.03', venue: L('정보시스템연구', 'The Journal of Information Systems'), title: 'LSTM-based Deep Learning for Time Series Forecasting: The Case of Corporate Credit Score Prediction' },
  { date: '2019.06', venue: L('인터넷전자상거래연구', 'The Journal of Internet Electronic Commerce Research'), title: 'Multi-phase Prediction Models for Crowdfunding Success: A Machine Learning Approach' },
];

const awards = [
  { rank: L('1등', '1st'), date: '2022.09', ko: '2022 스마트농업경진대회 해커톤 · 농림축산식품부 장관상', en: '2022 Smart Agriculture Hackathon · Minister of Agriculture award', by: L('농림수산식품교육문화정보원', 'EPIS'), hot: true },
  { rank: L('루키', 'Rookie'), date: '2021.11', ko: '2021 스타트업 어워즈 루키상 (회사 수상)', en: '2021 Startup Awards, Rookie (company award)', by: L('대구시', 'Daegu City') },
  { rank: L('2등', '2nd'), date: '2020.11', ko: '대·스타 해결사 플랫폼 AI CHAMPIONSHIP 2020', en: 'AI Championship 2020', by: L('중소벤처기업부', 'Ministry of SMEs and Startups') },
  { rank: L('1등', '1st'), date: '2020.06', ko: '2020 인공지능 경진대회 텍스트 분야 1등 · 400팀 중 종합 10위', en: '2020 AI Competition, 1st in text · 10th of 400 teams overall', by: L('과학기술정보통신부', 'Ministry of Science and ICT'), hot: true },
  { rank: L('최우수', 'Best'), date: '2019.05', ko: '최우수 논문상 (시계열 딥러닝)', en: 'Best paper award (time-series deep learning)', by: L('한국정보시스템학회', 'KAIS') },
  { rank: L('최우수', 'Best'), date: '2018.11', ko: '최우수 논문상 (정형 데이터 분석)', en: 'Best paper award (tabular data analysis)', by: L('한국정보시스템학회', 'KAIS') },
];

const teaching: { date: string; org: string; ko: string; en: string; h?: number }[] = [
  { date: '2023.05 – 10', org: L('DIP · 대구은행', 'DIP · DGB'), ko: '금융 빅데이터 분석 교육', en: 'Financial data analysis course' },
  { date: '2022.08', org: L('영진직업전문학교', 'Yeungjin Vocational School'), ko: '인공지능 모델 배포', en: 'Deploying AI models' },
  { date: '2022.06 – 08', org: 'DIP', ko: '자동차 산업 AI 커리큘럼 개발·교육', en: 'AI curriculum for the automotive industry' },
  { date: '2022.05 – 09', org: L('섬유개발연구원', 'KTDI'), ko: '섬유소재 분야 인공지능 분석', en: 'AI analysis for textile materials', h: 113 },
  { date: '2022.03', org: L('영진직업전문학교', 'Yeungjin Vocational School'), ko: '인공지능 분석 실무', en: 'Applied AI analysis', h: 13 },
  { date: '2021.12 – 2022.01', org: L('라인평생원격교육원', 'LINE Lifelong Education'), ko: '빅데이터 분석 이론·실습 강의 촬영', en: 'Recorded course on data analysis', h: 40 },
  { date: '2021.12', org: 'DIP', ko: '인공지능 분석 실무자 양성', en: 'AI analyst training', h: 8 },
  { date: '2021.10 – 11', org: 'KERIS', ko: '빅데이터·인공지능 교재 280쪽 집필', en: '280-page data and AI textbook' },
  { date: '2021.09', org: 'DIP', ko: '라즈베리파이 AI 시스템 개발·탑재 (얼굴·객체 인식, 포즈 추정)', en: 'AI on Raspberry Pi: face, object and pose detection', h: 16 },
  { date: '2021.08', org: 'DIP', ko: '의료 이미지 분석', en: 'Medical image analysis', h: 8 },
  { date: '2021.08', org: L('경북대학교', 'KNU'), ko: '농업 분야 인공지능 활용 사례', en: 'AI in agriculture', h: 4 },
  { date: '2021.08', org: 'DIP', ko: '스마트팩토리 인공지능 시스템 개발', en: 'AI systems for smart factories', h: 16 },
  { date: '2021.08', org: 'DIP', ko: '도커 기반 LSTM 모델 텐서플로 서빙', en: 'Serving an LSTM with TensorFlow on Docker', h: 4 },
  { date: '2021.07', org: L('한국가스공사', 'KOGAS'), ko: '파이썬 기반 인공지능 시스템 개발', en: 'Building AI systems in Python', h: 40 },
  { date: '2021.07', org: L('계명대학교', 'Keimyung Univ.'), ko: '스마트팩토리 시스템 개발', en: 'Smart factory systems', h: 21 },
  { date: '2021.07', org: 'DIP', ko: 'Flask 기반 Python 서비스 배포', en: 'Deploying Python services with Flask', h: 4 },
  { date: '2021.06 – 07', org: L('영진사이버대학교', 'Yeungjin Cyber Univ.'), ko: '사례로 알아보는 빅데이터 활용 강의 촬영', en: 'Recorded course on data in practice', h: 11 },
  { date: '2021.06', org: 'DIP', ko: '금융 분야 사기 거래 탐지 시스템 개발', en: 'Building fraud detection for finance', h: 12 },
  { date: '2021.01', org: L('계명대학교', 'Keimyung Univ.'), ko: '빅데이터·인공지능 분석 특강 (DNN, CNN, RNN)', en: 'Data and AI lectures (DNN, CNN, RNN)', h: 80 },
  { date: '2020.10', org: L('계명대학교', 'Keimyung Univ.'), ko: 'KAC 빅데이터 특강', en: 'KAC data science lectures', h: 80 },
];
const hours = teaching.reduce((sum, t) => sum + (t.h ?? 0), 0);
const teachOrgs = [...new Set(teaching.map((t) => t.org.split(' · ')[0]))];

const skills = [
  { ko: '모델링', en: 'Modelling', items: [L('시계열 예측', 'Forecasting'), L('이상 탐지', 'Anomaly detection'), L('정형 데이터', 'Tabular data'), 'NLP · LLM', L('비전', 'Vision'), 'XAI'] },
  { ko: '도구', en: 'Tools', items: ['Python', 'PyTorch', 'TensorFlow', 'LightGBM', 'OpenCV', 'KNIME'] },
  { ko: '배포', en: 'Shipping', items: ['Docker', 'Flask', 'NGINX', 'Linux', 'Raspberry Pi', 'Cloudflare Workers'] },
];
---
<BaseLayout lang={lang} title={L('포트폴리오', 'Portfolio')} description={L('2020년부터 해 온 데이터·AI 프로젝트, 논문, 수상, 강의를 한 페이지에 정리함.', 'Data and AI projects, papers, awards and teaching since 2020, on one page.')}>
  <header class="page-top pf-hero"><div class="shell pf-hero-grid">
    <div>
      <div class="section-kicker">{L('포트폴리오', 'Portfolio')}</div>
      <h1>{L('데이터로 문제 풀어 온 6년', 'Six years of solving problems with data')}</h1>
      <p>{L('경영정보시스템을 공부했고, 2020년부터 회사에서 시계열 예측, 이상거래 탐지, 텍스트 분석, LLM 프로젝트를 해 옴. 공동 창업한 회사에서 분석팀과 연구소를 맡았고, 지금은 R&D 연구원으로 일함. 강의도 꽤 많이 했음.', 'Trained in management information systems. Since 2020: forecasting, fraud detection, text analysis and LLM projects. Co-founded a company and ran its analysis team and lab; now an R&D researcher. A fair amount of teaching along the way.')}</p>
      <div class="pf-actions">
        <a class="lab-cta" href={`mailto:${email}`}>{email}<span aria-hidden="true">→</span></a>
        <a class="pf-ghost" href={projectPath(weather.id, lang)}>{L('지금 돌아가는 프로젝트', 'Live project')}</a>
      </div>
    </div>
    <dl class="pf-stats taped">
      {stats.map((s) => <div><dt>{s.n}</dt><dd>{isKo ? s.ko : s.en}</dd></div>)}
    </dl>
  </div></header>

  <nav class="shell pf-toc" aria-label={L('목차', 'Contents')}>
    {[['pf-now', L('지금', 'Now')], ['pf-career', L('경력', 'Career')], ['pf-work', L('프로젝트', 'Projects')], ['pf-research', L('연구', 'Research')], ['pf-awards', L('수상', 'Awards')], ['pf-teaching', L('강의', 'Teaching')], ['pf-contact', L('연락', 'Contact')]].map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
  </nav>

  <div class="shell pf-body">
    <section id="pf-now" class="pf-section">
      <h2 class="pf-h">{L('지금 돌아가는 것', 'Running now')}</h2>
      <div class="pf-feature">
        <a class="taped pf-shot" href={projectPath(weather.id, lang)}><img src="/images/projects/beat-kma-forecast.webp" width="1100" height="1051" loading="lazy" alt={L('97개 관측소 지도와 서울 예보 카드가 보이는 예보 화면', 'Forecast page with the Seoul card and the 97-station map')} /></a>
        <div>
          <p class="pf-eyebrow">{L('개인 프로젝트 · 2026', 'Side project · 2026')}</p>
          <h3>{isKo ? weather.nameKo : weather.name}</h3>
          <p>{isKo ? weather.summaryKo : weather.summary}</p>
          <ul class="pf-tags"><li>Aurora</li><li>PyTorch</li><li>LightGBM</li><li>Cloudflare Workers</li></ul>
          <div class="pf-actions">
            <a class="lab-cta" href={projectPath(weather.id, lang)}>{L('오늘 예보 보기', "See today's forecast")}<span aria-hidden="true">→</span></a>
            <a class="pf-ghost" href={labSectionPath(stories, lang)}>{L('만든 과정 1~4편', 'How it was built, parts 1–4')}</a>
          </div>
        </div>
      </div>
    </section>

    <section id="pf-career" class="pf-section pf-two">
      <div>
        <h2 class="pf-h">{L('경력', 'Career')}</h2>
        <ol class="pf-timeline">
          {career.map((c) => (
            <li class={c.now ? 'is-now' : undefined}>
              <span class="pf-period">{c.period}</span>
              <strong>{c.org}</strong>
              <em>{c.role}</em>
              <p>{c.text}</p>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <h2 class="pf-h">{L('학력', 'Education')}</h2>
        <ol class="pf-timeline is-quiet">
          {education.map((e) => <li><span class="pf-period">{e.year}</span><p>{isKo ? e.ko : e.en}</p></li>)}
        </ol>
        <h2 class="pf-h">{L('기술', 'Skills')}</h2>
        <div class="pf-skills">
          {skills.map((g) => <div><span>{isKo ? g.ko : g.en}</span><ul class="pf-tags">{g.items.map((i) => <li>{i}</li>)}</ul></div>)}
        </div>
      </div>
    </section>

    <section id="pf-work" class="pf-section pf-work">
      <h2 class="pf-h">{L('프로젝트', 'Projects')} <small>{work.length}</small></h2>
      <div class="pf-filter" role="radiogroup" aria-label={L('분야', 'Field')}>
        <label><input type="radio" name="pf-d" value="all" checked />{L('전체', 'All')}</label>
        {domains.map((d) => <label><input type="radio" name="pf-d" value={d.id} />{isKo ? d.ko : d.en}</label>)}
      </div>
      <ul class="pf-cards">
        {work.map((w) => (
          <li class="pf-card" data-d={w.d}>
            <div class="pf-card-top"><span class="pf-period">{w.period}</span><span class={`pf-dot is-${w.d}`}>{(isKo ? domains.find((d) => d.id === w.d)!.ko : domains.find((d) => d.id === w.d)!.en)}</span></div>
            <h3>{isKo ? w.ko : w.en}</h3>
