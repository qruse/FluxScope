---
// The portfolio page is being rebuilt; until then it points to the projects and their stories.
import BaseLayout from '../layouts/BaseLayout.astro';
import LabPageStyles from './LabPageStyles.astro';
import { labSectionPath, labSections } from '../lib/site';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const isKo = lang === 'ko';
const stories = labSections.find((section) => section.id === 'stories')!;
---
<BaseLayout lang={lang} title={isKo ? '포트폴리오' : 'Portfolio'} description={isKo ? 'HSL Lab 포트폴리오는 새로 꾸미는 중.' : 'The HSL Lab portfolio is being rebuilt.'}>
  <header class="page-top"><div class="shell"><div class="section-kicker">{isKo ? '포트폴리오' : 'Portfolio'}</div><h1>{isKo ? '새로 꾸미는 중' : 'Being rebuilt'}</h1><p>{isKo ? '그동안 만든 것들은 프로젝트 스토리에서 볼 수 있음.' : 'Meanwhile, what got built is in the project stories.'}</p><a class="lab-cta" href={labSectionPath(stories, lang)}>{isKo ? '프로젝트 스토리 보기' : 'Read the project stories'}<span aria-hidden="true">→</span></a></div></header>
  <LabPageStyles />
</BaseLayout>
