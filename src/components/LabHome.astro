---
import { getCollection } from 'astro:content';
import { blogPath, categories, categoryPath, labSectionPath, labSections, projectPath, projects, storyPath, type Category } from '../lib/site';
import { useTranslations, type Lang } from '../i18n/ui';
import LabMark from './LabMark.astro';
import LabFace from './LabFace.astro';
import { casesPath, portfolio } from '../lib/portfolio';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const isKo = lang === 'ko';
// Sections come from labSections in lib/site.ts: the projects with a capture of the forecast page, the project
// stories with charts pinned from their parts, the blog with its newest posts, and the portfolio with its figures.
const blog = {
  name: t('site.title'),
  href: blogPath('/', lang),
  description: isKo
    ? '내가 궁금해서 만든 블로그.'
    : 'A blog I started because I was curious.',
};
const stories = (await getCollection('stories', (entry) => entry.data.lang === lang)).sort((a, b) => a.data.part - b.data.part);
// Parts grouped by project, in the projects list order; the pinned charts come from the weather project.
const storyGroups = projects.map((project) => ({ project, parts: stories.filter((s) => s.data.project === project.id) })).filter((g) => g.parts.length);
const weatherStories = stories.filter((s) => s.data.project === 'beat-kma');
const storyPins = [
  { part: 2, img: 'part2-pipeline', h: 523, ko: '2편 데이터 흐름도', en: 'Part 2 data flow chart' },
  { part: 3, img: 'part3-zeroshot', h: 509, ko: '3편 제로샷 검증 점수 차트', en: 'Part 3 zero-shot validation chart' },
  { part: 4, img: 'part4-test', h: 537, ko: '4편 테스트 기간 점수 차트', en: 'Part 4 test-period score chart' },
];
const cv = portfolio(lang);
const casesHref = casesPath(lang);
---
<h1 class="sr-only">{t('lab.title')}</h1>
<!-- Background layer behind the home content: scattered pen-drawn triangles gather into two hatched
     tetrahedra at the left and right edges as the page scrolls. Each entry below owns one face
     (data-face); that face turns forward and lights up while the entry is on screen. The script builds
     the SVG; with reduced motion it draws the finished shapes, and without JS nothing is shown. -->
<svg class="lab-backdrop" data-lab-backdrop aria-hidden="true"></svg>
<script is:inline>
  // Hide the entries for their reveal before the first paint. The module script below reveals them as they
  // scroll in; if it never runs, everything is shown shortly after load.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const root = document.documentElement;
    root.classList.add('lab-motion');
    addEventListener('load', () => setTimeout(() => { if (!root.classList.contains('lab-live')) root.classList.remove('lab-motion'); }, 1500));
  }
</script>

<section class="lab-index" aria-labelledby="lab-index-title">
  <div class="shell">
    <h2 class="home-section-title" id="lab-index-title">{isKo ? '프로젝트' : 'Projects'}</h2>
    <article class="lab-entry is-active" id="projects" data-face="0">
      <LabMark id="projects" class="lab-entry-num" />
      <div class="lab-entry-copy">
        <h3><a class="pen-under" href={labSectionPath(labSections[0], lang)}>{isKo ? '프로젝트' : 'Projects'}</a></h3>
        {projects.map((project) => (
          <>
            <p><a class="lab-project-link" href={projectPath(project.id, lang)}>{isKo ? project.nameKo : project.name}</a></p>
            <p>{isKo ? project.summaryKo : project.summary}</p>
          </>
        ))}
        <a class="lab-cta" href={labSectionPath(labSections[0], lang)}>{isKo ? '프로젝트 열기' : 'Open the projects'}<span aria-hidden="true">→</span></a>
      </div>
      <!-- A capture of the forecast page itself: our AI vs the KMA for Seoul and the station map. -->
      <a class="lab-shot taped" href={projectPath('beat-kma', lang)} aria-label={isKo ? '오늘 예보 화면으로 이동' : "Open today's forecast"}>
        <img src="/images/projects/beat-kma-forecast.webp" width="1100" height="1051" loading="lazy" decoding="async" alt={isKo ? '서울 기온을 우리 AI와 기상청 예보로 나란히 보여주고 전국 관측소 지도를 띄운 예보 화면' : 'Forecast page showing our AI and the KMA side by side for Seoul above a map of station forecasts'} />
      </a>
    </article>
    <article class="lab-entry" id="stories" data-face="1">
      <LabMark id="stories" class="lab-entry-num" />
      <div class="lab-entry-copy">
        <h3><a class="pen-under" href={labSectionPath(labSections[1], lang)}>{isKo ? '프로젝트 스토리' : 'Project Stories'}</a></h3>
        <p>{isKo ? '프로젝트를 만들면서 생긴 일을 편마다 정리한 개발 스토리.' : 'Development stories from the projects, one part at a time.'}</p>
        {storyGroups.map((g) => (
          <>
            <p class="lab-parts-project">{isKo ? g.project.nameKo : g.project.name}</p>
            <ol class="lab-parts">
              {g.parts.map((story) => <li><a href={storyPath(story.id.split('/')[1], lang)}><span>{isKo ? `${story.data.part}편` : `Part ${story.data.part}`}</span>{story.data.title}</a></li>)}
            </ol>
          </>
        ))}
      </div>
      <!-- Charts from the parts, pinned up like prints; each one opens its part. -->
      <div class="lab-pins">
        {storyPins.map((pin) => (
          <a class="taped lab-pin" href={storyPath(weatherStories[pin.part - 1].id.split('/')[1], lang)}>
            <img src={`/images/stories/beat-kma/thumb-${pin.img}.webp`} width="560" height={pin.h} loading="lazy" decoding="async" alt={isKo ? pin.ko : pin.en} />
          </a>
        ))}
      </div>
    </article>
    <article class="lab-entry" data-face="2">
      <LabMark id="blog" class="lab-entry-num" />
      <div class="lab-entry-copy">
        <h3><a class="pen-under" href={blog.href}>{blog.name}</a></h3>
        <p>{blog.description}</p>
        <div class="lab-chips">
          {(Object.keys(categories) as Category[]).map((key) => (
            <a href={categoryPath(key, lang)}>{isKo ? categories[key].nameKo : categories[key].name}</a>
          ))}
        </div>
        <!-- The Worker fills in the number of published posts from D1. -->
        <p class="lab-stat" data-dynamic-total-wrap hidden><strong data-dynamic-total></strong><span>{isKo ? '편의 글 · 한국어 / English' : 'posts · English / 한국어'}</span></p>
        <a class="lab-cta" href={blog.href}>{isKo ? '블로그 열기' : 'Open the blog'}<span aria-hidden="true">→</span></a>
      </div>
      <!-- Filled by the Worker with the thumbnails of the three newest posts; hidden when empty. -->
      <div class="lab-thumbs" data-dynamic-thumbs="3" aria-label={isKo ? '블로그 최신 글 썸네일' : 'Latest blog post thumbnails'}></div>
      <!-- Filled by the Worker with the newest blog posts from D1; hidden only when empty. -->
      <section class="lab-latest" data-dynamic-latest hidden aria-labelledby="lab-latest-title">
        <h4 class="lab-latest-title" id="lab-latest-title">{isKo ? '블로그 최신 글' : 'Latest from the blog'}</h4>
        <ol class="latest-list" data-dynamic-latest-list data-limit="5"></ol>
        <p class="lab-more"><a class="quiet-link" href={blog.href}>{isKo ? '블로그에서 전체 보기 →' : 'See all posts on the blog →'}</a></p>
      </section>
    </article>
    <article class="lab-entry" id="portfolio" data-face="3">
      <LabMark id="portfolio" class="lab-entry-num" />
      <div class="lab-entry-copy">
        <h3><a class="pen-under" href={labSectionPath(labSections[3], lang)}>{isKo ? '포트폴리오' : 'Portfolio'}</a></h3>
        <p>{isKo ? '2020년부터 해 온 데이터·AI 프로젝트, 논문, 수상, 강의.' : 'Data and AI projects, papers, awards and teaching since 2020.'}</p>
        <dl class="lab-figures">
          {cv.stats.filter((s) => s.id !== 'papers').map((s) => <div><dt>{s.n}<small>{s.s}</small></dt><dd>{isKo ? s.ko : s.en}</dd></div>)}
        </dl>
        <a class="lab-cta" href={labSectionPath(labSections[3], lang)}>{isKo ? '포트폴리오 보기' : 'Open the portfolio'}<span aria-hidden="true">→</span></a>
      </div>
      <!-- The top awards and the research count, as an index card. -->
      <a class="taped lab-card" href={labSectionPath(labSections[3], lang)}>
        <span class="lab-card-kicker">{isKo ? '하이라이트' : 'Highlights'}</span>
        <ol>
          {cv.awards.slice(0, 3).map((a) => <li class={a.top ? 'is-top' : undefined}><b>{a.rank}</b><span>{isKo ? a.ko : a.en}<small>{a.note}</small></span></li>)}
          <li><b>KCI</b><span>{isKo ? `논문 ${cv.kci}편 · 특허 출원 1건` : `${cv.kci} papers · 1 patent filed`}<small>{isKo ? '텍스트 분류, 시계열 딥러닝, 토픽모델링' : 'Text classification, time-series deep learning, topic models'}</small></span></li>
        </ol>
      </a>
    </article>
    <!-- 05: the portfolio's case studies, numbered after the four sections. It belongs to the portfolio, so it
         keeps the portfolio's tetrahedron face. -->
    <article class="lab-entry" id="case-studies" data-face="3">
      <span class="lab-mark lab-entry-num">05<LabFace face={3} /></span>
      <div class="lab-entry-copy">
        <h3><a class="pen-under" href={casesHref}>{cv.casesTitle}</a></h3>
        <p>{isKo ? '현장 데이터를 담당자와 농가가 매일 쓰는 서비스로 만든 프로젝트를, 부딪힌 문제와 푼 방법 순서로 정리함.' : 'Projects that turned field data into services people use every day, told through the problems they hit and how they were solved.'}</p>
        <ol class="lab-parts">
          {cv.cases.map((c, i) => <li><a href={`${casesHref}#${c.id}`}><span>{String(i + 1).padStart(2, '0')}</span>{c.title}</a></li>)}
        </ol>
        <a class="lab-cta" href={casesHref}>{isKo ? '사례 보기' : 'Read the case studies'}<span aria-hidden="true">→</span></a>
      </div>
      <!-- The headline result of each case, as an index card. -->
      <a class="taped lab-card lab-card-cases" href={casesHref}>
        <span class="lab-card-kicker">{isKo ? '주요 성과' : 'Results'}</span>
        <ol>
          {cv.cases.map((c) => <li><b>{c.v}</b><span>{c.k} · {c.field}<small>{c.sub}</small></span></li>)}
        </ol>
      </a>
    </article>
  </div>
</section>

<script>
  const svg = document.querySelector<SVGSVGElement>('[data-lab-backdrop]');
  if (svg) {
    type V3 = [number, number, number];
    const NS = 'http://www.w3.org/2000/svg';
    const live = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    let seed = 5;
    const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
    const clamp = (t: number) => Math.min(1, Math.max(0, t));
    const ease = (t: number) => 1 - (1 - t) ** 3;
    const add = <K extends keyof SVGElementTagNameMap>(tag: K, cls: string, parent: Element) => {
      const el = document.createElementNS(NS, tag);
      if (cls) el.setAttribute('class', cls);
      parent.appendChild(el);
      return el;
    };
    const sub = (a: V3, b: V3): V3 => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];
    const cross = (a: V3, b: V3): V3 => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
    const unit = (a: V3): V3 => { const l = Math.hypot(...a) || 1; return [a[0] / l, a[1] / l, a[2] / l]; };
    const rotX = (v: V3, a: number): V3 => [v[0], v[1] * Math.cos(a) - v[2] * Math.sin(a), v[1] * Math.sin(a) + v[2] * Math.cos(a)];
    const rotY = (v: V3, a: number): V3 => [v[0] * Math.cos(a) + v[2] * Math.sin(a), v[1], -v[0] * Math.sin(a) + v[2] * Math.cos(a)];
    const rotZ = (v: V3, a: number): V3 => [v[0] * Math.cos(a) - v[1] * Math.sin(a), v[0] * Math.sin(a) + v[1] * Math.cos(a), v[2]];
    const TAU = Math.PI * 2;
    const turnTo = (from: number, to: number) => (((to - from) % TAU) + TAU * 1.5) % TAU - Math.PI; // shortest signed turn

    // Pen hatching for the faces: sparse on lit faces, dense on shaded ones, each at its own angle.
    const defs = add('defs', '', svg);
    const hatch = [[7, -35], [4.6, 40], [3.2, -65]].map(([gap, angle], i) => {
      const pattern = add('pattern', 'lab-hatch', defs);
      pattern.id = `lab-hatch-${i}`;
      const attrs = { patternUnits: 'userSpaceOnUse', width: gap, height: gap, patternTransform: `rotate(${angle})` };
      for (const [key, value] of Object.entries(attrs)) pattern.setAttribute(key, String(value));
      const paper = add('rect', '', pattern);
      paper.setAttribute('width', String(gap)); paper.setAttribute('height', String(gap));
      add('path', '', pattern).setAttribute('d', `M0 0V${gap}`);
      return `url(#lab-hatch-${i})`;
    });

    // Two regular tetrahedra (apex up, screen y points down), each face cut into 9 triangles.
    const corner = (k: number): V3 => [Math.cos(k * 2.0944) * Math.sqrt(8) / 3, 1 / 3, Math.sin(k * 2.0944) * Math.sqrt(8) / 3];
    const V: V3[] = [[0, -1, 0], corner(0), corner(1), corner(2)];
    const FACES = [[0, 1, 2], [0, 2, 3], [0, 3, 1], [1, 3, 2]];
    type Shard = { pts: V3[]; c: V3; face: number; sx: number; sy: number; spin: V3; delay: number; el: SVGPolygonElement; trail: SVGLineElement };
    const sides = [-1, 1].map((dir) => {
      // Speed lines behind the flying shards, then the shards.
      const trails = add('g', 'lab-backdrop-trails', svg);
      const g = add('g', 'lab-backdrop-side', svg);
      const shards: Shard[] = [];
      FACES.forEach(([ia, ib, ic], face) => {
        const at = (i: number, j: number): V3 => {
          const u = i / 3, v = j / 3, w = 1 - u - v;
          return [0, 1, 2].map((k) => V[ia][k] * w + V[ib][k] * u + V[ic][k] * v) as V3;
        };
        for (let i = 0; i < 3; i++) for (let j = 0; j < 3 - i; j++) {
          const tris = [[at(i, j), at(i + 1, j), at(i, j + 1)]];
          if (i + j < 2) tris.push([at(i + 1, j), at(i + 1, j + 1), at(i, j + 1)]);
          for (const pts of tris) shards.push({
            pts, face,
            c: [0, 1, 2].map((k) => (pts[0][k] + pts[1][k] + pts[2][k]) / 3) as V3,
            // Scattered over the whole viewport, mostly on this tetrahedron's half.
            sx: dir * (rnd() * .55 - .05), sy: rnd() - .5,
            spin: [(rnd() - .5) * 6, (rnd() - .5) * 6, (rnd() - .5) * 6],
            delay: rnd() * .3,
            el: add('polygon', 'lab-backdrop-shard', g),
            trail: add('line', '', trails),
          });
        }
      });
      return { dir, g, trails, shards, x: 0, y: 0 };
    });
    const fade = (side: (typeof sides)[number], value: string) => { side.g.style.opacity = side.trails.style.opacity = value; };
    // Loose fragments absorbed into the nearer tetrahedron before the faces lock in.
    const shapes = ['M-6-6h12v12h-12z', 'M0-7L6 4H-6z', 'M-6 0a6 6 0 1 0 12 0a6 6 0 1 0-12 0', 'M-6 0H6M0-6V6', 'M-10 0H10', 'M-2 0a2 2 0 1 0 4 0a2 2 0 1 0-4 0'];
    const bits = Array.from({ length: 22 }, (_, i) => {
      const g = add('g', 'lab-backdrop-bit' + (i % 5 === 0 ? ' is-accent' : ''), svg);
      add('path', '', g).setAttribute('d', shapes[i % shapes.length]);
      const x = rnd() - .5;
      return { g, x, y: rnd() - .5, side: sides[x < 0 ? 0 : 1], size: .8 + rnd() * .9, rot: rnd() * 360, spin: (rnd() - .5) * 540, delay: rnd() * .2 };
    });

    // The pose that turns each face toward the viewer: side faces by yaw (slightly off-axis so the shape
    // still reads as 3D), the base by tipping the tetrahedron forward.
    const PITCH = .42;
    const poses = FACES.map((ids, face) => {
      const normal = unit([0, 1, 2].map((k) => ids.reduce((sum, id) => sum + V[id][k], 0)) as V3);
      if (face === 3) return { yaw: 3.665, pitch: -.75 };
      let best = 0, bestZ = Infinity;
      for (let yaw = 0; yaw < TAU; yaw += .01) {
        const z = rotX(rotY(normal, yaw), PITCH)[2];
        if (z < bestZ) { bestZ = z; best = yaw; }
      }
      return { yaw: best + .9, pitch: PITCH };
    });
    const entries = Array.from(document.querySelectorAll<HTMLElement>('[data-face]'));
    document.documentElement.classList.add('lab-live');
    const reveal = new IntersectionObserver((seen) => {
      for (const { isIntersecting, target } of seen) if (isIntersecting) { target.classList.add('is-seen'); reveal.unobserve(target); }
    }, { rootMargin: '0px 0px -12% 0px' });
    document.querySelectorAll('.lab-entry').forEach((el) => reveal.observe(el));

    const LIGHT = unit([-.6, -.7, -.9]);
    let W = 0, H = 0, R = 0, queued = false, tiltX = 0, tiltY = 0, aimX = 0, aimY = 0, current = 0;
    let turn = poses[0].yaw, pitch = poses[0].pitch, rail = false;
    // On touch screens, where nothing follows a pointer, scrolling kicks the shape into a spin that swings
    // back to rest.
    const touch = matchMedia('(hover: none)').matches;
    let lastY = scrollY, swing = 0, swingSpeed = 0;
    // The drawn assembly trails the scroll position instead of jumping with it: `shown` eases toward the
    // scroll target over a fraction of a second, so a fast flick still plays out as an animation.
    let shown = -1, lastT = 0;
    // Once assembled the shapes breathe slowly so they never look frozen.
    let lastP = -1;
    const glow = [1, 0, 0, 0];
    let accent: V3 = [230, 96, 67], bg: V3 = [246, 245, 241], pen: V3 = [52, 70, 163];
    const rgb = (value: string): V3 => {
      const hex = value.trim().replace('#', '');
      return [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16) || 0) as V3;
    };
    const mix = (a: V3, b: V3, t: number): V3 => [0, 1, 2].map((i) => a[i] + (b[i] - a[i]) * t) as V3;
    const css = (a: V3) => `rgb(${a.map(Math.round).join(',')})`;
    const colors = () => {
      const style = getComputedStyle(document.documentElement);
      accent = rgb(style.getPropertyValue('--accent')); bg = rgb(style.getPropertyValue('--bg')); pen = rgb(style.getPropertyValue('--pen'));
    };
    // Each tetrahedron sits in the margin beside the content column. Where the margin is too narrow it
    // tucks half off-screen and fades so it never competes with the text; on the mobile layout both swarms
    // gather into one small tetrahedron riding the number column, and the second one dissolves.
    const layout = () => {
      W = innerWidth; H = innerHeight;
      R = Math.min(Math.max(Math.min(W, H) * .09, 44), 110);
      svg.setAttribute('viewBox', `${-W / 2} ${-H / 2} ${W} ${H}`);
      const shell = document.querySelector('.shell')?.getBoundingClientRect();
      const column = document.querySelector('.lab-entry-num')?.getBoundingClientRect();
      const gutter = shell ? shell.left : 0;
      const fits = gutter > R * 2.2;
      rail = W <= 860 && !!column;
      if (rail) R = Math.min(column!.width * .48, 32);
      for (const side of sides) {
        side.x = rail ? column!.left + column!.width / 2 - W / 2 : side.dir * (W / 2 - (fits ? gutter / 2 : R * .3));
        side.y = rail ? H * .14 : H * (side.dir < 0 ? -.12 : .22);
        fade(side, fits || rail ? '1' : '.4');
      }
    };
    // The entry whose top has passed 45% of the viewport is active; the last one once the page bottom is reached.
    const pick = () => {
      let k = 0;
      entries.forEach((el, i) => { if (el.getBoundingClientRect().top < H * .45) k = i; });
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) k = entries.length - 1;
      if (k !== current) {
        entries[current]?.classList.remove('is-active');
        entries[k]?.classList.add('is-active');
        current = k;
      }
      return Number(entries[k]?.dataset.face ?? 0);
    };

    // p runs from 0 at the top of the page to 1 after 120% of a viewport of scrolling, or at the page bottom on
    // a window so tall that the page scrolls less than that.
    function draw(now = performance.now()) {
      queued = false;
      const range = Math.min(H * 1.2, document.documentElement.scrollHeight - H);
      const target = live && range > 1 ? clamp(scrollY / range) : 1;
      // Frame-rate independent smoothing: the assembly closes 1 - 1/e of the gap every .8 s, face turns every .3 s.
      const dt = lastT ? Math.min(.1, (now - lastT) / 1000) : 1 / 60;
      lastT = now;
      shown = shown < 0 || !live ? target : shown + (target - shown) * (1 - Math.exp(-dt / .8));
      if (Math.abs(target - shown) < .0005) shown = target;
      const p = shown;
      const face = pick(), pose = poses[face], k = live ? 1 - Math.exp(-dt / .3) : 1;
      tiltX += (aimX - tiltX) * .12; tiltY += (aimY - tiltY) * .12;
      turn += turnTo(turn, pose.yaw) * k;
      pitch += (pose.pitch - pitch) * k;
      if (live && touch) {
        swingSpeed = (swingSpeed + Math.max(-40, Math.min(40, scrollY - lastY)) * .004 - swing * .07) * .86;
        swing += swingSpeed;
      }
      lastY = scrollY;
      let moving = Math.abs(aimX - tiltX) + Math.abs(aimY - tiltY) + Math.abs(pose.pitch - pitch) + Math.abs(swing) + Math.abs(swingSpeed) + Math.abs(target - shown);
      glow.forEach((g, i) => { glow[i] = g + ((i === face ? 1 : 0) - g) * k; moving += Math.abs((i === face ? 1 : 0) - glow[i]); });
      moving += Math.abs(turnTo(turn, pose.yaw));
      const vel = live && lastP >= 0 ? (p - lastP) / dt : 0;
      lastP = p;
      // The shards look settled near p = .8 (the eased flight is almost over), so breathing starts there.
      const rest = live && p > .8;
      const breathe = rest ? Math.sin(now / 1000 * 1.1) * clamp((p - .8) / .1) : 0;
      if (rest) moving += 1;
      const f = R * 5;
      for (const side of sides) {
        // Exactly one full turn while the shards assemble (p 0 → 1), fast at first and settling at the end,
        // then the shape rests on the active face with a slow breathing sway.
        const yaw = turn + swing + (ease(p) - 1) * TAU * side.dir + tiltX * .5 * side.dir + breathe * .06, tip = pitch + tiltY * .2 + breathe * .03;
        const oy = side.y + breathe * R * .05;
        if (rail && side.dir > 0) fade(side, String(1 - ease(p)));
        const farAt = (s: Shard, at: number) => 1 - ease(clamp((at - s.delay) / .7));
        // Shards spiral in: the offset from the resting place shrinks and unwinds as they land.
        const place = (s: Shard, far: number, centre: V3): V3 => {
          const ox = (s.sx * W - side.x - centre[0]) * far, oyy = (s.sy * H - side.y - centre[1]) * far;
          const a = side.dir * 2.4 * far * far;
          return [ox * Math.cos(a) - oyy * Math.sin(a), ox * Math.sin(a) + oyy * Math.cos(a), -centre[2] * far];
        };
        const screen = ([x, y, z]: V3): [number, number] => [side.x + x * f / (f + z), oy + y * f / (f + z)];
        const drawn = side.shards.map((s) => {
          const far = farAt(s, p);
          const centre = rotX(rotY(s.c, yaw), tip).map((x) => x * R) as V3;
          const shift = place(s, far, centre);
          const world = s.pts.map((v) => {
            const d = rotZ(rotY(rotX(sub(v, s.c), s.spin[0] * far), s.spin[1] * far), s.spin[2] * far);
            const q = rotX(rotY([s.c[0] + d[0], s.c[1] + d[1], s.c[2] + d[2]], yaw), tip);
            return [q[0] * R + shift[0], q[1] * R + shift[1], q[2] * R + shift[2]] as V3;
          });
          // Speed line from where the shard was a moment ago, only while it is moving.
          const lock = clamp((.2 - far) / .2), speed = clamp(Math.abs(vel) * 4) * (1 - lock);
          if (speed > .02) {
            const back = place(s, farAt(s, p - Math.min(.05, Math.max(-.05, vel * .12))), centre);
            const [x2, y2] = screen([centre[0] + shift[0], centre[1] + shift[1], centre[2] + shift[2]]);
            let [x1, y1] = screen([centre[0] + back[0], centre[1] + back[1], centre[2] + back[2]]);
            // Keep streaks short so a fast flick reads as motion, not as lines across the page.
            const len = Math.hypot(x1 - x2, y1 - y2), cap = R * .9;
            if (len > cap) { x1 = x2 + (x1 - x2) * cap / len; y1 = y2 + (y1 - y2) * cap / len; }
            s.trail.setAttribute('x1', x1.toFixed(1)); s.trail.setAttribute('y1', y1.toFixed(1));
            s.trail.setAttribute('x2', x2.toFixed(1)); s.trail.setAttribute('y2', y2.toFixed(1));
          }
          s.trail.style.opacity = speed > .02 ? String(speed * .7) : '0';
          const n = unit(cross(sub(world[1], world[0]), sub(world[2], world[0])));
          const shimmer = rest ? Math.sin(now / 1000 * 2 + s.c[0] * 5 + s.c[1] * 3) * .08 : 0;
          return { s, world, far, lock, lit: clamp(.1 + .9 * Math.abs(n[0] * LIGHT[0] + n[1] * LIGHT[1] + n[2] * LIGHT[2]) + shimmer), z: world[0][2] + world[1][2] + world[2][2] };
        }).sort((a, b) => b.z - a.z); // far faces first
        for (const { s, world, far, lock, lit } of drawn) {
          s.el.setAttribute('points', world.map((w) => screen(w).map((v) => v.toFixed(1)).join(',')).join(' '));
          const on = glow[s.face] * lock;
          const shade = mix(mix(accent, [0, 0, 0], .3), mix(accent, [255, 255, 255], .4), lit);
          // In flight the outline takes on the accent colour; once locked it settles into pen hatching, or the
          // accent fill on the active entry's face.
          const tint = Math.sin(Math.PI * far) * .85 * (1 - lock);
          s.el.style.fill = !lock ? 'none' : on > .02 ? css(mix(bg, shade, on)) : hatch[lit > .7 ? 0 : lit > .4 ? 1 : 2];
          s.el.style.fillOpacity = String(on > .02 ? 1 : lock);
          s.el.style.stroke = css(mix(mix(mix(bg, pen, .35 + .55 * lock), accent, tint), mix(shade, bg, .35), on));
          side.g.appendChild(s.el);
        }
      }
      for (const b of bits) {
        const t = ease(clamp((p - b.delay) / .6)), far = 1 - t;
        const x = b.side.x + (b.x * W - b.side.x) * far, y = b.side.y + (b.y * H - b.side.y) * far;
        b.g.setAttribute('transform', `translate(${x.toFixed(1)} ${y.toFixed(1)}) rotate(${(b.rot + b.spin * t).toFixed(1)}) scale(${Math.max(0, b.size * (1 - t * 1.05)).toFixed(3)})`);
      }
      if (moving > .002) schedule();
    }
    const schedule = () => { if (!queued) { queued = true; requestAnimationFrame(draw); } };

    colors(); layout(); draw();
    svg.classList.add('is-ready');
    addEventListener('resize', () => { layout(); schedule(); });
    addEventListener('scroll', schedule, { passive: true });
    new MutationObserver(() => { colors(); schedule(); }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    if (live) addEventListener('pointermove', (e) => { aimX = e.clientX / W - .5; aimY = e.clientY / H - .5; schedule(); }, { passive: true });
  }
</script>

