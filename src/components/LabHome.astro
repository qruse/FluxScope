---
import { blogPath, categories, categoryPath, type Category } from '../lib/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const isKo = lang === 'ko';
// Projects of the lab; the blog is the first one. Add an entry here for each new project.
const blog = {
  name: t('site.title'),
  href: blogPath('/', lang),
  description: isKo
    ? 'AI 모델, 자동차, IT 기기의 가격·성능·마케팅 주장을 원문으로 따져보고, 쓸지 살지 판단을 돕는 글.'
    : 'Checks prices, benchmarks and marketing claims for AI models, cars and devices against the original sources.',
};
---
<!-- Scroll-driven intro: a particle mark morphs hsl. → magnifier → cube → document as the page scrolls.
     Without JS or with reduced motion it shows the hsl. mark as a static block. -->
<section class="lab-intro" data-lab-intro aria-labelledby="lab-intro-title">
  <h1 class="sr-only" id="lab-intro-title">{t('lab.title')}</h1>
  <div class="lab-intro-stage">
    <canvas class="lab-intro-canvas" aria-hidden="true"></canvas>
    <div class="shell lab-intro-bar" aria-hidden="true"><i><b></b></i></div>
  </div>
</section>

<section class="lab-projects" aria-labelledby="lab-projects-title">
  <div class="shell">
    <h2 class="home-section-title" id="lab-projects-title">{isKo ? '프로젝트' : 'Projects'}</h2>
    <article class="lab-project">
      <div class="lab-project-copy">
        <div class="lab-project-index">01</div>
        <h3><a href={blog.href}>{blog.name}</a></h3>
        <p>{blog.description}</p>
        <div class="lab-chips">
          {(Object.keys(categories) as Category[]).map((key) => (
            <a href={categoryPath(key, lang)}>{isKo ? categories[key].nameKo : categories[key].name}</a>
          ))}
        </div>
        <!-- The Worker fills in the number of published posts from D1. -->
        <p class="lab-project-meta" data-dynamic-total-wrap hidden>{isKo ? <>글 <span data-dynamic-total></span>편 · 한국어 / English</> : <><span data-dynamic-total></span> posts · English / 한국어</>}</p>
        <a class="lab-project-cta" href={blog.href}>{isKo ? '블로그 열기' : 'Open the blog'}<span aria-hidden="true">→</span></a>
      </div>
      <!-- Filled by the Worker with the thumbnails of the three newest posts; hidden when empty. -->
      <div class="lab-thumbs" data-dynamic-thumbs="3" aria-label={isKo ? '블로그 최신 글 썸네일' : 'Latest blog post thumbnails'}></div>
    </article>
    <p class="lab-next">{isKo ? '02 · 다음 프로젝트는 여기에 추가됨' : '02 · The next project will appear here'}</p>
  </div>
</section>

<!-- Filled by the Worker with the newest blog posts from D1; hidden only when empty. -->
<section class="home-section latest" data-dynamic-latest hidden>
  <div class="shell">
    <h2 class="home-section-title">{isKo ? '블로그 최신 글' : 'Latest from the blog'}</h2>
    <ol class="latest-list" data-dynamic-latest-list data-limit="5"></ol>
    <p class="lab-more"><a class="quiet-link" href={blog.href}>{isKo ? '블로그에서 전체 보기 →' : 'See all posts on the blog →'}</a></p>
  </div>
</section>

<script>
  // Scroll progress drives which shape the particles form; the pointer pushes them aside.
  const root = document.querySelector<HTMLElement>('[data-lab-intro]');
  const canvas = root?.querySelector('canvas');
  const ctx = canvas?.getContext('2d');
  if (root && canvas && ctx) {
    const stage = root.querySelector<HTMLElement>('.lab-intro-stage')!;
    const live = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ACCENT = 40;
    let n = 0, w = 0, h = 0, scale = 0, cx = 0, cy = 0;
    let shapes: Float32Array[] = [];
    let pos = new Float32Array(0), seed = new Float32Array(0);
    let stickTop = 0, ink = '', accent = '', running = false, pointer: { x: number; y: number } | null = null;
    let rand = 7;
    const rnd = () => ((rand = (rand * 16807) % 2147483647) - 1) / 2147483646;

    // n points spread along polylines (normalized units, about -1..1), with a little thickness.
    const along = (paths: number[][], count: number, jitter = .035) => {
      const segs: number[][] = [];
      for (const p of paths) for (let i = 0; i < p.length - 2; i += 2) segs.push([p[i], p[i + 1], p[i + 2], p[i + 3], Math.hypot(p[i + 2] - p[i], p[i + 3] - p[i + 1])]);
      const total = segs.reduce((sum, s) => sum + s[4], 0);
      const out: number[] = [];
      for (let i = 0; i < count; i++) {
        let u = ((i + rnd()) / count) * total, k = 0;
        while (k < segs.length - 1 && u > segs[k][4]) u -= segs[k++][4];
        const [ax, ay, bx, by, len] = segs[k], f = len ? u / len : 0;
        out.push(ax + (bx - ax) * f + (rnd() - .5) * jitter * 2, ay + (by - ay) * f + (rnd() - .5) * jitter * 2);
      }
      return out;
    };
    const circle = (x: number, y: number, r: number, from = 0, to = Math.PI * 2) => {
      const p: number[] = [];
      for (let i = 0; i <= 48; i++) { const a = from + ((to - from) * i) / 48; p.push(x + Math.cos(a) * r, y + Math.sin(a) * r); }
      return p;
    };
    // Pixels of "hsl" plus the accent dot, sampled from an offscreen canvas.
    const word = (count: number) => {
      const off = document.createElement('canvas'), c = off.getContext('2d')!;
      off.width = 600; off.height = 300;
      c.font = `800 220px ${getComputedStyle(root).fontFamily}`;
      const tw = c.measureText('hsl').width, r = 21, x = (600 - tw - 10 - r * 2) / 2;
      const sample = (draw: () => void, max: number) => {
        c.clearRect(0, 0, 600, 300); draw();
        const data = c.getImageData(0, 0, 600, 300).data, pts: number[] = [];
        for (let y = 0; y < 300; y += 3) for (let px = 0; px < 600; px += 3) if (data[(y * 600 + px) * 4 + 3] > 128) pts.push((px - 300) / 200, (y - 150) / 200);
        const out: number[] = [];
        for (let i = 0; i < max; i++) { const j = Math.floor(rnd() * (pts.length / 2)) * 2; out.push(pts[j] ?? 0, pts[j + 1] ?? 0); }
        return out;
      };
      const dot = sample(() => { c.beginPath(); c.arc(x + tw + 10 + r, 228 - r, r, 0, 7); c.fill(); }, ACCENT);
      return [...dot, ...sample(() => c.fillText('hsl', x, 228), count - ACCENT)];
    };
    const build = () => {
      rand = 7;
      n = w < 520 ? 520 : 760;
      const body = n - ACCENT;
      const cube = [0, -.62, .54, -.31, .54, .31, 0, .62, -.54, .31, -.54, -.31, 0, -.62];
      shapes = [
        word(n),
        [...along([circle(-.12, -.12, .3, 3.5, 4.4)], ACCENT, .02), ...along([circle(-.12, -.12, .52), [.25, .25, .72, .72]], body, .045)],
        [...along([[0, 0, -.54, -.31], [0, 0, .54, -.31], [0, 0, 0, .62]], ACCENT, .02), ...along([cube], body, .03)],
        [...along([[-.36, -.5, .1, -.5]], ACCENT, .03), ...along([[-.55, -.75, .3, -.75, .55, -.5, .55, .75, -.55, .75, -.55, -.75], [.3, -.75, .3, -.5, .55, -.5],
          [-.36, -.25, .36, -.25], [-.36, -.05, .28, -.05], [-.36, .15, .36, .15], [-.36, .35, .08, .35], [-.36, .55, .24, .55]], body, .025)],
      ].map((s) => Float32Array.from(s));
      if (pos.length !== n * 2) {
        pos = new Float32Array(n * 2);
        seed = new Float32Array(n * 3);
        for (let i = 0; i < n; i++) {
          pos[i * 2] = live ? rnd() * w : 0; pos[i * 2 + 1] = live ? rnd() * h : 0;
          seed[i * 3] = rnd(); seed[i * 3 + 1] = rnd() * Math.PI * 2; seed[i * 3 + 2] = rnd() * Math.PI * 2;
        }
      }
      if (!live) frame(0, true);
    };
    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = canvas.clientWidth; h = canvas.clientHeight;
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      scale = Math.min(w * .42, h * .44); cx = w / 2; cy = h / 2;
      stickTop = document.querySelector<HTMLElement>('.site-header')?.offsetHeight ?? 0;
      root.style.setProperty('--intro-top', `${stickTop}px`);
      build();
    };
    const colors = () => {
      const css = getComputedStyle(document.documentElement);
      ink = css.getPropertyValue('--ink').trim(); accent = css.getPropertyValue('--accent').trim();
      if (!live && n) frame(0, true);
    };
    const ease = (t: number) => (t < .5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
    const clamp = (t: number) => Math.min(1, Math.max(0, t));
    const windows = [[.06, .26], [.38, .58], [.7, .9]];

    function frame(time: number, still = false) {
      let p = 0;
      if (!still) {
        const box = root!.getBoundingClientRect();
        p = clamp((stickTop - box.top) / Math.max(1, box.height - stage.offsetHeight));
        root!.style.setProperty('--p', p.toFixed(3));
      }
      let from = 0, mix = 0;
      windows.forEach(([a, b], k) => { if (p >= a) { from = k; mix = clamp((p - a) / (b - a)); } });
      const A = shapes[from], B = shapes[Math.min(from + 1, 3)];
      ctx!.clearRect(0, 0, w, h);
      for (const pass of [0, 1]) {
        ctx!.beginPath();
        ctx!.fillStyle = pass ? accent : ink;
        const r = pass ? 2.3 : w < 520 ? 1.35 : 1.6;
        for (let i = pass ? 0 : ACCENT, end = pass ? ACCENT : n; i < end; i++) {
          const local = clamp(mix * 1.6 - seed[i * 3] * .6), e = ease(local), swirl = Math.sin(Math.PI * local) * .2;
          let x = cx + (A[i * 2] + (B[i * 2] - A[i * 2]) * e + Math.cos(seed[i * 3 + 1]) * swirl) * scale;
          let y = cy + (A[i * 2 + 1] + (B[i * 2 + 1] - A[i * 2 + 1]) * e + Math.sin(seed[i * 3 + 1]) * swirl) * scale;
          if (!still) {
            x += Math.sin(time / 900 + seed[i * 3 + 2]) * 1.2; y += Math.cos(time / 1100 + seed[i * 3 + 2]) * 1.2;
            if (pointer) {
              const dx = x - pointer.x, dy = y - pointer.y, d = Math.hypot(dx, dy) || 1;
              if (d < 90) { const push = (1 - d / 90) ** 2 * 42; x += (dx / d) * push; y += (dy / d) * push; }
            }
            pos[i * 2] += (x - pos[i * 2]) * .14; pos[i * 2 + 1] += (y - pos[i * 2 + 1]) * .14;
          } else { pos[i * 2] = x; pos[i * 2 + 1] = y; }
          ctx!.moveTo(pos[i * 2] + r, pos[i * 2 + 1]);
          ctx!.arc(pos[i * 2], pos[i * 2 + 1], r, 0, Math.PI * 2);
        }
        ctx!.fill();
      }
    }
    const loop = (time: number) => { if (!running) return; frame(time); requestAnimationFrame(loop); };

    new MutationObserver(colors).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    colors();
    const start = () => {
      root.classList.add('is-ready');
      if (live) root.classList.add('is-live');
      resize();
      new ResizeObserver(resize).observe(canvas);
      if (!live) return;
      const track = (e: PointerEvent) => { const b = canvas.getBoundingClientRect(); pointer = { x: e.clientX - b.left, y: e.clientY - b.top }; };
      stage.addEventListener('pointermove', track);
      stage.addEventListener('pointerdown', track);
      for (const type of ['pointerleave', 'pointerup', 'pointercancel']) stage.addEventListener(type, () => { pointer = null; });
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting && !running) { running = true; requestAnimationFrame(loop); }
        else if (!entry.isIntersecting) running = false;
      }).observe(root);
    };
    const font = `800 220px ${getComputedStyle(root).fontFamily}`;
    document.fonts.load(font, 'hsl').then(start, start);
  }
</script>
