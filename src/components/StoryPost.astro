---
// One part of a project story, with the project's other parts in a side list.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LabPageStyles from './LabPageStyles.astro';
import { lab, labSectionPath, labSections, storyPath, projectPath, projects } from '../lib/site';
import { getDimensions } from '../lib/rehype-optimize-images.mjs';
import type { Lang } from '../i18n/ui';

interface Props { entry: CollectionEntry<'stories'>; lang: Lang; }
const { entry, lang } = Astro.props;
const isKo = lang === 'ko';
const { Content } = await render(entry);
const parts = (await getCollection('stories', (e) => e.data.lang === lang && e.data.project === entry.data.project))
  .sort((a, b) => a.data.part - b.data.part);
const slugOf = (e: CollectionEntry<'stories'>) => e.id.split('/').pop()!;
const project = projects.find((p) => p.id === entry.data.project);
const next = parts.find((p) => p.data.part === entry.data.part + 1);
const date = entry.data.publishedAt.toLocaleDateString(isKo ? 'ko-KR' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Seoul' });

// The part's first figure is its share image; search engines get the part as a BlogPosting inside the lab's breadcrumbs.
const images = [...(entry.body || '').matchAll(/!\[([^\]]*)\]\((\/images\/stories\/[^\s)]+)\)/g)]
  .map(([, alt, src]) => ({ alt, src, size: getDimensions(`public${src}`) }))
  .filter((image) => image.size?.width && image.size?.height);
const cover = images[0];
const abs = (path: string) => new URL(path, Astro.site).href;
const section = labSections.find((s) => s.id === 'stories')!;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BlogPosting', headline: entry.data.title, inLanguage: lang,
    description: entry.data.description, mainEntityOfPage: abs(storyPath(slugOf(entry), lang)),
    ...(images.length && { image: images.map((i) => ({ '@type': 'ImageObject', url: abs(i.src), width: i.size!.width, height: i.size!.height })) }),
    datePublished: entry.data.publishedAt.toISOString(), dateModified: entry.data.publishedAt.toISOString(),
    author: { '@type': 'Person', name: 'HSL', url: abs(isKo ? '/blog/about/' : '/en/blog/about/') },
    publisher: { '@type': 'Organization', name: lab.name, url: abs('/'), logo: { '@type': 'ImageObject', url: abs('/images/logo.png'), width: 512, height: 512 } },
    ...(project && { about: { '@type': 'CreativeWork', name: isKo ? project.nameKo : project.name, url: abs(projectPath(project.id, lang)) } }),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: lab.name, item: abs(isKo ? '/' : '/en/') },
      { '@type': 'ListItem', position: 2, name: isKo ? section.nameKo : section.name, item: abs(labSectionPath(section, lang)) },
      { '@type': 'ListItem', position: 3, name: entry.data.title, item: abs(storyPath(slugOf(entry), lang)) },
    ],
  },
];
---
<BaseLayout lang={lang} title={entry.data.title} description={entry.data.description} image={cover?.src} imageAlt={cover?.alt} imageWidth={cover?.size?.width} imageHeight={cover?.size?.height} type="article" publishedAt={entry.data.publishedAt} updatedAt={entry.data.publishedAt} jsonLd={jsonLd}>
  <header class="page-top">
    <div class="article-shell">
      <div class="section-kicker">{isKo ? `프로젝트 스토리 · ${entry.data.part}편` : `Project Stories · Part ${entry.data.part}`}</div>
      <h1 class="story-title">{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <p class="story-meta"><time datetime={entry.data.publishedAt.toISOString()}>{date}</time></p>
    </div>
  </header>
  <div class="story-layout shell">
    <article class="article-body article-shell"><Content /><div data-ad></div></article>
    <aside class="story-side" aria-label={isKo ? '개발 스토리 목록' : 'Development story parts'}>
      {project && <p class="story-side-project"><a href={projectPath(project.id, lang)}>{isKo ? project.nameKo : project.name}</a></p>}
      <ol>
        {parts.map((p) => (
          <li class={p.id === entry.id ? 'is-current' : undefined}>
            <a href={storyPath(slugOf(p), lang)} aria-current={p.id === entry.id ? 'page' : undefined}>{p.data.title}</a>
          </li>
        ))}
      </ol>
      {next && <a class="lab-cta" href={storyPath(slugOf(next), lang)}>{isKo ? '다음 편' : 'Next part'}<span aria-hidden="true">→</span></a>}
    </aside>
  </div>
  <LabPageStyles />
</BaseLayout>
