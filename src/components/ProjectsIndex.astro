---
import BaseLayout from '../layouts/BaseLayout.astro';
import LabPageStyles from './LabPageStyles.astro';
import { projectPath, projects } from '../lib/site';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const isKo = lang === 'ko';
---
<BaseLayout lang={lang} title={isKo ? '프로젝트' : 'Projects'} description={isKo ? 'HSL Lab에서 직접 만들어 돌리는 프로젝트.' : 'Projects built and run at HSL Lab.'}>
  <header class="page-top"><div class="shell"><div class="section-kicker">{isKo ? '프로젝트' : 'Projects'}</div><h1>{isKo ? '만들어서 돌려 보는 것들' : 'Things built and running'}</h1><p>{isKo ? '궁금한 걸 직접 만들어 보고, 돌아가는 채로 공개함.' : 'Built out of curiosity and published while they run.'}</p></div></header>
  <div class="shell portfolio-list">
    {projects.map((project) => (
      <section class="portfolio-project">
        <h2><a class="pen-under" href={projectPath(project.id, lang)}>{isKo ? project.nameKo : project.name}</a></h2>
        <p>{isKo ? project.summaryKo : project.summary}</p>
        <a class="lab-cta" href={projectPath(project.id, lang)}>{isKo ? project.ctaKo : project.cta}<span aria-hidden="true">→</span></a>
      </section>
    ))}
  </div>
  <LabPageStyles />
</BaseLayout>
