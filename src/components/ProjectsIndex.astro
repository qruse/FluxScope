---
import { getStories } from '../lib/stories';
import BaseLayout from '../layouts/BaseLayout.astro';
import { projectPath, projects, projectThumb } from '../lib/site';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const isKo = lang === 'ko';
// Newest first, as cards like the columns' list; how each was built is on the stories page.
const stories = await getStories((entry) => entry.data.lang === lang);
const ordered = [...projects].sort((a, b) => b.addedAt.localeCompare(a.addedAt));
---
<BaseLayout lang={lang} title={isKo ? '프로젝트' : 'Projects'} description={isKo ? 'HSL Lab에서 직접 만들어 돌리는 프로젝트. AI 기상 예보로 기상청과 겨루기, 네 AI의 미국 주식 모의투자 대결, 현실로 채점하는 AI 예측 벤치마크, 여덟 AI의 마피아 게임을 돌아가는 채로 공개하고, 내 목소리 TTS는 예시를 들어 볼 수 있음.' : 'Projects built and run at HSL Lab: an AI weather forecast racing the KMA, four AIs running US stock paper portfolios, an AI forecasting benchmark marked by reality and eight AIs playing Mafia, published while they run, plus examples from a TTS in my own voice.'}>
  <header class="page-top"><div class="shell"><div class="section-kicker">{isKo ? '프로젝트' : 'Projects'}</div><h1>{isKo ? '만들어서 돌려 보는 것들' : 'Things built and running'}</h1><p>{isKo ? '궁금한 걸 직접 만들어 보고, 돌아가는 채로 공개함. 결과는 매일 갱신되고, 만든 과정은 프로젝트 스토리에 편마다 정리함.' : 'Built out of curiosity and published while they run. Results update daily, and how each one was built is written up part by part in the project stories.'}</p></div></header>
  <section class="listing"><div class="shell"><div class="post-grid">
    {ordered.map((project) => {
      const parts = stories.filter((s) => s.data.project === project.id).length;
      const name = isKo ? project.nameKo : project.name;
      return (
        <article class="post-card">
          <a class="card-link" href={projectPath(project.id, lang)}>
            <div class="card-media taped"><img class="card-visual" src={projectThumb(project.id)} width="720" height="480" loading="lazy" decoding="async" alt={isKo ? `${name} 화면` : `${name} page`} /></div>
            <div class="card-copy">
              <div class="eyebrow"><span class="category-pip"></span>{isKo ? project.ctaKo : project.cta}{parts > 0 && <><span class="eyebrow-sep">/</span>{isKo ? `스토리 ${parts}편` : `${parts} story parts`}</>}</div>
              <h2 class="pen-under">{name}</h2>
              <p>{isKo ? project.taglineKo : project.tagline}</p>
            </div>
          </a>
        </article>
      );
    })}
  </div></div></section>
</BaseLayout>
