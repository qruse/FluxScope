---
// "TTS in your own voice" project page. The live service (OmniVoice on the owner's home RTX 3070, my_voice_tts/server)
// is switched off for lack of spare GPU (owner decision 2026-11-04), so the page keeps the examples and the write-up.
// Styles are inline: the shared CSS bundle is at its performance budget. Colors come only from the theme tokens.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getStories } from '../lib/stories';
import { projects, projectPath, storyPath } from '../lib/site';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const isKo = lang === 'ko';
const L = (ko: string, en: string) => (isKo ? ko : en);
const project = projects.find((p) => p.id === 'my-voice-tts')!;
const stories = (await getStories((e) => e.data.lang === lang && e.data.project === project.id))
  .sort((a, b) => a.data.part - b.data.part);
// Generated 2026-11-04 with the Shorts voice: OmniVoice plus the LoRA trained on ten of the owner's sentences.
const samples = [
  ['오늘 저녁은 내가 쏠게. 진짜로.', 'Dinner is on me tonight. Really.'],
  ['회의는 십 분 뒤에 시작합니다. 커피 챙겨 오세요.', 'The meeting starts in ten minutes. Bring coffee.'],
  ['생일 축하해! 올해는 하고 싶은 거 다 하자.', 'Happy birthday! Do everything you want this year.'],
];
const shorts = [
  ['wsr1Ebu_D1Y', '2만원으로 기상청 이기기 (1)'],
  ['Jp1mlS0A5bs', '2만원으로 기상청 이기기 (2)'],
];
// Same stand-in reference voice and the same Korean target sentence for every model (my_voice_tts/bench, 2026-10-24).
const bench = [
  ['OmniVoice', '0%', '0.812', L('2.2초', '2.2 s'), '2.2 GB'],
  ['Fun-CosyVoice3 0.5B', '3.1%', '0.808', L('7.1초', '7.1 s'), '3.6 GB'],
  ['VoxCPM2', '0%', '0.783', L('17초', '17 s'), '5.9 GB'],
  ['Chatterbox Multilingual', '0%', '0.749', L('11초', '11 s'), '3.6 GB'],
  ['GPT-SoVITS v2ProPlus', '0%', '0.687', L('7.5초', '7.5 s'), '1.9 GB'],
];
---
<BaseLayout lang={lang} title={isKo ? project.nameKo : project.name} description={isKo ? project.summaryKo : project.summary}>
  <header class="page-top">
    <div class="shell">
      <div class="section-kicker">{L('프로젝트', 'Project')}</div>
      <h1>{isKo ? project.nameKo : project.name}</h1>
      <p>{isKo ? project.summaryKo : project.summary}</p>
    </div>
  </header>

  <div class="shell vt-body">
    <section class="vt-off">
      <h2>{L('지금은 서비스를 꺼 뒀음 ㅜㅜ', 'The live service is switched off for now :(')}</h2>
      <p>{L('원래는 라이브 서비스였음. 마이크로 한 문장만 읽으면 아무 문장이나 그 목소리로 읽어 줬음. 근데 가용 GPU가 부족해서 계속 켜 둘 수가 없음. 그래서 아래 예시만 남겨 둠', 'This used to be a live service: read one sentence into your mic, then type anything and hear it in your voice. There is not enough spare GPU to keep it running, so only the examples below stay up')}</p>
    </section>

    <section class="vt-sec">
      <h2>{L('내 목소리 예시', 'Examples in my voice')}</h2>
      {!isKo && <p>Korean audio, with the English meaning under each line.</p>}
      <ul class="vt-samples">
        {samples.map(([ko, en], i) => (
          <li>
            <strong>{ko}</strong>
            {!isKo && <span>{en}</span>}
            <audio controls preload="none" src={`/audio/my-voice-tts/sample-${i + 1}.mp3`}></audio>
          </li>
        ))}
      </ul>
      <p class="vt-note">{L('전부 AI로 합성한 음성임. 직접 읽은 녹음이 아님', 'All of this is AI-generated speech, not a recording of me reading')}</p>
    </section>

    <section class="vt-sec">
      <h2>{L('이 목소리로 만든 쇼츠', 'Shorts narrated in this voice')}</h2>
      {!isKo && <p>Both are in Korean.</p>}
      <div class="vt-shorts">
        {shorts.map(([id, title]) => (
          <figure>
            <a href={`https://www.youtube.com/shorts/${id}`} data-vt-yt={id} data-title={title} target="_blank" rel="noopener">
              <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt={title} width="480" height="360" loading="lazy" decoding="async" />
              <span aria-hidden="true"></span>
            </a>
            <figcaption>{title}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="vt-sec">
      <h2>{L('왜 OmniVoice인가', 'Why OmniVoice')}</h2>
      <p>{L('수익화에 걸리지 않는 라이선스(Apache 2.0·MIT)인 오픈소스 다섯 개를 같은 RTX 3070에서 돌려 봄. 같은 참고 목소리로 같은 한국어 문장을 만들게 하고, Whisper로 다시 받아 적어 발음 오류를, 화자 인식 모델(ECAPA)로 참고 목소리와 닮은 정도를 쟀음.', 'Five open-source models under licenses that allow commercial use (Apache 2.0, MIT) ran on the same RTX 3070. Each cloned the same reference voice saying the same Korean sentence; Whisper transcribed the result for pronunciation errors, and a speaker-verification model (ECAPA) scored how close it sounded to the reference.')}</p>
      <div class="vt-table"><table>
        <thead><tr><th>{L('모델', 'Model')}</th><th>{L('발음 오류', 'Char. errors')}</th><th>{L('목소리 유사도', 'Similarity')}</th><th>{L('5초 음성 생성', 'Time for 5 s')}</th><th>{L('GPU 메모리', 'GPU memory')}</th></tr></thead>
        <tbody>{bench.map((r, i) => <tr class={i === 0 ? 'is-pick' : ''}>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody>
      </table></div>
      <p class="vt-note">{L('문장 하나, 참고 목소리 하나로 잰 작은 시험임. 참고 목소리는 실제 사람 대신 TTS 기본 목소리를 썼음. 최신 논문(MiniMax 다국어 시험)에서도 OmniVoice와 VoxCPM2가 한국어 목소리 유사도 0.83 안팎으로 공개 모델 중 최상위권이었음.', 'A small test: one sentence and one reference voice, a stock TTS voice rather than a real person. In recent papers (MiniMax multilingual test), OmniVoice and VoxCPM2 also sit at the top of open models for Korean speaker similarity, around 0.83.')}
        {' '}<a href="https://arxiv.org/abs/2604.00688">OmniVoice</a> · <a href="https://arxiv.org/html/2608.11650v1">{L('다국어 비교표', 'multilingual comparison')}</a></p>
    </section>

    {stories.length > 0 && (
      <section class="vt-sec">
        <h2>{L('프로젝트 스토리', 'Project stories')}</h2>
        <ol class="vt-stories">{stories.map((s) => <li><a href={storyPath(s.id.split('/').pop()!, lang)}><span>{isKo ? `${s.data.part}편` : `Part ${s.data.part}`}</span><strong>{s.data.title}</strong><em>{s.data.description}</em></a></li>)}</ol>
      </section>
    )}

    <div data-ad></div>

    <section class="comments" id="comments" data-comments data-lang={lang} data-page={projectPath('my-voice-tts', lang)}
      data-intro={L('들어 보고 훈수 환영', 'Heard it? Backseat feedback welcome')}></section>
  </div>
  <script is:inline src="/comments.js" defer></script>

<style is:inline>
.vt-body { padding: 2rem 0 4rem; }
.vt-body > * { max-width: 50rem; }
.vt-off { margin: 0 0 1.2rem; padding: 1.3rem 1.4rem; border: 1.5px solid color-mix(in srgb, var(--accent) 60%, var(--line)); border-radius: 14px; background: var(--surface); }
.vt-off h2 { margin: 0 0 .6rem; font-size: 1.15rem; font-weight: 800; }
.vt-off p { margin: 0; line-height: 1.7; }
.vt-sec { margin: 2.6rem 0; }
.vt-sec h2 { margin: 0 0 .8rem; font-size: 1.35rem; font-weight: 800; letter-spacing: -.02em; }
.vt-sec p { line-height: 1.7; }
.vt-samples { display: grid; gap: .8rem; margin: 1rem 0 0; padding: 0; list-style: none; }
.vt-samples li { display: grid; gap: .35rem; padding: 1rem 1.1rem; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
.vt-samples strong { font-weight: 750; word-break: keep-all; }
.vt-samples span { color: var(--muted); font-size: .88rem; }
.vt-samples audio { display: block; width: 100%; margin-top: .4rem; }
.vt-shorts { display: grid; grid-template-columns: repeat(2, minmax(0, 15rem)); gap: 1rem; margin-top: 1rem; }
.vt-shorts figure { margin: 0; }
.vt-shorts a, .vt-shorts iframe { position: relative; display: block; width: 100%; aspect-ratio: 9 / 16; border: 0; border-radius: 10px; overflow: hidden; background: #000; }
.vt-shorts img { width: 100%; height: 100%; object-fit: cover; opacity: .85; }
.vt-shorts a span { position: absolute; inset: 50% auto auto 50%; width: 68px; height: 48px; margin: -24px 0 0 -34px; border-radius: 12px; background: #e00; }
.vt-shorts a span::after { content: ''; position: absolute; left: 27px; top: 14px; border: 10px solid transparent; border-left: 17px solid #fff; }
.vt-shorts figcaption { margin-top: .5rem; color: var(--muted); font-size: .85rem; word-break: keep-all; }
.vt-table { overflow-x: auto; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
.vt-table table { width: 100%; border-collapse: collapse; font-size: .9rem; }
.vt-table th, .vt-table td { padding: .55rem .75rem; border-bottom: 1px solid var(--line); text-align: left; white-space: nowrap; }
.vt-table th { color: var(--muted); font-size: .8rem; font-weight: 750; }
.vt-table tr:last-child td { border-bottom: 0; }
.vt-table tr.is-pick td { background: var(--soft); font-weight: 800; }
.vt-table tr.is-pick td:first-child { box-shadow: inset 3px 0 var(--accent); }
.vt-note { color: var(--muted); font-size: .85rem; }
.vt-note a { text-decoration: underline; text-underline-offset: 2px; }
.vt-stories { display: grid; gap: .8rem; margin: 1rem 0 0; padding: 0; list-style: none; }
.vt-stories a { display: grid; gap: .25rem; padding: 1rem 1.1rem; background: var(--surface); box-shadow: 0 1px 2px rgba(0, 0, 0, .08); }
.vt-stories span { color: var(--accent); font-size: .74rem; font-weight: 850; }
.vt-stories strong { font-size: 1rem; letter-spacing: -.02em; word-break: keep-all; }
.vt-stories em { color: var(--muted); font-size: .84rem; font-style: normal; line-height: 1.55; word-break: keep-all; }
</style>

<script is:inline>
// Only the thumbnail loads with the page; the youtube-nocookie player replaces it on click.
document.addEventListener('click', (e) => {
  const a = e.target.closest && e.target.closest('a[data-vt-yt]');
  if (!a) return;
  e.preventDefault();
  const f = document.createElement('iframe');
  f.src = `https://www.youtube-nocookie.com/embed/${a.dataset.vtYt}?autoplay=1`;
  f.title = a.dataset.title;
  f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
  f.allowFullscreen = true;
  a.replaceWith(f);
});
</script>
</BaseLayout>
