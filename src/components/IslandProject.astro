---
// Island survival RL project page: castaways on a 3D tutorial island (hslab_island repository: sim/ batched GPU
// simulator, train/ brains, viewer/ Three.js replays). The page presents them as different people: no brain or reward
// talk here (user rule); the technology belongs to the project stories.
// The viewer, vendored three.js and the chosen replays live in public/island/ (scripts/sync-island-viewer.py).
// Styles are inline: the shared CSS bundle is at its performance budget. Colors come only from the theme tokens.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getStories } from '../lib/stories';
import { projectPath, projects, storyPath, withBase } from '../lib/site';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const isKo = lang === 'ko';
const L = (ko: string, en: string) => (isKo ? ko : en);
const id = 'hslab-island';
const project = projects.find((p) => p.id === id)!;
const title = isKo ? project.nameKo : project.name;
const summary = isKo ? project.summaryKo : project.summary;
const videoId = 'RBsO2v9PNL4';
const videoTitle = 'Can an AI survive on a desert island?';      // the video's real title on YouTube
const stories = (await getStories((e) => e.data.lang === lang && e.data.project === id))
  .sort((a, b) => a.data.part - b.data.part);
const viewer = (query: string) => withBase(`/island/viewer/?${query}${isKo ? '' : '&lang=en'}`);
const playUrl = withBase(`/island/viewer/${isKo ? '' : '?lang=en'}`);
const cast = [
  { name: 'Peppo', role: L('탐험가', 'The explorer'), color: '#e0782f', trait: L('안 가 본 곳이 보이면 일단 가 봄. 오늘 간 데는 내일 또 새로움', 'Sees somewhere new, goes there. Yesterday’s map does not count today'),
    look: L('주황 셔츠 · 밀짚모자', 'Orange shirt · straw hat') },
  { name: 'Pickle', role: L('조커', 'The joker'), color: '#4c9a4a', trait: L('같은 짓 두 번은 재미없음. 오늘 안 해 본 걸 해야 직성이 풀림', 'Doing the same thing twice is boring. Has to try something new every day'),
    look: L('초록 셔츠 · 버킷햇 · 제일 작음', 'Green shirt · bucket hat · the smallest') },
  { name: 'Galoot', role: L('먹보', 'The glutton'), color: '#3d6fc4', trait: L('배불러도 먹음. 먹을 게 보이면 그게 오늘의 할 일', 'Eats even when full. If there is food in sight, that is the plan for today'),
    look: L('파란 셔츠 · 빨간 머리띠 · 배낭 · 제일 큼', 'Blue shirt · red headband · backpack · the biggest') },
];
const rules = isKo
  ? ['한 판은 최대 30일', '열매·코코넛·풀은 다시 자라지 않음. 다 먹으면 끝', '숨은 낚시터 3곳. 곳마다 하루에 나오는 물고기 수가 다름', '나무 1 + 돌 1로 작살을 만들어야 낚시 가능', '투명 벽 없음. 깊은 물에선 기력이 금방 바닥나서 익사함', '물에 들어가면 금방 추워지고, 물속에선 잠들 수 없음', '하루 한 번 아무 때나 해안에 상자가 떠밀려 오고, 2시간 뒤 사라짐 (통조림 또는 그물)', '북쪽 언덕 뒤에 숨은 동굴. 안에서는 밤에도 따뜻함']
  : ['A life lasts up to 30 days', 'Berries, coconuts and grass never grow back. Once eaten, they are gone', 'Three hidden fishing spots, each with its own daily catch', 'Fishing needs a spear: one wood and one stone', 'No invisible walls. Deep water drains energy fast, and running out there means drowning', 'Water chills you fast, and nobody can fall asleep in it', 'Once a day, at a random time, a crate washes ashore and the sea takes it back two hours later (a can or a net)', 'A cave hidden behind the north hill stays warm through the night'];
// One real life per stage, all Peppo, from public/island/replays. `query` starts each one where it gets interesting.
const replays = [
  { label: 'Attempt 1', file: 'attempt-1', speed: 1, days: L('0.4일', '0.4 days'), text: L('아직 아무것도 모름. 첫날 저녁 전에 바다에서 익사', 'Knows nothing yet. Drowns before the first evening') },
  { label: 'Attempt 2,000', file: 'attempt-2000', speed: 4, days: L('2.6일', '2.6 days'), text: L('바다는 피함. 대신 마실 물을 못 찾아 사흘째 밤에 탈수', 'Stays out of the sea, then cannot find water and dies of thirst on night three') },
  { label: 'Attempt 5,000', file: 'attempt-5000', speed: 4, days: L('5.1일', '5.1 days'), text: L('샘을 찾음. 이번엔 엿새째 아침에 굶어 죽음', 'Finds the spring. This time hunger gets there first, on morning six') },
  { label: 'Attempt 6,000', file: 'attempt-6000-fish', speed: 4, at: 2400, days: L('25.8일', '25.8 days'), text: L('11일째, 처음으로 물고기를 잡는 순간부터 재생', 'Starts at the first fish ever, on day 11') },
  { label: 'Attempt 10,000', file: 'attempt-10000', speed: 16, days: L('30일', '30 days'), text: L('30일 끝까지 살아남은 한 판을 처음부터 끝까지', 'One life that makes it all the way to day 30, start to finish') },
  { label: 'Attempt 11,000', file: 'attempt-11000-last-day', speed: 4, at: 6960, days: L('29.9일', '29.9 days'), text: L('마지막 날 재생. 끝나기 2시간 전에 얼어 죽은 가장 아까운 판', 'Starts on the last day. The closest miss: frozen two hours before the end') },
];
const keys = isKo
  ? [['W S', '이동'], ['A D', '회전'], ['E', '줍기 · 마시기 · 낚시'], ['F', '먹기'], ['Z', '자기'], ['Q', '작살 만들기'], ['T', '시간 빠르게'], ['1 2 3', 'Peppo · Pickle · Galoot']]
  : [['W S', 'Move'], ['A D', 'Turn'], ['E', 'Gather · drink · fish'], ['F', 'Eat'], ['Z', 'Sleep'], ['Q', 'Make a spear'], ['T', 'Speed up time'], ['1 2 3', 'Peppo · Pickle · Galoot']];
---
<BaseLayout lang={lang} title={title} description={summary}>
  <header class="page-top">
    <div class="shell">
      <div class="section-kicker">{L('프로젝트', 'Project')}</div>
      <h1>{title}</h1>
      <p>{summary}</p>
    </div>
  </header>

  <div class="shell isl-body">
    <section class="isl-sec">
      <h2>{L('1편: Peppo 혼자 살아남기', 'Episode 1: Peppo alone on the island')}</h2>
      <a class="isl-video" href={`https://www.youtube.com/watch?v=${videoId}`} data-isl-yt={videoId} data-title={videoTitle} target="_blank" rel="noopener">
        <img src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`} alt={videoTitle} width="480" height="360" loading="lazy" decoding="async" />
        <span aria-hidden="true"></span>
      </a>
    </section>

    <section class="isl-sec">
      <h2>{L('세 얼간이', 'The three idiots')}</h2>
      <p>{L('1편의 주인공은 Peppo. Galoot와 Pickle은 셋이 한 섬에서 같이 사는 후속 편에서 나옴.', 'Episode 1 belongs to Peppo. Galoot and Pickle arrive in a later episode, when all three share one island.')}</p>
      <img class="isl-photo" src="/images/stories/hslab-island/part5-cast.webp" width="1600" height="800" loading="lazy" decoding="async" alt={L('작살을 든 Peppo, Pickle, Galoot가 나란히 선 3D 뷰어 화면', 'Peppo, Pickle and Galoot standing side by side with spears in the 3D viewer')} />
      <div class="isl-cast">{cast.map((c) => (
        <article style={`--c:${c.color}`}>
          <strong>{c.name}</strong>
          <span class="isl-role">{c.role}</span>
          <p>{c.trait}</p>
          <small>{c.look}</small>
        </article>
      ))}</div>
    </section>

    <section class="isl-sec">
      <h2>{L('튜토리얼 섬 규칙', 'Tutorial island rules')}</h2>
      <ul>{rules.map((r) => <li>{r}</li>)}</ul>
    </section>

    <section class="isl-sec">
      <h2>{L('시도할수록 달라지는 Peppo', 'How Peppo changes, attempt by attempt')}</h2>
      <p>{L('실제로 있었던 생애 하나씩을 3D로 다시 봄. 물속 고리는 Peppo에게는 안 보이는 숨은 낚시터임. 새 창에서 열리고, 아래 막대를 누르면 원하는 날로 넘어감.', 'Each one is a life that really happened, replayed in 3D. The rings in the water are hidden fishing spots that Peppo cannot see. They open in a new tab; click the bar at the bottom to jump to any day.')}</p>
      <ol class="isl-stages">
        {replays.map((r) => (
          <li>
            <a href={viewer(`replay=../replays/${r.file}.json&speed=${r.speed}${r.at ? `&at=${r.at}` : ''}`)} target="_blank" rel="noopener">
              <b>{r.label}</b>
              <em>{r.days}</em>
              <span>{r.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="isl-sec">
      <h2>{L('직접 살아남아 보기', 'Try to survive yourself')}</h2>
      <p>{L('Peppo가 사는 섬과 같은 섬, 같은 규칙으로 직접 조종함. 며칠이나 버티는지 재 보면 됨. 키보드가 있어야 해서 PC에서만 할 수 있음.', 'The same island and the same rules as Peppo, with you at the controls. See how many days you last. It needs a keyboard, so it only works on a computer.')}</p>
      <dl class="isl-keys">{keys.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      <a class="isl-play" href={playUrl} target="_blank" rel="noopener">{L('섬에 들어가기', 'Enter the island')}<span aria-hidden="true"> →</span></a>
    </section>

    {stories.length > 0 && (
      <section class="isl-sec">
        <h2>{L('프로젝트 스토리', 'Project stories')}</h2>
        <ol class="isl-stories">{stories.map((s) => <li><a href={storyPath(s.id.split('/').pop()!, lang)}><span>{isKo ? `${s.data.part}편` : `Part ${s.data.part}`}</span><strong>{s.data.title}</strong><em>{s.data.description}</em></a></li>)}</ol>
      </section>
    )}

    <div data-ad></div>

    <section class="comments" id="comments" data-comments data-lang={lang} data-page={projectPath(id, lang)}
      data-intro={L('누가 제일 오래 살 것 같은지, 훈수 환영', 'Who will last longest? Backseat feedback welcome')}></section>
  </div>
  <script is:inline src="/comments.js" defer></script>

<style is:inline>
.isl-body { padding: 2rem 0 4rem; }
.isl-body > * { max-width: 50rem; }
.isl-sec { margin: 0 0 2.6rem; }
.isl-sec h2 { margin: 0 0 .8rem; font-size: 1.35rem; font-weight: 800; letter-spacing: -.02em; }
.isl-sec p { line-height: 1.7; word-break: keep-all; }
.isl-sec ul { margin: 0; padding-left: 1.2rem; list-style: disc; line-height: 1.65; }
.isl-sec li { margin: .35rem 0; }
.isl-sec ul li::marker { color: var(--accent); }
.isl-video, .isl-sec iframe { position: relative; display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: 10px; overflow: hidden; background: #000; }
.isl-video img { width: 100%; height: 100%; object-fit: cover; opacity: .9; }
.isl-video span { position: absolute; inset: 50% auto auto 50%; width: 68px; height: 48px; margin: -24px 0 0 -34px; border-radius: 12px; background: #e00; }
.isl-video span::after { content: ''; position: absolute; left: 27px; top: 14px; border: 10px solid transparent; border-left: 17px solid #fff; }
.isl-photo { display: block; width: 100%; height: auto; margin-top: .8rem; border-radius: 10px; }
.isl-cast { display: grid; grid-template-columns: repeat(3, 1fr); gap: .8rem; margin: 1rem 0; }
.isl-cast article { display: grid; gap: .3rem; align-content: start; padding: 1rem 1.1rem; border-top: 4px solid var(--c); border-radius: 10px; background: var(--surface); box-shadow: 0 1px 2px rgba(0, 0, 0, .08); }
.isl-cast strong { font-size: 1.15rem; letter-spacing: -.02em; }
.isl-role { justify-self: start; padding: .1rem .55rem; border-radius: 999px; background: var(--soft); font-size: .78rem; font-weight: 800; }
.isl-cast p { margin: .2rem 0 0; font-size: .9rem; line-height: 1.55; }
.isl-cast small { color: var(--muted); font-size: .8rem; }
.isl-stages { display: grid; grid-template-columns: repeat(2, 1fr); gap: .6rem; margin: 1rem 0 0; padding: 0; list-style: none; }
.isl-stages li { margin: 0; }
.isl-stages a { display: grid; grid-template-columns: 1fr auto; gap: .25rem .6rem; height: 100%; box-sizing: border-box; padding: .8rem .9rem; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
.isl-stages a:hover { border-color: var(--accent); }
.isl-stages b { font-size: .95rem; }
.isl-stages em { color: var(--accent); font-size: .85rem; font-style: normal; font-weight: 800; }
.isl-stages span { grid-column: 1 / -1; color: var(--muted); font-size: .84rem; line-height: 1.5; word-break: keep-all; }
.isl-keys { display: grid; grid-template-columns: repeat(2, 1fr); gap: .3rem 1rem; margin: 1rem 0; font-size: .88rem; }
.isl-keys div { display: flex; gap: .6rem; align-items: baseline; }
.isl-keys dt { min-width: 3.2rem; font-family: ui-monospace, monospace; font-weight: 800; }
.isl-keys dd { margin: 0; color: var(--muted); }
.isl-play { display: inline-block; padding: .55rem 1rem; border: 1.5px solid var(--accent); border-radius: 8px; font-weight: 800; }
.isl-stories { display: grid; gap: .8rem; margin: 1rem 0 0; padding: 0; list-style: none; }
.isl-stories a { display: grid; gap: .25rem; padding: 1rem 1.1rem; background: var(--surface); box-shadow: 0 1px 2px rgba(0, 0, 0, .08); }
.isl-stories span { color: var(--accent); font-size: .74rem; font-weight: 850; }
.isl-stories strong { font-size: 1rem; letter-spacing: -.02em; word-break: keep-all; }
.isl-stories em { color: var(--muted); font-size: .84rem; font-style: normal; line-height: 1.55; word-break: keep-all; }
@media (max-width: 640px) {
  .isl-cast, .isl-stages, .isl-keys { grid-template-columns: 1fr; }
}
</style>

<script is:inline>
// Only the thumbnail loads with the page; the youtube-nocookie player replaces it on click.
document.addEventListener('click', (e) => {
  const a = e.target.closest && e.target.closest('a[data-isl-yt]');
  if (!a) return;
  e.preventDefault();
  const f = document.createElement('iframe');
  f.src = `https://www.youtube-nocookie.com/embed/${a.dataset.islYt}?autoplay=1`;
  f.title = a.dataset.title;
  f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
  f.allowFullscreen = true;
  a.replaceWith(f);
});
</script>
</BaseLayout>
