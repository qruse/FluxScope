---
import { getStories } from '../lib/stories';
import BaseLayout from '../layouts/BaseLayout.astro';
import LabPageStyles from './LabPageStyles.astro';
import { storyPath, projectPath, projects, storyThumb } from '../lib/site';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const isKo = lang === 'ko';
const entries = await getStories((e) => e.data.lang === lang);
---
<BaseLayout lang={lang} title={isKo ? '프로젝트 스토리' : 'Project Stories'} description={isKo ? 'HSL Lab 프로젝트를 만들면서 고르고, 삽질하고, 고친 과정을 편마다 정리한 개발 스토리. AI 기상 예보, AI 주식 대결, AI 마피아 게임의 뒷이야기.' : 'Development stories from HSL Lab projects: what each one chose, broke and fixed, part by part, behind the AI weather forecast, the AI stock duel and AI Mafia.'}>
  <header class="page-top"><div class="shell"><div class="section-kicker">{isKo ? '프로젝트 스토리' : 'Project Stories'}</div><h1>{isKo ? '만들면서 생긴 일' : 'How things got built'}</h1><p>{isKo ? '프로젝트마다 고르고, 삽질하고, 고친 과정을 편마다 정리함.' : 'What each project chose, broke and fixed, one part at a time.'}</p></div></header>
  <div class="shell portfolio-list">
    {[...projects].sort((a, b) => b.addedAt.localeCompare(a.addedAt)).map((project) => {
      const parts = entries.filter((e) => e.data.project === project.id).sort((a, b) => a.data.part - b.data.part);
      if (!parts.length) return null;
      return (
        <section class="portfolio-project" id={project.id}>
          <h2><a class="pen-under" href={projectPath(project.id, lang)}>{isKo ? project.nameKo : project.name}</a></h2>
          <p>{isKo ? project.taglineKo : project.tagline}</p>
          <div class="post-grid">
            {parts.map((p) => {
              const slug = p.id.split('/').pop()!;
              return (
                <article class="post-card">
                  <a class="card-link" href={storyPath(slug, lang)}>
                    <div class="card-media taped"><img class="card-visual" src={storyThumb(slug)} width="720" height="480" loading="lazy" decoding="async" alt={p.data.title} /></div>
                    <div class="card-copy">
                      <div class="eyebrow"><span class="category-pip"></span>{isKo ? `${p.data.part}편` : `Part ${p.data.part}`}</div>
                      <h3 class="pen-under">{p.data.title}</h3>
                      <p>{p.data.description}</p>
                    </div>
                  </a>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}
  </div>
  <LabPageStyles />
</BaseLayout>
