---
// "AIs play Mafia" project page. The ai_mafia repository (mafia.py daily) uploads latest.json to /api/mafia/
// every morning at 06:00 KST, and one game-NNN.json per finished game. Seats are code names A–H shuffled every game;
// the models behind them, living players' roles, night moves and private thoughts appear only after a game ends.
// Visitors vote for the seat they suspect (/api/mafia/vote); the tally is handed to the AIs before their own vote.
import { getStories } from '../lib/stories';
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects, projectPath, storyPath } from '../lib/site';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const isKo = lang === 'ko';
const L = (ko: string, en: string) => (isKo ? ko : en);
const project = projects.find((p) => p.id === 'ai-mafia')!;
const stories = (await getStories((e) => e.data.lang === lang && e.data.project === project.id))
  .sort((a, b) => a.data.part - b.data.part);
const rules = [
  [L('참가자', 'Players'), L('Claude 3 · GPT 3 · Gemini 2, 게임 4부터 고정', 'Claude ×3 · GPT ×3 · Gemini ×2, fixed from game 4')],
  [L('직업', 'Roles'), L('마피아 2 · 경찰 · 의사 · 시민 4', 'Mafia ×2 · Cop · Doctor · Citizen ×4')],
  [L('하루', 'A day'), L('06시 소식·토론 공개 → 다음 날 05시 투표', 'News and talk at 06:00 → vote at 05:00 next day')],
  [L('처형', 'Execution'), L('최다 득표자 최후 변론 → 찬반 과반이면 처형', 'Top vote-getter defends → executed on a majority for')],
  [L('밤', 'Night'), L('마피아 살해 · 의사 보호 · 경찰 조사', 'Mafia kill · Doctor protects · Cop checks')],
  [L('승리', 'Win'), L('마피아 전원 처형 → 시민팀 / 마피아 ≥ 나머지 → 마피아', 'Both Mafia executed → town / Mafia ≥ the rest → Mafia')],
  [L('이름', 'Names'), L('매 게임 A~H 섞음, AI끼리는 서로 모델 모름', 'A–H reshuffled each game; the AIs never learn who is who')],
  [L('관객 투표', 'Your vote'), L('하루 한 표, AI들이 투표 직전에 참고로 봄', 'One a day; the AIs see it as a hint before voting')],
  [L('쉬는 날', 'Days off'), L('사용 한도로 못 나오는 AI가 있으면 그날 쉼', 'If any AI is out of usage, that day is skipped')],
];
---
<BaseLayout lang={lang} title={isKo ? project.nameKo : project.name} description={isKo ? project.summaryKo : project.summary}>
  <header class="mf-hero">
    <div class="shell">
      <div class="section-kicker">{L('프로젝트', 'Project')}</div>
      <h1>{isKo ? project.nameKo : project.name}</h1>
      <p class="mf-lede">{isKo ? project.summaryKo : project.summary}</p>
    </div>
  </header>

  <div class="shell mf-body" data-mf data-lang={lang}>
    <p class="mf-meta" data-mf-meta>{L('불러오는 중…', 'Loading…')}</p>
    <div data-mf-live></div>

    <section class="mf-sec mf-more-sec" id="history">
      <div class="mf-tabs" role="tablist">
        <button type="button" role="tab" data-tab="standings">{L('전적', 'Records')}</button>
        <button type="button" role="tab" data-tab="history">{L('지난 게임', 'Past games')}</button>
        <button type="button" role="tab" data-tab="notes">{L('AI 노트', 'AI notes')}</button>
        <button type="button" role="tab" data-tab="rules">{L('규칙', 'Rules')}</button>
      </div>
      <div class="mf-panel" data-panel="standings">
        <p class="mf-sub">{L('게임 4부터 · 고정 멤버 8명 · 팀이 이기면 승', 'From game 4 · the fixed eight · a win means the team won')}</p>
        <div data-mf-standings></div>
      </div>
      <div class="mf-panel" data-panel="history" hidden><div data-mf-history></div><div data-mf-viewer></div></div>
      <div class="mf-panel" data-panel="notes" hidden>
        <p class="mf-sub">{L('게임이 끝날 때마다 각자 고쳐 쓰고, 다음 게임 내내 다시 읽음', 'Each AI rewrites its notes after every game and rereads them through the next')}</p>
        <div class="mf-notes" data-mf-notes></div>
      </div>
      <div class="mf-panel" data-panel="rules" hidden>
        <dl class="mf-rules">{rules.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      </div>
    </section>

    <div data-ad></div>

    {stories.length > 0 && (
      <section class="mf-sec">
        <div class="mf-head"><h2>{L('프로젝트 스토리', 'Project stories')}</h2></div>
        <ol class="mf-stories">{stories.map((s) => <li><a href={storyPath(s.id.split('/').pop()!, lang)}><span>{isKo ? `${s.data.part}편` : `Part ${s.data.part}`}</span><strong>{s.data.title}</strong><em>{s.data.description}</em></a></li>)}</ol>
      </section>
    )}
    <p class="mf-note">{L('발언·속마음은 AI가 쓴 그대로이며, 투표는 IP 해시로만 구분함.', 'Every line is the AIs’ own, unedited. Votes are told apart by an IP hash only.')}</p>
    <section class="comments" id="comments" data-comments data-lang={lang} data-page={projectPath('ai-mafia', lang)}
      data-intro={L('추리 훈수 환영', 'Armchair detectives welcome')}></section>
  </div>
  <script is:inline src="/comments.js" defer></script>

<script is:inline>
(() => {
  const root = document.querySelector('[data-mf]');
  if (!root) return;
  const ko = root.dataset.lang === 'ko';
  const T = ko
    ? { fail: '데이터를 불러오지 못했음. 잠시 뒤 다시 열어 주세요.', game: '게임', day: (n) => `${n}일차`, updated: '갱신', news: '오늘 아침 소식', start: 'AI들이 모였습니다. 이 중 2명이 마피아입니다.', died: (s) => `간밤에 ${s}가 살해당했습니다`, quiet: '간밤에는 아무도 죽지 않았습니다', executed: (s) => `투표로 ${s}가 처형됐습니다`, tie: '동률이라 아무도 처형되지 않았습니다', lastWords: '유언', defense: '최후 변론', finalVote: (y, n) => `처형 찬반 투표 · 찬성 ${y} · 반대 ${n}`, yes: '찬성', no: '반대', spared: (s) => `${s}는 찬반 투표에서 살아남았습니다`, townWin: '시민팀 승리', mafiaWin: '마피아 승리', next: '다음 아침', closes: '투표 마감', seats: '참가자', alive: '생존', killed: (d) => `${d}일차 밤 사망`, hanged: (d) => `${d}일차 처형`, hidden: 'AI들은 서로 누가 어떤 모델인지 모름. 직업은 죽거나 게임이 끝나면 공개', voteBtn: '마피아 같음', voted: '내 표', votes: (n) => `${n}표`, voteHint: '누가 마피아 같은지 투표해 주세요. 내일 새벽 AI들이 투표 직전에 이 결과를 봄.', voteClosed: '오늘 투표는 마감됐음', voteErr: { closed: '투표 마감됨 (집계 중)', stale_day: '새 날이 시작됐음. 새로고침해 주세요', invalid_seat: '투표할 수 없는 자리임', other: '투표를 저장하지 못했음. 잠시 뒤 다시 시도해 주세요' }, talk: '오늘의 토론', r1: '1라운드 · 동시에 첫 발언', r2: '2라운드 · 차례로 반응', log: '지난 날들', visitors: (n) => `관객 투표 ${n}표`, noVisitors: '관객 투표 없음', aiVotes: 'AI 처형 투표', abstain: '기권', reveal: '전체 공개', roles: '직업과 정체', nights: '밤에 있었던 일', mafiaChat: '마피아 밀담', doctor: '의사 보호', cop: '경찰 조사', isMafia: '마피아', notMafia: '마피아 아님', saved: '의사가 살림', thoughts: '속마음', reviews: '게임 뒤 한 줄 회고', none: '아직 없음', open: '다시 보기', close: '닫기', winner: '승리', days: (n) => `${n}일`, mafiaWere: '마피아', noHistory: '첫 게임이 끝나면 여기에 쌓임', model: 'AI', games: '게임', wins: '승', rate: '승률', asMafia: '마피아로', asTown: '시민팀으로', survived: '생존', more: '펼쳐 보기', less: '접기', waitTalk: '토론 준비 중', steps: {} }
    : { fail: 'Could not load the data. Please try again later.', game: 'Game', day: (n) => `Day ${n}`, updated: 'Updated', news: 'This morning', start: 'The AIs sit down at the table. Two of them are the Mafia.', died: (s) => `${s} was killed in the night`, quiet: 'Nobody died last night', executed: (s) => `${s} was executed by vote`, tie: 'A tie: nobody was executed', lastWords: 'Last words', defense: 'Final defense', finalVote: (y, n) => `Execution vote · ${y} for · ${n} against`, yes: 'For', no: 'Against', spared: (s) => `${s} survived the execution vote`, townWin: 'The town wins', mafiaWin: 'The Mafia win', next: 'Next morning', closes: 'Voting closes', seats: 'Players', alive: 'Alive', killed: (d) => `Killed, night ${d}`, hanged: (d) => `Executed, day ${d}`, hidden: 'The AIs don’t know which model is which. Roles show when a player dies or the game ends', voteBtn: 'Suspect', voted: 'Your vote', votes: (n) => `${n} vote${n === 1 ? '' : 's'}`, voteHint: 'Who do you think is Mafia? The AIs see this tally right before they vote tomorrow at dawn.', voteClosed: 'Voting for today is closed', voteErr: { closed: 'Voting is closed (counting)', stale_day: 'A new day has started. Please reload', invalid_seat: 'You cannot vote for that seat', other: 'Could not save your vote. Please try again' }, talk: 'Today’s discussion', r1: 'Round 1 · everyone at once', r2: 'Round 2 · in turn', log: 'Earlier days', visitors: (n) => `Visitor vote, ${n} total`, noVisitors: 'No visitor votes', aiVotes: 'AI execution vote', abstain: 'Abstain', reveal: 'Full reveal', roles: 'Roles and identities', nights: 'What happened at night', mafiaChat: 'Mafia chat', doctor: 'Doctor protects', cop: 'Cop checks', isMafia: 'Mafia', notMafia: 'not Mafia', saved: 'saved by the Doctor', thoughts: 'Private thoughts', reviews: 'One-line reviews after the game', none: 'None yet', open: 'Replay', close: 'Close', winner: 'won', days: (n) => `${n} day${n === 1 ? '' : 's'}`, mafiaWere: 'Mafia', noHistory: 'Finished games will collect here', model: 'AI', games: 'Games', wins: 'Wins', rate: 'Win rate', asMafia: 'As Mafia', asTown: 'As town', survived: 'Survived', more: 'Show all', less: 'Collapse', waitTalk: 'Discussion coming up', steps: { '토론1': 'Talk 1', '토론2': 'Talk 2', '투표': 'Vote', '밤': 'Night', '유언': 'Last words', '최후 변론': 'Final defense', '찬반 투표': 'Execution vote' } };
  Object.assign(T, ko
    ? { hidden: '직업은 죽거나 게임이 끝나면 공개', voteHint: '마피아 같은 AI에 투표. 내일 새벽 AI들이 투표 전에 봄.', evVote: '투표', evNight: '밤', evStart: '시작', oldLineup: '이전 멤버', noRecord: '게임 4가 끝나면 집계 시작', record: (w, l) => `${w}승 ${l}패`, foldNights: '밤에 있었던 일', foldThoughts: (n) => `속마음 ${n}개`, foldReviews: '게임 뒤 한 줄 회고', open: '다시 보기' }
    : { hidden: 'Roles show when a player dies or the game ends', voteHint: 'Vote for the AI you suspect. The AIs see it before voting tomorrow at dawn.', evVote: 'Vote', evNight: 'Night', evStart: 'Start', oldLineup: 'Earlier lineup', noRecord: 'Records start once game 4 ends', record: (w, l) => `${w}–${l}`, foldNights: 'What happened at night', foldThoughts: (n) => `${n} private thoughts`, foldReviews: 'One-line reviews after the game', open: 'Replay' });
  const ROLE = ko ? { mafia: '마피아', cop: '경찰', doctor: '의사', citizen: '시민' } : { mafia: 'Mafia', cop: 'Cop', doctor: 'Doctor', citizen: 'Citizen' };
  const SC = { A: '#e0603f', B: '#3446a3', C: '#2f9e5b', D: '#b7791f', E: '#7a4ea3', F: '#2b8a9e', G: '#c2477a', H: '#6b7d2a' };
  const CO = { claude: '#d97757', codex: '#10a37f', agy: '#4f7be8' };
  const $ = (q) => root.querySelector(q);
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  let D = null;
  let E = {};
  const tx = (s, en = E) => esc((!ko && en[s]) || s);
  const av = (s) => `<span class="mf-av" style="--s:${SC[s] || '#888'}">${esc(s)}</span>`;
  const roleChip = (r) => (r ? `<em class="mf-role is-${r}">${ROLE[r]}</em>` : '');
  const store = { get: (k) => { try { return localStorage.getItem(k); } catch { return null; } }, set: (k, v) => { try { localStorage.setItem(k, v); } catch { /* private mode */ } } };

  fetch('/api/mafia/latest.json', { cache: 'no-store' }).then((r) => (r.ok ? r.json() : Promise.reject(r.status))).then(init).catch(() => { $('[data-mf-meta]').textContent = T.fail; });

  function init(d) {
    D = d;
    E = d.en || {};
    const g = d.game;
    $('[data-mf-meta]').textContent = `${T.game} ${g.game} · ${T.day(g.day)} · ${T.updated} ${String(d.updated).replace('T', ' ').slice(0, 16)} KST`;
    $('[data-mf-live]').innerHTML = gameHTML(g, E, d.models, true);
    wire($('[data-mf-live]'));
    if (d.vote?.open) loadTally();
    pastGames();
    standings();
    notes();
    tabs();
    const m = location.hash.match(/^#game-(\d+)$/);
    if (m) { showTab('history'); openGame(Number(m[1])); }
  }

  // ---------- tabs under the live game ----------
  function showTab(name) {
    root.querySelectorAll('[data-tab]').forEach((b) => { const on = b.dataset.tab === name; b.classList.toggle('is-on', on); b.setAttribute('aria-selected', on); });
    root.querySelectorAll('[data-panel]').forEach((el) => { el.hidden = el.dataset.panel !== name; });
    store.set('mafia-tab', name);
    if (name === 'notes') fitNotes();
  }
  function tabs() {
    root.querySelectorAll('[data-tab]').forEach((b) => b.addEventListener('click', () => showTab(b.dataset.tab)));
    showTab(store.get('mafia-tab') || 'standings');
  }

  // ---------- one game (live or replay) ----------
  function gameHTML(g, en, models, live) {
    const days = g.days || [];
    const cur = days[days.length - 1];
    const prev = days[days.length - 2];
    const over = g.step === 'over';
    ROLES = Object.fromEntries(g.seats.filter((s) => s.role).map((s) => [s.seat, s.role]));
    SEATM = Object.fromEntries(g.seats.filter((s) => models?.[s.model]).map((s) => [s.seat, models[s.model]]));
    let h = `<section class="mf-news"><p class="mf-kicker">${live ? T.news : `${T.game} ${g.game} · ${esc(g.started)} – ${esc(g.ended || '')}`}</p>`;
    const items = [];
    const ev = (k, day, body) => `<div class="mf-ev"><span class="mf-ev-k">${k}<small>${T.day(day)}</small></span><div>${body}</div></div>`;
    if (prev && prev.votes?.length) items.push(ev(T.evVote, prev.day, voteResult(prev, en)));
    items.push(cur.morning?.start ? ev(T.evStart, cur.day, morning(cur)) : ev(T.evNight, cur.day - 1, morning(cur)));
    // AIs out of usage sit out ("이번 주는 쉼") and a random bench model plays their seat that day (engine records them as rest)
    const full = (id) => esc(models?.[id]?.full || id);
    for (const r of cur.rest || []) items.push(`<p class="mf-clock">${en ? `${full(r.model)} is sitting out this week (usage limit) · ${full(r.by)} played seat ${esc(r.seat)} today` : `${full(r.model)}: 사용 한도로 이번 주는 쉼 · 오늘 ${esc(r.seat)} 자리는 ${full(r.by)}가 대신 둠`}</p>`);
    if (cur.votes?.length) items.push(ev(T.evVote, cur.day, voteResult(cur, en)));
    if (g.result) items.push(`<p class="mf-win is-${g.result.winner}">${g.result.winner === 'town' ? T.townWin : T.mafiaWin}</p>`);
    h += `<div class="mf-day-tag">${T.day(cur.day)}</div><div class="mf-evs">${items.join('')}</div>`;
    if (live && !over) h += `<p class="mf-clock">${T.next} <b>${nextSix()}</b> · ${T.closes} <b>05:00</b> KST</p>`;
    h += `</section>`;
    h += seatsHTML(g, models, live && D.vote?.open);
    if (live && !over) {
      h += `<section class="mf-sec"><div class="mf-head"><h2>${T.talk}</h2><p class="mf-sub">${T.day(cur.day)}</p></div>${cur.talk?.length ? talkHTML(cur, en) : `<p class="mf-sub">${T.waitTalk}</p>`}</section>`;
    }
    const past = live && !over ? days.slice(0, -1) : days;
    if (past.length) {
      h += `<section class="mf-sec"><div class="mf-head"><h2>${live && !over ? T.log : `${T.game} ${g.game}`}</h2></div>${[...past].reverse().map((d) => dayHTML(d, en, !live && d === past[past.length - 1])).join('')}</section>`;
    }
    if (over) h += revealHTML(g, en, models);
    return h;
  }

  function morning(d) {
    const m = d.morning || {};
    if (m.start) return `<p class="mf-headline">${T.start}</p>`;
    if (m.died) return `<p class="mf-headline">${av(m.died)} ${esc(T.died(m.died))} ${roleChip(m.role)}</p>`;
    return `<p class="mf-headline is-quiet">${T.quiet}</p>`;
  }

  // Per rendered game: seats whose role is public (dead, or everyone once the game is over) and the model behind
  // each seat. Visitors always see the models; only the AIs never learn who is who.
  let ROLES = {};
  let SEATM = {};
  const who = (s) => (SEATM[s] ? `<small class="mf-who" style="--c:${CO[SEATM[s].cli]}">${esc(s)} · ${esc(SEATM[s].full)}</small>` : '');

  // from game 4 the top vote-getter gives a final defense and the rest vote for or against the execution
  function voteResult(d, en) {
    const df = d.defense ? `<blockquote class="mf-last"><span>${av(d.defense.seat)} ${T.defense}</span>${tx(d.defense.say, en)}</blockquote>` : '';
    if (!d.executed) return d.defense ? df + `<p class="mf-headline is-sub">${av(d.defense.seat)} ${esc(T.spared(d.defense.seat))}</p>` : `<p class="mf-headline is-sub">${T.tie}</p>`;
    return df + `<p class="mf-headline is-sub">${av(d.executed)} ${esc(T.executed(d.executed))} ${roleChip(ROLES[d.executed])}</p>`
      + (d.last_words ? `<blockquote class="mf-last"><span>${T.lastWords}</span>${tx(d.last_words, en)}</blockquote>` : '');
  }

  function seatsHTML(g, models, canVote) {
    const mine = canVote ? store.get(`mafia-vote-${D.vote.game}-${D.vote.day}`) : null;
    const cards = g.seats.map((s) => {
      const m = s.model && models?.[s.model];
      const status = s.alive ? T.alive : s.died?.how === 'vote' ? T.hanged(s.died.day) : T.killed(s.died?.day);
      const vote = canVote && s.alive ? `<button type="button" class="mf-vote${mine === s.seat ? ' is-mine' : ''}" data-vote="${esc(s.seat)}">${mine === s.seat ? T.voted : T.voteBtn}</button><div class="mf-tally" data-tally="${esc(s.seat)}"><span></span><small></small></div>` : '';
      return `<article class="mf-seat${s.alive ? '' : ' is-dead'}" style="--s:${SC[s.seat]}">${av(s.seat)}<p class="mf-status">${status}</p>${roleChip(s.role)}${m ? `<p class="mf-model" style="--c:${CO[m.cli]}">${esc(m.full)}</p>` : ''}${vote}</article>`;
    }).join('');
    const hint = canVote ? `<p class="mf-hint" data-vote-msg>${T.voteHint}</p>` : '';
    const note = `<p class="mf-sub">${T.hidden}</p>`;
    return `<section class="mf-sec"><div class="mf-head"><h2>${T.seats}</h2>${note}</div>${hint}<div class="mf-seats" style="--n:${g.seats.length}">${cards}</div></section>`;
  }

  function talkHTML(d, en) {
    return [1, 2].map((r) => {
      const said = (d.talk || []).filter((t) => t.round === r);
      if (!said.length) return '';
      return `<div class="mf-round"><h3>${r === 1 ? T.r1 : T.r2}</h3>${said.map((t) => `<div class="mf-msg" style="--s:${SC[t.seat]}">${av(t.seat)}<p>${who(t.seat)}${tx(t.say, en)}</p></div>`).join('')}</div>`;
    }).join('');
  }

  function votesHTML(d, en) {
    if (!d.votes?.length) return '';
    let h = '';
    const v = d.visitor;
    if (v) {
      const max = Math.max(1, ...Object.values(v.tally || {}));
      h += `<div class="mf-crowd"><h4>${v.total ? T.visitors(v.total) : T.noVisitors}</h4>${v.total ? Object.entries(v.tally).sort((a, b) => b[1] - a[1]).map(([s, n]) => `<p>${av(s)}<span class="mf-bar"><i style="width:${(n / max) * 100}%;background:${SC[s]}"></i></span><b>${n}</b></p>`).join('') : ''}</div>`;
    }
    h += `<div class="mf-ballots"><h4>${T.aiVotes}</h4>${d.votes.map((x) => `<p>${av(x.seat)}<span class="mf-arrow">→</span>${x.target ? av(x.target) : `<em class="mf-abs">${T.abstain}</em>`}<span class="mf-why">${tx(x.why, en)}</span></p>`).join('')}</div>`;
    const f = d.final || [];
    const y = f.filter((x) => x.yes).length;
    const fin = f.length ? `<div class="mf-ballots mf-final"><h4>${T.finalVote(y, f.length - y)}</h4>${f.map((x) => `<p>${av(x.seat)}<em class="mf-yn${x.yes ? ' is-yes' : ''}">${x.yes ? T.yes : T.no}</em><span class="mf-why">${tx(x.why, en)}</span></p>`).join('')}</div>` : '';
    return `<div class="mf-votes">${h}</div>${fin}`;
  }

  function dayHTML(d, en, open) {
    const body = morning(d) + talkHTML(d, en) + votesHTML(d, en) + (d.votes?.length ? voteResult(d, en) : '');
    return `<details class="mf-dayx"${open ? ' open' : ''}><summary><b>${T.day(d.day)}</b><span>${esc(d.date)}</span></summary><div class="mf-dayx-body">${body}</div></details>`;
  }

  function revealHTML(g, en, models) {
    const name = (seat) => { const s = g.seats.find((x) => x.seat === seat); const m = s?.model && models?.[s.model]; return m ? m.full : ''; };
    const roles = `<div class="mf-roles">${g.seats.map((s) => `<p style="--s:${SC[s.seat]}">${av(s.seat)}<b>${esc(name(s.seat))}</b>${roleChip(s.role)}</p>`).join('')}</div>`;
    const reviews = g.seats.filter((s) => g.reviews?.[s.seat]).map((s) => `<p class="mf-thought">${av(s.seat)}<small>${esc(name(s.seat))}</small><span>${tx(g.reviews[s.seat], en)}</span></p>`).join('');
    const nights = (g.nights || []).map((n) => `<div class="mf-night"><h4>${T.day(n.day)}</h4>`
      + (n.mafia || []).map((x) => `<div class="mf-msg is-dark" style="--s:${SC[x.seat]}">${av(x.seat)}<p><small>${T.mafiaChat} → ${esc(x.target || '')}</small>${tx(x.msg, en)}</p></div>`).join('')
      + (n.doctor ? `<p class="mf-act">${av(n.doctor.seat)} ${T.doctor} → ${av(n.doctor.target)}${n.saved ? ` <em class="mf-role is-doctor">${T.saved}</em>` : ''}</p>` : '')
      + (n.cop ? `<p class="mf-act">${av(n.cop.seat)} ${T.cop} → ${av(n.cop.target)} <em class="mf-role ${n.cop.mafia ? 'is-mafia' : 'is-citizen'}">${n.cop.mafia ? T.isMafia : T.notMafia}</em></p>` : '')
      + `</div>`).join('');
    const byDay = {};
    (g.thoughts || []).forEach((t) => { (byDay[t.day] = byDay[t.day] || []).push(t); });
    const thoughts = Object.entries(byDay).map(([day, list]) => `<div class="mf-night"><h4>${T.day(day)}</h4>${list.map((t) => `<p class="mf-thought">${av(t.seat)}<small>${esc(T.steps[t.step] || t.step)}</small><span>${tx(t.text, en)}</span></p>`).join('')}</div>`).join('');
    const fold = (title, inner) => (inner ? `<details class="mf-fold"><summary>${title}</summary>${inner}</details>` : '');
    return `<section class="mf-sec mf-reveal"><div class="mf-head"><h2>${T.reveal}</h2></div>${roles}
      ${fold(T.foldReviews, reviews && `<div class="mf-night">${reviews}</div>`)}
      ${fold(T.foldNights, nights && `<div class="mf-two">${nights}</div>`)}
      ${fold(T.foldThoughts((g.thoughts || []).length), thoughts && `<div class="mf-two">${thoughts}</div>`)}</section>`;
  }

  // ---------- visitor vote ----------
  function loadTally() {
    fetch(`/api/mafia/votes?game=${D.vote.game}&day=${D.vote.day}`, { cache: 'no-store' }).then((r) => r.json()).then(showTally).catch(() => {});
  }

  function showTally(t) {
    const total = t.total || 0;
    root.querySelectorAll('[data-tally]').forEach((el) => {
      const n = t.tally?.[el.dataset.tally] || 0;
      el.querySelector('span').style.width = total ? `${(n / total) * 100}%` : '0';
      el.querySelector('small').textContent = T.votes(n);
    });
  }

  function wire(box) {
    box.querySelectorAll('[data-vote]').forEach((btn) => btn.addEventListener('click', () => {
      const seat = btn.dataset.vote;
      const msg = box.querySelector('[data-vote-msg]');
      fetch('/api/mafia/vote', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ game: D.vote.game, day: D.vote.day, seat }) })
        .then((r) => r.json().then((j) => (r.ok ? j : Promise.reject(j.error))))
        .then((t) => {
          store.set(`mafia-vote-${D.vote.game}-${D.vote.day}`, seat);
          box.querySelectorAll('[data-vote]').forEach((b) => { const on = b.dataset.vote === seat; b.classList.toggle('is-mine', on); b.textContent = on ? T.voted : T.voteBtn; });
          showTally(t);
          if (msg) msg.textContent = T.voteHint;
        })
        .catch((code) => { if (msg) msg.textContent = T.voteErr[code] || T.voteErr.other; });
    }));
  }

  // ---------- history, standings, notes ----------
  function pastGames() {
    const list = [...(D.history || [])].reverse();
    if (!list.length) { $('[data-mf-history]').innerHTML = `<p class="mf-sub">${T.noHistory}</p>`; return; }
    $('[data-mf-history]').innerHTML = `<ol class="mf-games">${list.map((x) => {
      const mafia = Object.entries(x.roles).filter(([, r]) => r === 'mafia').map(([m]) => D.models[m]?.full || m);
      const old = x.game < (D.season_start || 4) ? `<em class="mf-old">${T.oldLineup}</em>` : '';
      return `<li><b>${T.game} ${x.game}</b><em class="mf-win-chip is-${x.winner}">${x.winner === 'town' ? T.townWin : T.mafiaWin}</em>${old}<span>${esc(x.started)} · ${T.days(x.days)} · ${T.mafiaWere} ${mafia.map(esc).join(', ')}</span><button type="button" data-game="${x.game}">${T.open}</button></li>`;
    }).join('')}</ol>`;
    root.querySelectorAll('[data-game]').forEach((b) => b.addEventListener('click', () => openGame(Number(b.dataset.game))));
  }

  function openGame(n) {
    const box = $('[data-mf-viewer]');
    fetch(`/api/mafia/game-${String(n).padStart(3, '0')}.json`, { cache: 'no-store' }).then((r) => (r.ok ? r.json() : Promise.reject(r.status))).then((f) => {
      box.innerHTML = `<div class="mf-viewer"><button type="button" class="mf-close" data-close>${T.close}</button>${gameHTML(f.game, f.en || {}, f.models, false)}</div>`;
      box.querySelector('[data-close]').addEventListener('click', () => { box.innerHTML = ''; try { window.history.replaceState(null, '', location.pathname); } catch { /* ignore */ } });
      try { window.history.replaceState(null, '', `#game-${n}`); } catch { /* ignore */ }
      box.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }).catch(() => { box.innerHTML = `<p class="mf-sub">${T.fail}</p>`; });
  }

  // records count only games with the fixed lineup (from D.season_start); earlier games stay in Past games
  function standings() {
    const fixed = Object.entries(D.models).filter(([, m]) => !m.retired).map(([id]) => id);
    const rows = Object.fromEntries(fixed.map((m) => [m, { m, g: 0, w: 0, mg: 0, mw: 0, tg: 0, tw: 0 }]));
    for (const x of D.history || []) {
      if (x.game < (D.season_start || 4)) continue;
      for (const [m, r] of Object.entries(x.roles)) {
        const s = rows[m];
        if (!s) continue;
        const won = (r === 'mafia') === (x.winner === 'mafia');
        s.g++; s.w += won;
        if (r === 'mafia') { s.mg++; s.mw += won; } else { s.tg++; s.tw += won; }
      }
    }
    const list = Object.values(rows).sort((a, b) => (b.g ? b.w / b.g : -1) - (a.g ? a.w / a.g : -1) || b.w - a.w);
    const pct = (w, g) => (g ? `${Math.round((w / g) * 100)}%` : '–');
    const frac = (w, g) => (g ? `${w}/${g}` : '–');
    const empty = list.every((s) => !s.g) ? `<p class="mf-sub mf-empty">${T.noRecord}</p>` : '';
    $('[data-mf-standings]').innerHTML = empty + `<div class="mf-tbl"><table><tr><th>${T.model}</th><th>${T.games}</th><th>${T.rate}</th><th>${T.asMafia}</th><th>${T.asTown}</th></tr>${list.map((s) => {
      const m = D.models[s.m] || { full: s.m, cli: '' };
      return `<tr><td><i style="background:${CO[m.cli] || '#888'}"></i>${esc(m.full)}</td><td>${s.g ? T.record(s.w, s.g - s.w) : '–'}</td><td><b>${pct(s.w, s.g)}</b></td><td>${frac(s.mw, s.mg)}</td><td>${frac(s.tw, s.tg)}</td></tr>`;
    }).join('')}</table></div>`;
  }

  function md(src) {
    const inline = (s) => esc(s).replace(/\*\*(.+?)\*\*/g, '<b>$1</b>').replace(/`([^`]+)`/g, '<code>$1</code>');
    const out = []; let list = null;
    const end = () => { if (list) { out.push(`</${list}>`); list = null; } };
    for (const raw of String(src || '').split('\n')) {
      const line = raw.trimEnd();
      const h = line.match(/^(#{1,4})\s+(.*)/);
      const ul = line.match(/^\s*[-*]\s+(.*)/);
      const ol = line.match(/^\s*\d+\.\s+(.*)/);
      if (h) { end(); out.push(`<h4>${inline(h[2])}</h4>`); }
      else if (ul || ol) { const t = ul ? 'ul' : 'ol'; if (list !== t) { end(); out.push(`<${t}>`); list = t; } out.push(`<li>${inline((ul || ol)[1])}</li>`); }
      else if (!line.trim()) end();
      else { end(); out.push(`<p>${inline(line)}</p>`); }
    }
    end();
    return out.join('');
  }

  function notes() {
    const box = $('[data-mf-notes]');
    box.innerHTML = Object.entries(D.models).filter(([, m]) => !m.retired).map(([id, m]) => {
      const text = D.notes?.[id];
      return `<article class="mf-note-card" style="--c:${CO[m.cli]}"><h3>${esc(m.full)}</h3><div class="mf-md">${text ? md((!ko && E[text]) || text) : `<p>${T.none}</p>`}</div><button type="button" class="mf-more">${T.more}</button></article>`;
    }).join('');
    box.querySelectorAll('.mf-more').forEach((btn) => btn.addEventListener('click', () => { const el = btn.previousElementSibling; const open = el.classList.toggle('is-open'); btn.textContent = open ? T.less : T.more; }));
    if (!box.closest('[hidden]')) fitNotes();
  }
  // short notes need no "show all" button; measured once the panel is visible
  function fitNotes() {
    root.querySelectorAll('.mf-md:not(.is-fit)').forEach((el) => {
      el.classList.add('is-fit');
      if (el.scrollHeight <= el.clientHeight + 4) { el.classList.add('is-open'); el.nextElementSibling.hidden = true; }
    });
  }

  function nextSix() {
    const now = new Date(Date.now() + 9 * 3600000);
    const tomorrow = now.getUTCHours() >= 6;
    const d = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() + (tomorrow ? 1 : 0)));
    return `${d.getUTCMonth() + 1}/${d.getUTCDate()} 06:00`;
  }
})();
</script>

