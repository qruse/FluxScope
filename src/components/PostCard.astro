---
import type { Post } from '../lib/site';
import { categories, postPath, withBase } from '../lib/site';
import { formatDate } from '../i18n/ui';

interface Props { post: Post; featured?: boolean; compact?: boolean; }
const { post, featured = false, compact = false } = Astro.props;
const category = categories[post.data.category];
const isKo = post.data.lang === 'ko';
const categoryName = isKo ? category.nameKo : category.name;
const readMoreText = isKo ? '글 읽기' : 'Read article';
---
<article class:list={['post-card', { featured, compact }]}>
  <a class="card-link" href={postPath(post)} aria-label={`${readMoreText}: ${post.data.title}`}>
    <div class="card-media">
      <img
        class="card-visual"
        src={withBase(post.data.image.src)}
        alt={post.data.image.alt}
        width={post.data.image.width}
        height={post.data.image.height}
        loading={featured ? 'eager' : 'lazy'}
        decoding="async"
      />
    </div>
    <div class="card-copy">
      <div class="eyebrow"><span class="category-pip"></span>{categoryName}<span class="eyebrow-sep">/</span><time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, post.data.lang)}</time></div>
      <h3>{post.data.title}</h3>
      <p>{post.data.description}</p>
      <span class="read-link">{readMoreText} <span aria-hidden="true">↗</span></span>
    </div>
  </a>
</article>
