---
// "Can AI beat the Nasdaq and the S&P 500?" project page. The ai_portfolio_duel repository (duel.py daily) uploads
// latest.json to /api/duel/ after every US close; the page draws the head-to-head, a return chart, each AI's book,
// the weekly decisions and its own strategy and review from it with plain SVG and text.
// Paper trading only; prices come from the Toss Securities Open API.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects, storyPath } from '../lib/site';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const isKo = lang === 'ko';
const L = (ko: string, en: string) => (isKo ? ko : en);
const project = projects.find((p) => p.id === 'ai-duel')!;
const stories = (await getCollection('stories', (e) => e.data.lang === lang && e.data.project === project.id))
  .sort((a, b) => a.data.part - b.data.part);
const rules = [
  [L('자금', 'Money'), L('각자 2만 달러', '$20,000 each')],
  [L('대상', 'Universe'), L('미국 상장 주식(ADR 포함)·ETF (지수 ETF 가능)', 'US-listed stocks (ADRs too) and ETFs, index ETFs too')],
  [L('금지', 'Not allowed'), L('레버리지·인버스, 공매도, 신용', 'Leveraged or inverse, shorts, margin')],
  [L('체결', 'Fills'), L('다음 미국 거래일 종가', 'Next US close')],
  [L('수수료', 'Fees'), L('매매마다 0.1%', '0.1% per trade')],
  [L('리듬', 'Rhythm'), L('토요일 회의, 매일 아침 평가', 'Saturday meeting, marked daily')],
  [L('추론 강도', 'Reasoning effort'), L('GPT·Opus high, Argon medium', 'GPT and Opus high, Argon medium')],
];
---
<BaseLayout lang={lang} title={isKo ? project.nameKo : project.name} description={isKo ? project.summaryKo : project.summary}>
  <header class="du-hero">
    <div class="shell">
      <div class="section-kicker">{L('프로젝트', 'Project')}</div>
      <h1>{isKo ? project.nameKo : project.name}</h1>
      <p class="du-lede">{isKo ? project.summaryKo : project.summary}</p>
    </div>
  </header>

  <div class="shell du-body" data-du data-lang={lang}>
    <p class="du-status" data-du-status></p>
    <section class="du-vs" aria-label={L('대결 현황', 'Standings')} data-du-players></section>
    <dl class="du-bench" data-du-bench></dl>
    <p class="du-meta" data-du-meta>{L('불러오는 중…', 'Loading…')}</p>

    <section class="du-sec">
      <div class="du-head"><h2>{L('누적 수익률', 'Cumulative return')}</h2><p class="du-legend" data-du-legend></p></div>
      <div class="du-chart" data-du-chart></div>
    </section>

    <section class="du-sec">
      <div class="du-head"><h2>{L('포트폴리오', 'Portfolios')}</h2><p class="du-sub">{L('막대는 비중, 회색 칸은 ETF', 'Bars show weights; grey cells are ETFs')}</p></div>
      <div class="du-two" data-du-books></div>
    </section>

    <section class="du-sec">
      <div class="du-head"><h2>{L('주간 결정 기록', 'Weekly decisions')}</h2><p class="du-sub">{L('매주 토요일, 각자 회고하고 내린 결정', 'What each AI decided every Saturday after its own review')}</p></div>
      <div class="du-timeline" data-du-log></div>
    </section>

    <section class="du-sec">
      <div class="du-head"><h2>{L('AI가 직접 쓰는 전략과 회고', 'Strategy and reviews, written by the AIs')}</h2><p class="du-sub">{L('매주 스스로 고치는 문서. 자기 개선이 보이는 곳', 'Rewritten by each AI every week: where self-improvement shows')}</p></div>
      <div class="du-two" data-du-docs></div>
    </section>

    <section class="du-sec du-about">
      <div>
        <h2>{L('규칙', 'Rules')}</h2>
        <dl class="du-rules">{rules.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
        <p class="du-goal"><b>{L('목표', 'Goal')}</b>{L('S&P 500(SPY)·나스닥100(QQQ)을 이기는 것과 상대 AI들을 이기는 것, 둘 다 주목표. 서로의 수익률은 매주 공개되고 보유 종목은 비공개.', 'Beat the S&P 500 (SPY) and the Nasdaq-100 (QQQ), and beat the other AIs; both are primary. Each sees the others’ returns every week, not their holdings.')}</p>
        <p class="du-goal is-note"><b>{L('왜 Argon만 medium?', 'Why is Argon on medium?')}</b>{L('GPT-6.1 Sol과 Opus 5.5는 high 위에 xhigh·max가 더 있어 high가 중간 단계임. Gemini 4 Argon은 low·medium·high 세 단계뿐이라 high가 최고 단계. 그래서 같은 자리(최고 단계 바로 아래)인 medium으로 맞췄고, medium은 구글이 정한 기본값이기도 함.', 'GPT-6.1 Sol and Opus 5.5 have xhigh and max above high, so high is a middle step for them. Gemini 4 Argon only has low, medium and high, so high is its top step. Argon runs on medium, the same position one below the top, which is also Google’s default.')}</p>
      </div>
      {stories.length > 0 && (
        <div>
          <h2>{L('프로젝트 스토리', 'Project stories')}</h2>
          <ol class="du-stories">{stories.map((s) => <li><a href={storyPath(s.id.split('/').pop()!, lang)}><span>{isKo ? `${s.data.part}편` : `Part ${s.data.part}`}</span><strong>{s.data.title}</strong><em>{s.data.description}</em></a></li>)}</ol>
        </div>
      )}
    </section>
    <p class="du-note">{L('모의투자이며 실제 주문은 나가지 않음. 시세는 토스증권 Open API(정규장 일봉 종가). SPY·QQQ는 지수를 따라가는 ETF로 비교 기준이며, AI도 살 수 있음. 투자 권유가 아님.', 'Paper trading only; no real orders. Prices are regular-session daily closes from the Toss Securities Open API. SPY and QQQ are index-tracking ETFs used as benchmarks; the AIs may buy them too. Not investment advice.')}</p>
  </div>

<script is:inline>
(() => {
  const root = document.querySelector('[data-du]');
  if (!root) return;
  const ko = root.dataset.lang === 'ko';
  const T = ko
    ? { fail: '데이터를 불러오지 못했음. 잠시 뒤 다시 열어 주세요.', wait: '첫 체결 대기', waitLong: '첫 포트폴리오는 다음 미국 거래일 종가에 체결됨', start: '시작', updated: '갱신', lead: '앞서는 중', tie: '동률', vs: '대비', pending: '체결 대기 · 목표 비중', holdings: '보유 비중', cash: '현금', filled: '체결', waiting: '체결 대기', strategy: '운용 전략', journal: '최근 회고', none: '아직 없음', more: '펼쳐 보기', less: '접기', nodata: '첫 체결 뒤부터 그래프가 그려짐', beatBoth: '지수 둘 다 이기는 중' }
    : { fail: 'Could not load the data. Please try again later.', wait: 'Waiting for first fill', waitLong: 'The first portfolio fills at the next US close', start: 'Started', updated: 'Updated', lead: 'Leading', tie: 'Tied', vs: 'vs', pending: 'Waiting to fill · target weights', holdings: 'Holdings', cash: 'Cash', filled: 'Filled', waiting: 'Waiting', strategy: 'Strategy · machine-translated from Korean', journal: 'Latest review · machine-translated from Korean', none: 'None yet', more: 'Show all', less: 'Collapse', nodata: 'The chart starts after the first fill', beatBoth: 'Beating both indexes' };
  const CLI = { gpt: 'Codex CLI · high', opus: 'Claude CLI · high', argon: 'Antigravity CLI · medium' };
  const COL = { gpt: 'var(--accent)', opus: 'var(--pen)', argon: '#7b4fc9', SPY: '#8d989e', QQQ: '#c99326' };
  const ETF_COL = '#4f5f68'; // 라이트·다크 모드 모두에서 보이는 고정 회색
  const PAL = ['#e0603f', '#3446a3', '#3b7d3a', '#b7791f', '#7a4ea3', '#2b8a9e', '#c2477a', '#6b7f2a', '#a05a2c', '#476f95'];
  const $ = (q) => root.querySelector(q);
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const ok = (v) => v != null && isFinite(v);
  const pct = (v, d = 2) => (ok(v) ? `${v >= 0 ? '+' : ''}${(v * 100).toFixed(d)}%` : '–');
  const pp = (v) => (ok(v) ? `${v >= 0 ? '+' : ''}${(v * 100).toFixed(2)}%p` : '–');
  const usd = (v) => (v == null ? '–' : '$' + Math.round(v).toLocaleString('en-US'));
  const sign = (v) => (ok(v) ? (v >= 0 ? 'is-up' : 'is-down') : '');

  fetch('/api/duel/latest.json', { cache: 'no-store' }).then((r) => (r.ok ? r.json() : Promise.reject(r.status))).then(draw).catch(() => { $('[data-du-meta]').textContent = T.fail; });

  function draw(d) {
    const cap = d.capital_usd;
    const bh = d.bench?.history || [];
    const bLast = bh[bh.length - 1];
    const bRet = (s) => (bLast ? bLast[s] / cap - 1 : null);
    const ret = (a) => (a.history?.length ? a.history[a.history.length - 1].nav / a.capital_usd - 1 : null);
    const started = d.agents.some((a) => a.history?.length);
    // 순위는 수익률이 나온 AI끼리만. 동률이면 같은 순위.
    const scored = d.agents.filter((a) => ok(ret(a))).sort((p, q) => ret(q) - ret(p));
    const rank = (a) => (ok(ret(a)) ? 1 + scored.filter((x) => ret(x) > ret(a)).length : null);
    const leader = scored.length > 1 && ret(scored[0]) > ret(scored[1]) ? scored[0] : null;

    const order = started ? [...scored, ...d.agents.filter((a) => !scored.includes(a))] : d.agents;
    $('[data-du-players]').style.setProperty('--n', d.agents.length);
    $('[data-du-players]').innerHTML = order.map((a) => {
      const r = ret(a);
      const nav = a.history?.length ? a.history[a.history.length - 1].nav : a.capital_usd;
      const beat = ok(r) && ok(bRet('SPY')) && r > bRet('SPY') && r > bRet('QQQ');
      const rk = rank(a);
      return `<article class="du-player" style="--c:${COL[a.id]}">
        <p class="du-model">${esc(CLI[a.id] || a.model)}${rk && scored.length > 1 ? `<span class="du-rank">${ko ? `${rk}위` : `#${rk}`}</span>` : ''}</p>
        <h2>${esc(a.name)}</h2>
        <p class="du-big ${r == null ? 'is-wait' : sign(r)}">${r == null ? T.wait : pct(r)}</p>
        <p class="du-nav">${usd(nav)}<span>/ ${usd(a.capital_usd)}</span>${a.start ? `<span>· ${T.start} ${esc(a.start)}</span>` : ''}</p>
        <ul class="du-diff">${['SPY', 'QQQ'].map((s) => { const v = ok(r) && ok(bRet(s)) ? r - bRet(s) : null; return `<li><span>${s} ${T.vs}</span><b class="${sign(v)}">${pp(v)}</b></li>`; }).join('')}</ul>
        <div class="du-badges">${leader === a ? `<em class="du-badge">${T.lead}</em>` : ''}${beat ? `<em class="du-badge is-beat">${T.beatBoth}</em>` : ''}</div>
      </article>`;
    }).join('');
    $('[data-du-status]').textContent = !started ? T.waitLong : leader ? `${leader.name} ${T.lead}` : scored.length > 1 ? T.tie : '';
    const bnames = (!ko && d.bench?.names_en) || d.bench?.names || {};
    $('[data-du-bench]').innerHTML = Object.entries(bnames).map(([s, n]) => `<div style="--c:${COL[s]}"><dt>${esc(n)}</dt><dd class="${sign(bRet(s))}">${pct(bRet(s))}</dd></div>`).join('');
    const upd = `${T.updated} ${String(d.updated).replace('T', ' ').slice(0, 16)}`;
    $('[data-du-meta]').textContent = started && d.bench.start ? `${T.start} ${d.bench.start} · ${upd}` : upd;

    chart(d, started);
    $('[data-du-books]').innerHTML = d.agents.map((a) => book(a, d)).join('');
    $('[data-du-log]').innerHTML = timeline(d);
    $('[data-du-docs]').innerHTML = d.agents.map(docs).join('');
    root.querySelectorAll('.du-md').forEach((box) => {
      const btn = box.nextElementSibling;
      if (box.scrollHeight <= box.clientHeight + 4) { box.classList.add('is-open'); btn.hidden = true; return; }
      btn.addEventListener('click', () => { const open = box.classList.toggle('is-open'); btn.textContent = open ? T.less : T.more; });
    });
  }

  function chart(d, started) {
    const cap = d.capital_usd;
    const series = d.agents.map((a) => ({ id: a.id, name: a.name, ai: true, pts: (a.history || []).map((x) => [x.date, x.nav / a.capital_usd - 1]) }))
      .concat(Object.keys(d.bench?.names || {}).map((s) => ({ id: s, name: ((!ko && d.bench.names_en) || d.bench.names)[s], ai: false, pts: (d.bench.history || []).map((x) => [x.date, x[s] / cap - 1]) })));
    $('[data-du-legend]').innerHTML = series.map((s) => `<span style="--c:${COL[s.id]}" class="${s.ai ? 'is-ai' : ''}">${esc(s.name)}</span>`).join('');
    const W = 900, H = 320, P = { l: 52, r: 62, t: 16, b: 30 };
    const dates = [...new Set(series.flatMap((s) => s.pts.map((p) => p[0])))].sort();
    if (!started || !dates.length) {
      $('[data-du-chart]').innerHTML = `<div class="du-empty"><svg viewBox="0 0 ${W} 180" aria-hidden="true"><line x1="0" x2="${W}" y1="90" y2="90" class="z"/><path d="M0 90 C 150 70, 300 110, 450 80 S 750 100, ${W} 64" class="ghost"/><path d="M0 90 C 180 100, 330 60, 480 96 S 760 70, ${W} 110" class="ghost"/></svg><p>${T.nodata}</p></div>`;
      return;
    }
    const vals = series.flatMap((s) => s.pts.map((p) => p[1])).concat(0);
    let lo = Math.min(...vals), hi = Math.max(...vals);
    const pad = Math.max((hi - lo) * 0.15, 0.004); lo -= pad; hi += pad;
    const x = (dt) => P.l + (dates.length === 1 ? (W - P.l - P.r) / 2 : (dates.indexOf(dt) / (dates.length - 1)) * (W - P.l - P.r));
    const y = (v) => P.t + (1 - (v - lo) / (hi - lo)) * (H - P.t - P.b);
    let g = '';
    for (let i = 0; i <= 4; i++) { const v = lo + ((hi - lo) * i) / 4; g += `<line x1="${P.l}" x2="${W - P.r}" y1="${y(v)}" y2="${y(v)}" class="g"/><text x="${P.l - 10}" y="${y(v) + 4}" text-anchor="end">${(v * 100).toFixed(1)}%</text>`; }
    const step = Math.max(1, Math.ceil(dates.length / 7));
    g += dates.map((dt, i) => (i % step === 0 || i === dates.length - 1 ? `<text x="${x(dt)}" y="${H - 8}" text-anchor="middle">${dt.slice(5).replace('-', '/')}</text>` : '')).join('');
    const lines = series.map((s) => {
      if (!s.pts.length) return '';
      const path = s.pts.map((p, i) => `${i ? 'L' : 'M'}${x(p[0]).toFixed(1)} ${y(p[1]).toFixed(1)}`).join('');
      const last = s.pts[s.pts.length - 1];
      return `<path d="${path}" fill="none" stroke="${COL[s.id]}" stroke-width="${s.ai ? 3 : 1.6}" ${s.ai ? '' : 'stroke-dasharray="5 5"'} stroke-linejoin="round" stroke-linecap="round"/>`
        + `<circle cx="${x(last[0])}" cy="${y(last[1])}" r="${s.ai ? 4.5 : 3}" fill="${COL[s.id]}"/>`
        + (s.ai ? `<text x="${x(last[0]) + 9}" y="${y(last[1]) + 4}" class="lbl" fill="${COL[s.id]}">${pct(last[1], 1)}</text>` : '');
    }).join('');
    $('[data-du-chart]').innerHTML = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${ko ? '누적 수익률 차트' : 'Cumulative return chart'}">${g}<line x1="${P.l}" x2="${W - P.r}" y1="${y(0)}" y2="${y(0)}" class="z"/>${lines}</svg>`;
  }

  function weightsOf(a) {
    if (a.holdings?.length) {
      const nav = a.history?.length ? a.history[a.history.length - 1].nav : a.capital_usd;
      return { rows: a.holdings.map((h) => [h.symbol, h.weight ?? (h.value != null ? h.value / nav : 0)]), cash: a.cash / nav, live: true };
    }
    if (a.pending) {
      const rows = Object.entries(a.pending.targets).map(([s, w]) => [s, w]);
      return { rows, cash: Math.max(0, 1 - rows.reduce((t, r) => t + r[1], 0)), live: false };
    }
    return { rows: [], cash: 1, live: false };
  }

  function book(a, d) {
    const { rows, cash, live } = weightsOf(a);
    rows.sort((p, q) => q[1] - p[1]);
    const etf = (s) => d.kinds?.[s] === 'ETF';
    let n = 0;
    const colors = Object.fromEntries(rows.map(([s]) => [s, etf(s) ? ETF_COL : PAL[n++ % PAL.length]]));
    const bar = rows.map(([s, w]) => `<span style="flex:${w};background:${colors[s]}" title="${esc(s)} ${(w * 100).toFixed(1)}%">${w >= 0.07 ? esc(s) : ''}</span>`).join('') + (cash > 0.002 ? `<span class="is-cash" style="flex:${cash}"></span>` : '');
    const max = Math.max(...rows.map((r) => r[1]), cash, 0.01);
    const list = rows.map(([s, w]) => `<li><span class="du-sym"><i style="background:${colors[s]}"></i>${esc(s)}${etf(s) ? '<small>ETF</small>' : d.kinds?.[s] === 'DEPOSITARY_RECEIPT' ? '<small>ADR</small>' : ''}</span><span class="du-nm">${esc(d.desc?.[s]?.[ko ? 'ko' : 'en'] || (d.names?.[s] !== s ? d.names?.[s] : '') || '')}</span><span class="du-w"><span style="width:${(w / max) * 100}%;background:${colors[s]}"></span></span><b>${(w * 100).toFixed(1)}%</b></li>`).join('')
      + `<li class="is-cash"><span class="du-sym"><i></i>${T.cash}</span><span class="du-nm">${live ? usd(a.cash) : ''}</span><span class="du-w"><span style="width:${(cash / max) * 100}%"></span></span><b>${(cash * 100).toFixed(1)}%</b></li>`;
    return `<article class="du-book" style="--c:${COL[a.id]}"><h3><i></i>${esc(a.name)}<small>${live ? T.holdings : T.pending}</small></h3><div class="du-stack">${bar}</div><ul class="du-list">${list}</ul></article>`;
  }

  function timeline(d) {
    const weeks = [...new Set(d.agents.flatMap((a) => (a.log || []).map((l) => l.week)))].sort((p, q) => q - p);
    if (!weeks.length) return `<p class="du-sub">${T.none}</p>`;
    return weeks.map((w) => `<div class="du-week" style="--n:${d.agents.length}"><span class="du-wk">${ko ? `${w}주차` : `Week ${w}`}</span>${d.agents.map((a) => {
      const l = (a.log || []).find((x) => x.week === w);
      if (!l) return `<div class="du-entry is-empty" style="--c:${COL[a.id]}"></div>`;
      const top = Object.entries(l.targets || {}).sort((p, q) => q[1] - p[1]).slice(0, 6).map(([s, v]) => `<span>${esc(s)} ${(v * 100).toFixed(0)}%</span>`).join('');
      return `<div class="du-entry" style="--c:${COL[a.id]}"><p class="du-who">${esc(a.name)} <span>${l.filled_on ? `${T.filled} ${esc(l.filled_on)}` : T.waiting}</span></p><p>${esc((!ko && l.summary_en) || l.summary)}</p><p class="du-top">${top}</p></div>`;
    }).join('')}</div>`).join('');
  }

  // Small Markdown renderer for the AI-written files: headings, lists, tables, bold, code, links, paragraphs.
  function md(src) {
    const inline = (s) => esc(s).replace(/\*\*(.+?)\*\*/g, '<b>$1</b>').replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g, (_, t, u) => '<a hr' + `ef="${u}" rel="noopener nofollow" target="_blank">${t}</a>`);
    const out = []; let list = null, table = [];
    const endList = () => { if (list) { out.push(`</${list}>`); list = null; } };
    const flush = () => {
      endList();
      if (table.length) {
        const rows = table.filter((r) => !/^\|?[\s:|-]+$/.test(r)).map((r) => r.replace(/^\||\|$/g, '').split('|').map((c) => inline(c.trim())));
        out.push(`<div class="du-tbl"><table>${rows.map((r, i) => `<tr>${r.map((c) => (i ? `<td>${c}</td>` : `<th>${c}</th>`)).join('')}</tr>`).join('')}</table></div>`);
        table = [];
      }
    };
    for (const raw of String(src || '').split('\n')) {
      const line = raw.trimEnd();
      if (/^\s*\|/.test(line)) { endList(); table.push(line.trim()); continue; }
      if (table.length) flush();
      const h = line.match(/^(#{1,4})\s+(.*)/);
      const ul = line.match(/^\s*[-*]\s+(.*)/);
      const ol = line.match(/^\s*\d+\.\s+(.*)/);
      if (h) { flush(); const lv = Math.min(6, h[1].length + 3); out.push(`<h${lv}>${inline(h[2])}</h${lv}>`); }
      else if (ul || ol) { const t = ul ? 'ul' : 'ol'; if (list !== t) { flush(); out.push(`<${t}>`); list = t; } out.push(`<li>${inline((ul || ol)[1])}</li>`); }
      else if (!line.trim()) flush();
      else { endList(); out.push(`<p>${inline(line)}</p>`); }
    }
    flush();
    return out.join('');
  }

  function docs(a) {
    const box = (title, text) => `<div class="du-doc"><h4>${title}</h4><div class="du-md">${text ? md(text) : `<p>${T.none}</p>`}</div><button type="button" class="du-more">${T.more}</button></div>`;
    return `<article class="du-docs" style="--c:${COL[a.id]}"><h3><i></i>${esc(a.name)}</h3>${box(T.journal, (!ko && a.journal_en) || a.journal)}${box(T.strategy, (!ko && a.strategy_en) || a.strategy)}</article>`;
  }
})();
</script>

