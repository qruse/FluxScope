---
// "Can AI beat the KMA?" project page. The forecast pipeline (weather_forecasting repository, scripts/service.py)
// uploads latest.json and verify/<base>.json to /api/weather/ once a day. The page draws them with a small
// built-in tile map (OpenStreetMap standard tiles) and plain SVG; no map or chart library.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { storyPath, projects, projectPath } from '../lib/site';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const isKo = lang === 'ko';
const project = projects.find((p) => p.id === 'beat-kma')!;
const stories = (await getCollection('stories', (e) => e.data.lang === lang && e.data.project === project.id))
  .sort((a, b) => a.data.part - b.data.part);
// Test period result (2026-07-01 to 2026-10-12 issuances, scored once; see project story part 4).
const test = [
  { label: isKo ? '기온 MAE' : 'Temp MAE', ours: '0.84℃', kma: '1.08℃' },
  { label: isKo ? '습도 MAE' : 'Humidity MAE', ours: '4.5%', kma: '6.5%' },
  { label: isKo ? '풍속 MAE' : 'Wind MAE', ours: '0.58m/s', kma: '0.96m/s' },
  { label: isKo ? '비 F1' : 'Rain F1', ours: '0.41', kma: '0.26' },
];
const vars = isKo
  ? [['ta', '기온'], ['pop', '강수확률'], ['ws', '바람'], ['hm', '습도']]
  : [['ta', 'Temp'], ['pop', 'Rain chance'], ['ws', 'Wind'], ['hm', 'Humidity']];
---
<BaseLayout lang={lang} title={isKo ? project.nameKo : project.name} description={isKo ? project.summaryKo : project.summary}>
  <header class="page-top">
    <div class="shell">
      <div class="section-kicker">{isKo ? '프로젝트' : 'Project'}</div>
      <h1>{isKo ? project.nameKo : project.name}</h1>
      <p>{isKo ? project.summaryKo : project.summary}</p>
      <div class="wx-badge">
        <p class="wx-badge-title">{isKo ? '테스트 기간엔 기상청보다 정확했음' : 'More accurate than the KMA in the test period'}</p>
        <table>
          <thead><tr><th></th>{test.map((t) => <th>{t.label}</th>)}</tr></thead>
          <tbody>
            <tr class="is-ours"><th>{isKo ? '우리 AI' : 'Our AI'}</th>{test.map((t) => <td>{t.ours}</td>)}</tr>
            <tr><th>{isKo ? '기상청' : 'KMA'}</th>{test.map((t) => <td>{t.kma}</td>)}</tr>
          </tbody>
        </table>
        <p class="wx-cost"><b>{isKo ? '총 개발 비용 약 2만 원' : 'Total development cost: about 20,000 KRW'}</b>{isKo ? ' · Colab 구독비와 Claude 토큰 사용량이 전부임' : ' (roughly 15 USD) · just a Colab subscription and Claude tokens'}</p>
        <p class="wx-note">{isKo
          ? '2026년 7월~10월 12일 발표 33번 · ASOS 97곳 · 발표 후 48시간 기준. 한정된 기간의 결과이고 다른 계절·큰 사건까지 이긴다는 뜻은 아님. 기상청 값은 5km 격자 예보라, 관측소별 평균 오차를 보정해 줘도(기온 1.02℃) 우리가 앞섰음.'
          : '33 issuances from July to October 12, 2026 · 97 ASOS stations · 48 hours after issuance. A limited period; it does not show wins in every season or major event. KMA values are 5 km grid forecasts; even with its per-station bias removed (1.02 °C) ours stayed ahead.'}</p>
      </div>
    </div>
  </header>

  <!-- Weather icons, drawn with the site's pen strokes. -->
  <svg width="0" height="0" class="wx-sprite" aria-hidden="true">
    <symbol id="wx-sun" viewBox="0 0 32 32"><circle cx="16" cy="16" r="6" class="i-sun" /><path class="i-ray" d="M16 3v4M16 25v4M3 16h4M25 16h4M6.8 6.8l2.8 2.8M22.4 22.4l2.8 2.8M6.8 25.2l2.8-2.8M22.4 9.6l2.8-2.8" /></symbol>
    <symbol id="wx-moon" viewBox="0 0 32 32"><path class="i-moon" d="M21 5.5a11 11 0 1 0 5.5 16A9 9 0 0 1 21 5.5z" /></symbol>
    <symbol id="wx-part" viewBox="0 0 32 32"><circle cx="11" cy="11" r="5" class="i-sun" /><path class="i-ray" d="M11 2v3M2 11h3M4.6 4.6l2 2M17.4 4.6l-2 2M4.6 17.4l2-2" /><path class="i-cloud" d="M10 26h14a5 5 0 0 0 0-10 7 7 0 0 0-13.4 1.6A4.3 4.3 0 0 0 10 26z" /></symbol>
    <symbol id="wx-partn" viewBox="0 0 32 32"><path class="i-moon" d="M13 3a8 8 0 1 0 4 12.5A6.5 6.5 0 0 1 13 3z" /><path class="i-cloud" d="M10 27h14a5 5 0 0 0 0-10 7 7 0 0 0-13.4 1.6A4.3 4.3 0 0 0 10 27z" /></symbol>
    <symbol id="wx-cloud" viewBox="0 0 32 32"><path class="i-cloud" d="M8 25h16a6 6 0 0 0 0-12 8 8 0 0 0-15.3 2A5 5 0 0 0 8 25z" /></symbol>
    <symbol id="wx-rain" viewBox="0 0 32 32"><path class="i-cloud" d="M8 20h16a6 6 0 0 0 0-12 8 8 0 0 0-15.3 2A5 5 0 0 0 8 20z" /><path class="i-drop" d="M11 23l-2 5M17 23l-2 5M23 23l-2 5" /></symbol>
  </svg>

  <div class="wx-layout shell" data-wx data-lang={lang} data-src="/api/weather/">
    <div class="wx-main">
      <section aria-labelledby="wx-fc-title">
        <h2 id="wx-fc-title" class="wx-h2"><span class="pen-under">{isKo ? '우리 AI vs 기상청 예보' : 'Our AI vs the KMA forecast'}</span></h2>
        <p class="wx-meta" data-wx-meta>{isKo ? '예보를 불러오는 중…' : 'Loading the forecast…'}</p>

        <div class="wx-now" hidden data-wx-now>
          <div class="wx-now-head">
            <label><span class="sr-only">{isKo ? '관측소' : 'Station'}</span><select data-wx-select></select></label>
            <span class="wx-now-time" data-wx-time></span>
          </div>
          <div class="wx-now-cols" data-wx-now-cols></div>
        </div>

        <div class="wx-mapbox" hidden data-wx-mapbox>
          <div class="wx-map-bar">
            <div class="wx-seg" role="group" aria-label={isKo ? '항목' : 'Variable'} data-wx-vars>
              {vars.map(([id, label], i) => <button type="button" data-var={id} aria-pressed={i === 0 ? 'true' : 'false'}>{label}</button>)}
            </div>
            <p class="wx-legend"><b class="o">{isKo ? '우리 AI' : 'Our AI'}</b><b class="k">{isKo ? '기상청' : 'KMA'}</b></p>
          </div>
          <div class="wx-map" data-wx-map role="application" aria-label={isKo ? '예보 지도: 끌어서 이동, 휠이나 버튼으로 확대' : 'Forecast map: drag to move, wheel or buttons to zoom'}>
            <div class="wx-tiles"></div>
            <div class="wx-pins"></div>
            <div class="wx-zoom"><button type="button" data-z="1" aria-label={isKo ? '확대' : 'Zoom in'}>+</button><button type="button" data-z="-1" aria-label={isKo ? '축소' : 'Zoom out'}>−</button></div>
            <p class="wx-attrib">© <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a> contributors</p>
          </div>
          <div class="wx-slider">
            <input type="range" min="0" max="47" value="0" data-wx-slider aria-label={isKo ? '예보 시각' : 'Forecast time'} />
            <div class="wx-slider-days" data-wx-slider-days></div>
          </div>
        </div>

        <div class="wx-daily" hidden data-wx-daily></div>
        <div class="wx-hours-wrap" hidden data-wx-hours-wrap><table class="wx-hours" data-wx-hours></table></div>
      </section>

      <section aria-labelledby="wx-week-title">
        <h2 id="wx-week-title" class="wx-h2"><span class="pen-under">{isKo ? '지난 7일 성적표' : 'Last 7 days'}</span></h2>
        <p class="wx-meta">{isKo ? '지난 발표들을 실제 ASOS 관측과 맞춰 본 결과. 굵은 쪽이 이긴 쪽, MAE는 낮을수록 · 비 F1은 높을수록 좋음.' : 'Past issuances checked against ASOS observations. Bold marks the winner; lower MAE and higher rain F1 are better.'}</p>
        <div class="wx-table-wrap"><table class="wx-week" data-wx-week></table></div>
        <div class="wx-replay" hidden data-wx-replay>
          <label>{isKo ? '다시 보기' : 'Replay'} <select data-wx-run></select></label>
          <p class="wx-meta" data-wx-replay-meta></p>
          <svg class="wx-chart" viewBox="0 0 640 250" data-wx-replay-chart role="img" aria-label={isKo ? '지난 예보와 관측' : 'Past forecast and observations'}></svg>
          <p class="wx-key"><span class="k-ours">{isKo ? '우리 AI' : 'Our AI'}</span><span class="k-kma">{isKo ? '기상청' : 'KMA'}</span><span class="k-obs">{isKo ? '관측' : 'Observed'}</span></p>
        </div>
      </section>
    </div>

    <aside class="wx-side" aria-label={isKo ? '개발 스토리' : 'Development story'}>
      <p class="section-kicker">{isKo ? '개발 스토리' : 'Development story'}</p>
      <ol>
        {stories.map((s) => <li><a href={storyPath(s.id.split('/').pop()!, lang)}><span>{isKo ? `${s.data.part}편` : `Part ${s.data.part}`}</span>{s.data.title}</a></li>)}
      </ol>
      <p class="wx-side-note">{isKo
        ? '매일 05시 발표 기준으로 48시간 예보를 냄. 우리 모델: Aurora 1.5(고정) + 관측소 보정 헤드(head) 앙상블.'
        : 'A 48-hour forecast from the 05:00 KST issuance every day. Model: frozen Aurora 1.5 plus an ensemble of station heads.'}</p>
    </aside>
  </div>
  <div class="shell">
    <section class="comments" id="comments" data-comments data-lang={lang} data-page={projectPath('beat-kma', lang)}
      data-intro={isKo ? '훈수 환영' : 'Backseat forecasting welcome'}></section>
  </div>
  <script is:inline src="/comments.js" defer></script>
</BaseLayout>

<script>
  type Series = Record<string, (number | null)[]>;
  type Stn = { ours: Series; kma: Series; obs: Series };
  type Run = { base: string; times: string[]; stations: Record<string, Stn> };
  type Score = Record<string, number | null>;
  type Site = {
    updated: string; cut: number; forecast: Run;
    stations: { stn: number; name: string; nameEn: string; lat: number; lon: number }[];
    week: null | { runs: ({ base: string; ours: Score; kma: Score })[]; total: { ours: Score; kma: Score }; stations: Record<string, { ours: Score; kma: Score }> };
  };

  const root = document.querySelector<HTMLElement>('[data-wx]');
  if (root) start(root);

  async function start(root: HTMLElement) {
    const ko = root.dataset.lang === 'ko';
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const T = ko
      ? { fail: '예보를 불러오지 못했음. 잠시 뒤 다시 열어 주셈.', issued: '발표', updated: '갱신', ours: '우리 AI', kma: '기상청', obs: '관측', sky: '하늘', temp: '기온', pop: '강수확률', rn: '강수량', ws: '풍속', hm: '습도', am: '오전', pm: '오후', none: '아직 채점할 지난 예보가 없음', total: '7일 합계', run: '발표', f1: '비 F1', st: '이 관측소', wd: ['일', '월', '화', '수', '목', '금', '토'], h: '시' }
      : { fail: 'Could not load the forecast. Please try again later.', issued: 'Issued', updated: 'updated', ours: 'Our AI', kma: 'KMA', obs: 'Observed', sky: 'Sky', temp: 'Temp', pop: 'Rain chance', rn: 'Rain', ws: 'Wind', hm: 'Humidity', am: 'AM', pm: 'PM', none: 'No past forecasts to score yet', total: '7-day total', run: 'Issued', f1: 'Rain F1', st: 'This station', wd: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'], h: ':00' };
    const src = root.dataset.src!;
    let site: Site;
    try { site = await (await fetch(`${src}latest.json`)).json(); } catch { $('[data-wx-meta]').textContent = T.fail; return; }

    const NS = 'http://www.w3.org/2000/svg';
    const el = (tag: string, attrs: Record<string, string | number>, parent?: Element, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
      if (text != null) e.textContent = text;
      parent?.appendChild(e);
      return e;
    };
    const fmt = (v: number | null | undefined, d = 1) => (v == null || !isFinite(v) ? '–' : v.toFixed(d));
    const day = (iso: string) => iso.slice(0, 10);
    const hour = (iso: string) => Number(iso.slice(11, 13));
    const md = (iso: string) => `${Number(iso.slice(5, 7))}/${Number(iso.slice(8, 10))}`;
    const dow = (iso: string) => T.wd[new Date(`${day(iso)}T12:00:00Z`).getUTCDay()];
    const when = (iso: string) => `${md(iso)}(${dow(iso)}) ${hour(iso)}${T.h}`;
    const name = (stn: number | string) => { const s = site.stations.find((x) => String(x.stn) === String(stn)); return s ? (ko ? s.name : s.nameEn) : String(stn); };
    const fc = site.forecast, cut = site.cut * 100, N = fc.times.length;
    const units: Record<string, string> = { ta: '°', pop: '%', ws: '', hm: '%' };
    const digits: Record<string, number> = { ta: 1, pop: 0, ws: 1, hm: 0 };

    // Sky icon: ours from the rain chance and Aurora cloud cover, the KMA from its sky and precipitation codes.
    const night = (iso: string) => hour(iso) < 6 || hour(iso) >= 19;
    const sky = (who: 'ours' | 'kma', s: Stn, i: number) => {
      let k: string | null;
      if (who === 'ours') {
        const c = s.ours.cc?.[i];
        k = (s.ours.pop[i] ?? 0) >= cut ? 'rain' : c == null ? null : c < 30 ? 'sun' : c < 70 ? 'part' : 'cloud';
      } else {
        const p = s.kma.pty?.[i], q = s.kma.sky?.[i];
        k = p != null && p > 0 ? 'rain' : q === 1 ? 'sun' : q === 3 ? 'part' : q === 4 ? 'cloud' : null;
      }
      if (k && night(fc.times[i] ?? '')) k = k === 'sun' ? 'moon' : k === 'part' ? 'partn' : k;
      return k;
    };
    const icon = (k: string | null, cls = 'wx-i') => (k ? `<svg class="${cls}" aria-hidden="true"><use href="#wx-${k}"/></svg>` : '<span class="wx-i"></span>');
    const value = (s: Stn | undefined, who: 'ours' | 'kma', v: string, i: number) => s?.[who]?.[v]?.[i] ?? null;

    let ti = 0, vKey = 'ta', curStn = fc.stations['108'] ? '108' : Object.keys(fc.stations)[0];
    // Start at the forecast hour closest to now (Korean time).
    const nowKst = new Date(Date.now() + 9 * 3600e3).toISOString().slice(0, 13);
    const near = fc.times.findIndex((t) => t.slice(0, 13) >= nowKst);
    ti = near < 0 ? N - 1 : near;
    $('[data-wx-meta]').textContent = `${T.issued} ${fc.base.replace('T', ' ')} KST · ${T.updated} ${site.updated.replace('T', ' ')}`;

    // ---- Station card for the selected hour
    function nowCard() {
      const s = fc.stations[curStn];
      $('[data-wx-time]').textContent = when(fc.times[ti]);
      const col = (who: 'ours' | 'kma') => {
        const rain = who === 'ours' ? `${T.pop} ${fmt(value(s, who, 'pop', ti), 0)}%` : `${T.pop} ${fmt(value(s, who, 'pop', ti), 0)}% · ${T.rn} ${fmt(value(s, who, 'rn', ti))}mm`;
        return `<div class="wx-now-col is-${who}"><p class="wx-who">${who === 'ours' ? T.ours : T.kma}</p><div class="wx-now-main">${icon(sky(who, s, ti), 'wx-i wx-i-big')}<span class="wx-big">${fmt(value(s, who, 'ta', ti))}°</span></div><p>${rain}</p><p>${T.ws} ${fmt(value(s, who, 'ws', ti))}m/s · ${T.hm} ${fmt(value(s, who, 'hm', ti), 0)}%</p></div>`;
      };
      const o = value(s, 'obs' as 'ours', 'ta', ti);
      $('[data-wx-now-cols]').innerHTML = col('ours') + col('kma') + (o != null ? `<p class="wx-now-obs">${T.obs} ${fmt(o)}°</p>` : '');
    }

    // ---- Tile map (Web Mercator, 256 px tiles): drag to pan, wheel / pinch / buttons to zoom.
    const box = $<HTMLElement>('[data-wx-map]');
    const tiles = box.querySelector<HTMLElement>('.wx-tiles')!, pins = box.querySelector<HTMLElement>('.wx-pins')!;
    const TS = 256, ZMIN = 6, ZMAX = 11;
    const proj = (lat: number, lon: number, z: number) => {
      const s = Math.sin(lat * Math.PI / 180), w = TS * 2 ** z;
      return [(lon + 180) / 360 * w, (.5 - Math.log((1 + s) / (1 - s)) / (4 * Math.PI)) * w];
    };
    let z = root.querySelector<HTMLElement>('.wx-main')!.clientWidth < 600 ? 6 : 7;
    let [cx, cy] = proj(35.9, 127.8, z);
    const imgs = new Map<string, HTMLImageElement>();
    // Station tiers: shown as labelled bubbles from this zoom up, as small dots below it.
    const tier: Record<number, number> = { 108: 6, 105: 6, 133: 6, 156: 6, 143: 6, 159: 6, 184: 6, 101: 7, 146: 7, 136: 7, 138: 7, 168: 7, 102: 7, 115: 7, 165: 8, 112: 8 };
    const pinEls = site.stations.map((s) => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'wx-pin'; b.dataset.stn = String(s.stn);
      b.addEventListener('click', (e) => { if (!moved) select(String(s.stn)); e.stopPropagation(); });
      pins.appendChild(b);
      return { s, b };
    });
    function clamp() {
      const [x0, y0] = proj(39.6, 123.3, z), [x1, y1] = proj(32.6, 132.2, z);
      cx = Math.min(Math.max(cx, x0), x1); cy = Math.min(Math.max(cy, y0), y1);
    }
    function drawMap() {
      clamp();
      const w = box.clientWidth, h = box.clientHeight, ox = cx - w / 2, oy = cy - h / 2, n = 2 ** z;
      const keep = new Set<string>();
      for (let tx = Math.floor(ox / TS); tx <= Math.floor((ox + w) / TS); tx++) for (let ty = Math.floor(oy / TS); ty <= Math.floor((oy + h) / TS); ty++) {
        if (ty < 0 || ty >= n) continue;
        const key = `${z}/${tx}/${ty}`;
        keep.add(key);
        let img = imgs.get(key);
        if (!img) {
          img = new Image(); img.alt = ''; img.draggable = false;
          img.src = `https://tile.openstreetmap.org/${z}/${((tx % n) + n) % n}/${ty}.png`;
          imgs.set(key, img); tiles.appendChild(img);
        }
        img.style.transform = `translate(${tx * TS - ox}px,${ty * TS - oy}px)`;
      }
      for (const [key, img] of imgs) if (!keep.has(key)) { img.remove(); imgs.delete(key); }
      for (const { s, b } of pinEls) {
        const [x, y] = proj(s.lat, s.lon, z);
        const big = z >= (tier[s.stn] ?? 9) || String(s.stn) === curStn;
        b.classList.toggle('is-dot', !big);
        b.classList.toggle('is-on', String(s.stn) === curStn);
        b.style.transform = `translate(${(x - ox).toFixed(1)}px,${(y - oy).toFixed(1)}px)`;
        b.style.zIndex = String(String(s.stn) === curStn ? 3 : big ? 2 : 1);
      }
    }
    function pinText() {
      for (const { s, b } of pinEls) {
        const st = fc.stations[String(s.stn)], o = value(st, 'ours', vKey, ti), k = value(st, 'kma', vKey, ti);
        b.innerHTML = `<span class="n">${name(s.stn)}</span><span class="o">${fmt(o, digits[vKey])}${units[vKey]}</span><span class="k">${fmt(k, digits[vKey])}${units[vKey]}</span>`;
        b.title = `${name(s.stn)} · ${T.ours} ${fmt(o, digits[vKey])} · ${T.kma} ${fmt(k, digits[vKey])}`;
        b.style.setProperty('--c', color(o));
      }
    }
    const color = (v: number | null) => {
      if (v == null) return 'transparent';
      const t = { ta: (v + 5) / 40, pop: v / 100, ws: v / 10, hm: v / 100 }[vKey]!;
      const c = Math.min(1, Math.max(0, t));
      return vKey === 'ta' ? `hsl(${235 - 235 * c} 72% 52%)` : vKey === 'pop' ? `hsl(212 80% ${88 - 50 * c}%)` : vKey === 'ws' ? `hsl(168 55% ${82 - 50 * c}%)` : `hsl(200 60% ${86 - 48 * c}%)`;
    };
    const zoomAt = (dz: number, px = box.clientWidth / 2, py = box.clientHeight / 2) => {
      const nz = Math.min(ZMAX, Math.max(ZMIN, z + dz));
      if (nz === z) return;
      const f = 2 ** (nz - z), w = box.clientWidth, h = box.clientHeight;
      const wx = cx - w / 2 + px, wy = cy - h / 2 + py;
      cx = wx * f - px + w / 2; cy = wy * f - py + h / 2; z = nz;
      drawMap();
    };
    let wheelAt = 0;
    box.addEventListener('wheel', (e) => {
      e.preventDefault();
      if (Date.now() - wheelAt < 250) return;
      wheelAt = Date.now();
      const r = box.getBoundingClientRect();
      zoomAt(e.deltaY < 0 ? 1 : -1, e.clientX - r.left, e.clientY - r.top);
    }, { passive: false });
    box.querySelectorAll<HTMLButtonElement>('[data-z]').forEach((b) => b.addEventListener('click', () => zoomAt(Number(b.dataset.z))));
    // Pointers: one drags; two pinch (the layers scale with CSS, then snap to the nearest whole zoom).
    const pts = new Map<number, [number, number]>();
    let moved = false, pinch0 = 0, scale = 1, mid: [number, number] = [0, 0];
    const layers = [tiles, pins];
    box.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('.wx-zoom, .wx-attrib')) return;
      pts.set(e.pointerId, [e.clientX, e.clientY]); moved = false;
      if (pts.size === 2) { const [a, b] = [...pts.values()]; pinch0 = Math.hypot(a[0] - b[0], a[1] - b[1]); const r = box.getBoundingClientRect(); mid = [(a[0] + b[0]) / 2 - r.left, (a[1] + b[1]) / 2 - r.top]; }
    });
    box.addEventListener('pointermove', (e) => {
      const p = pts.get(e.pointerId);
      if (!p) return;
      if (pts.size === 1) {
        const dx = e.clientX - p[0], dy = e.clientY - p[1];
        if (!moved && Math.hypot(dx, dy) < 4) return;
        if (!moved) box.setPointerCapture(e.pointerId);
        moved = true; cx -= dx; cy -= dy; pts.set(e.pointerId, [e.clientX, e.clientY]); drawMap();
      } else if (pts.size === 2) {
        pts.set(e.pointerId, [e.clientX, e.clientY]);
        const [a, b] = [...pts.values()];
        scale = Math.hypot(a[0] - b[0], a[1] - b[1]) / pinch0; moved = true;
        for (const l of layers) { l.style.transformOrigin = `${mid[0]}px ${mid[1]}px`; l.style.transform = `scale(${scale})`; }
      }
    });
    const up = (e: PointerEvent) => {
      if (!pts.delete(e.pointerId)) return;
      if (scale !== 1 && pts.size < 2) {
        for (const l of layers) l.style.transform = '';
        zoomAt(Math.round(Math.log2(scale)), mid[0], mid[1]);
        scale = 1; pts.clear();
      }
    };
    box.addEventListener('pointerup', up); box.addEventListener('pointercancel', up);
    addEventListener('resize', drawMap);

    // ---- Time slider with day marks
    const slider = $<HTMLInputElement>('[data-wx-slider]');
    slider.max = String(N - 1); slider.value = String(ti);
    $('[data-wx-slider-days]').innerHTML = fc.times.map((t, i) => (i === 0 || hour(t) === 0 ? `<span style="left:${(100 * i / (N - 1)).toFixed(2)}%">${md(t)}(${dow(t)})</span>` : '')).join('');
    slider.addEventListener('input', () => setTime(Number(slider.value)));
    const varBox = $('[data-wx-vars]');
    varBox.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!b?.dataset.var) return;
      vKey = b.dataset.var;
      varBox.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      pinText();
    });

    // ---- Daily strip: morning / afternoon sky, low / high, highest rain chance
    function daily() {
      const s = fc.stations[curStn];
      const days = [...new Set(fc.times.map(day))].filter((d) => fc.times.filter((t) => day(t) === d).length >= 12);
      const part = (who: 'ours' | 'kma', d: string, pm: boolean) => {
        const idx = fc.times.map((t, i) => (day(t) === d && (hour(t) >= 12) === pm ? i : -1)).filter((i) => i >= 0);
        if (!idx.length) return icon(null);
        const ks = idx.map((i) => sky(who, s, i)).filter(Boolean) as string[];
        const pick = ks.includes('rain') ? 'rain' : ks.sort((a, b) => ks.filter((x) => x === b).length - ks.filter((x) => x === a).length)[0] ?? null;
        return icon(pick ? pick.replace('moon', 'sun').replace('partn', 'part') : null);
      };
      const stat = (who: 'ours' | 'kma', d: string) => {
        const idx = fc.times.map((t, i) => (day(t) === d ? i : -1)).filter((i) => i >= 0);
        const ta = idx.map((i) => value(s, who, 'ta', i)).filter((v): v is number => v != null);
        const pop = idx.map((i) => value(s, who, 'pop', i)).filter((v): v is number => v != null);
        return `<span class="lo">${ta.length ? fmt(Math.min(...ta)) : '–'}°</span><span class="hi">${ta.length ? fmt(Math.max(...ta)) : '–'}°</span><span class="pp">${pop.length ? Math.max(...pop).toFixed(0) : '–'}%</span>`;
      };
      $('[data-wx-daily]').innerHTML = days.map((d) => `<div class="wx-day"><p class="wx-day-h">${md(d)} (${dow(d)})</p>`
        + `<div class="wx-day-row"><span class="wx-who o">${T.ours}</span>${part('ours', d, false)}${part('ours', d, true)}${stat('ours', d)}</div>`
        + `<div class="wx-day-row"><span class="wx-who k">${T.kma}</span>${part('kma', d, false)}${part('kma', d, true)}${stat('kma', d)}</div></div>`).join('');
      $('[data-wx-daily]').insertAdjacentHTML('afterbegin', `<p class="wx-day-key"><span>${T.am}</span><span>${T.pm}</span><span>${ko ? '최저' : 'Low'}</span><span>${ko ? '최고' : 'High'}</span><span>${ko ? '비' : 'Rain'}</span></p>`);
    }

    // ---- Hourly table: one column per hour, temperature curve across the columns
    const CW = 46;
    function hours() {
      const s = fc.stations[curStn];
      const cells = (f: (i: number) => string, cls = '') => fc.times.map((_, i) => `<td class="${i === ti ? 'is-on ' : ''}${cls}" data-i="${i}">${f(i)}</td>`).join('');
      const head = fc.times.map((t, i) => `<th class="${i === ti ? 'is-on' : ''}${hour(t) === 0 ? ' is-day' : ''}" data-i="${i}">${i === 0 || hour(t) === 0 ? `<b>${md(t)}</b>` : ''}${hour(t)}${T.h}</th>`).join('');
      const row = (label: string, body: string, cls = '') => `<tr class="${cls}"><th scope="row">${label}</th>${body}</tr>`;
      const num = (who: 'ours' | 'kma' | 'obs', v: string, d: number) => cells((i) => fmt(value(s, who as 'ours', v, i), d));
      const hasObs = s.obs.ta.some((v) => v != null);
      $('[data-wx-hours]').innerHTML = `<thead><tr><th></th>${head}</tr></thead><tbody>`
        + row(`${T.sky} <i class="o">${T.ours}</i>`, cells((i) => icon(sky('ours', s, i))))
        + row(`${T.sky} <i class="k">${T.kma}</i>`, cells((i) => icon(sky('kma', s, i))))
        + row(T.temp, `<td colspan="${N}" class="wx-curve-cell"><svg class="wx-curve" width="${N * CW}" height="120" data-wx-curve></svg></td>`)
        + (hasObs ? row(`${T.obs} ${T.temp}`, num('obs', 'ta', 1), 'is-obs') : '')
        + row(`${T.pop} <i class="o">${T.ours}</i>`, num('ours', 'pop', 0), 'is-o')
        + row(`${T.pop} <i class="k">${T.kma}</i>`, num('kma', 'pop', 0), 'is-k')
        + row(`${T.rn} <i class="k">${T.kma}</i>`, cells((i) => { const r = value(s, 'kma', 'rn', i); return r ? fmt(r) : '–'; }), 'is-k')
        + row(`${T.ws} <i class="o">${T.ours}</i>`, num('ours', 'ws', 1), 'is-o')
        + row(`${T.ws} <i class="k">${T.kma}</i>`, num('kma', 'ws', 1), 'is-k')
        + row(`${T.hm} <i class="o">${T.ours}</i>`, num('ours', 'hm', 0), 'is-o')
        + row(`${T.hm} <i class="k">${T.kma}</i>`, num('kma', 'hm', 0), 'is-k') + '</tbody>';
      const svg = $('[data-wx-curve]');
      const all = [s.ours.ta, s.kma.ta, s.obs.ta].flat().filter((v): v is number => v != null);
      const lo = Math.min(...all) - 1, hi = Math.max(...all) + 1, y = (v: number) => 16 + 88 * (hi - v) / (hi - lo);
      const path = (vals: (number | null)[], cls: string) => {
        let d = '';
        vals.forEach((v, i) => { if (v != null) d += `${d && vals[i - 1] != null ? 'L' : 'M'}${i * CW + CW / 2} ${y(v).toFixed(1)}`; });
        if (d) el('path', { d, class: cls }, svg);
      };
      path(s.kma.ta, 'wx-line-kma'); path(s.ours.ta, 'wx-line-ours');
      s.obs.ta.forEach((v, i) => { if (v != null) el('circle', { cx: i * CW + CW / 2, cy: y(v), r: 2.5, class: 'wx-obs' }, svg); });
      s.ours.ta.forEach((v, i) => { if (v != null) el('text', { x: i * CW + CW / 2, y: y(v) - 7, class: 'wx-curve-o' }, svg, fmt(v)); });
      s.kma.ta.forEach((v, i) => { if (v != null) el('text', { x: i * CW + CW / 2, y: y(v) + 15, class: 'wx-curve-k' }, svg, fmt(v)); });
    }
    $('[data-wx-hours]').addEventListener('click', (e) => {
      const c = (e.target as HTMLElement).closest<HTMLElement>('[data-i]');
      if (c) setTime(Number(c.dataset.i));
    });

    function setTime(i: number) {
      ti = i; slider.value = String(i);
      nowCard(); pinText();
      root.querySelectorAll('.wx-hours [data-i]').forEach((c) => c.classList.toggle('is-on', Number((c as HTMLElement).dataset.i) === i));
    }
    function select(stn: string) {
      curStn = stn;
      stnSelect.value = stn;
      nowCard(); drawMap(); daily(); hours(); weekTable(); replay();
      const col = root.querySelector<HTMLElement>(`.wx-hours th[data-i="${ti}"]`);
      const wrap = $<HTMLElement>('[data-wx-hours-wrap]');
      if (col) wrap.scrollLeft = Math.max(0, col.offsetLeft - wrap.clientWidth / 3);
    }
    const stnSelect = $<HTMLSelectElement>('[data-wx-select]');
    [...site.stations].sort((a, b) => name(a.stn).localeCompare(name(b.stn), ko ? 'ko' : 'en')).forEach((s) => stnSelect.add(new Option(name(s.stn), String(s.stn))));
    stnSelect.addEventListener('change', () => select(stnSelect.value));

    // ---- Last 7 days: one row per issuance plus the total and the selected station; the better side is bold.
    function weekTable() {
      const tbl = $('[data-wx-week]');
      const wk = site.week;
      if (!wk) { tbl.innerHTML = `<caption>${T.none}</caption>`; return; }
      const cells = (o: Score, k: Score) => [['ta', 2, 1], ['hm', 1, 1], ['ws', 2, 1], ['f1', 2, -1]].map(([key, d, dir]) => {
        const a = o[key as string], b = k[key as string];
        const win = a != null && b != null && (dir as number) * ((a as number) - (b as number)) < 0;
        const lose = a != null && b != null && (dir as number) * ((a as number) - (b as number)) > 0;
        return `<td><span class="${win ? 'is-win' : ''}">${fmt(a, d as number)}</span><span class="${lose ? 'is-win k' : 'k'}">${fmt(b, d as number)}</span></td>`;
      }).join('');
      const row = (th: string, s: { ours: Score; kma: Score }, cls = '') => `<tr class="${cls}"><th>${th}</th>${cells(s.ours, s.kma)}</tr>`;
      const st = wk.stations[curStn];
      tbl.innerHTML = `<thead><tr><th>${T.run}</th><th>${T.temp} MAE</th><th>${T.hm} MAE</th><th>${T.ws} MAE</th><th>${T.f1}</th></tr><tr class="wx-sub"><th></th>${`<th><span>${T.ours}</span><span class="k">${T.kma}</span></th>`.repeat(4)}</tr></thead><tbody>`
        + wk.runs.map((r) => row(when(r.base), r)).join('')
        + row(T.total, wk.total, 'is-total') + (st ? row(`${T.st}: ${name(curStn)}`, st, 'is-station') : '') + '</tbody>';
    }

    // ---- Replay: a past issuance against what was observed
    function chart(svg: Element, run: Run, stn: string) {
      svg.replaceChildren();
      const s = run.stations[stn];
      if (!s) return;
      const W = 640, L = 34, R = 8, top = 12, h = 150, rt = 182, rh = 50, n = run.times.length;
      const x = (i: number) => L + (W - L - R) * (i + .5) / n;
      const temps = [s.ours.ta, s.kma.ta, s.obs.ta].flat().filter((v): v is number => v != null);
      if (!temps.length) return;
      const lo = Math.floor(Math.min(...temps) - 1), hi = Math.ceil(Math.max(...temps) + 1);
      const y = (v: number) => top + h * (hi - v) / (hi - lo);
      for (const v of [lo, Math.round((lo + hi) / 2), hi]) {
        el('line', { x1: L, x2: W - R, y1: y(v), y2: y(v), class: 'wx-grid' }, svg);
        el('text', { x: L - 6, y: y(v) + 4, class: 'wx-axis', 'text-anchor': 'end' }, svg, `${v}°`);
      }
      run.times.forEach((t, i) => {
        if (hour(t) === 0) {
          el('line', { x1: x(i) - (W - L - R) / n / 2, x2: x(i) - (W - L - R) / n / 2, y1: top, y2: rt + rh, class: 'wx-midnight' }, svg);
          el('text', { x: x(i) + 2, y: rt + rh + 14, class: 'wx-axis' }, svg, md(t));
        }
      });
      const line = (vals: (number | null)[], cls: string) => {
        let d = '';
        vals.forEach((v, i) => { if (v != null) d += `${d && vals[i - 1] != null ? 'L' : 'M'}${x(i).toFixed(1)} ${y(v).toFixed(1)}`; });
        if (d) el('path', { d, class: cls }, svg);
      };
      line(s.kma.ta, 'wx-line-kma'); line(s.ours.ta, 'wx-line-ours');
      s.obs.ta.forEach((v, i) => { if (v != null) el('circle', { cx: x(i), cy: y(v), r: 2.4, class: 'wx-obs' }, svg); });
      const bw = (W - L - R) / n / 2 - .5;
      el('text', { x: L - 6, y: rt + rh / 2 + 4, class: 'wx-axis', 'text-anchor': 'end' }, svg, ko ? '비' : 'rain');
      s.ours.pop.forEach((p, i) => { if (p) el('rect', { x: x(i) - bw, y: rt + rh * (1 - p / 100), width: bw, height: rh * p / 100, class: p >= cut ? 'wx-bar-ours is-rain' : 'wx-bar-ours' }, svg); });
      s.kma.rn.forEach((r, i) => { if (r != null && r >= 1) el('rect', { x: x(i), y: rt + rh * .35, width: bw, height: rh * .65, class: 'wx-bar-kma' }, svg); });
      s.obs.rn.forEach((r, i) => { if (r != null && r >= 1) el('rect', { x: x(i) - bw, y: rt + rh + 2, width: bw * 2, height: 4, class: 'wx-bar-obs' }, svg); });
    }
    const runSelect = $<HTMLSelectElement>('[data-wx-run]');
    const cache: Record<string, Run> = {};
    async function replay() {
      if (!site.week?.runs.length) return;
      const base = runSelect.value || site.week.runs[site.week.runs.length - 1].base;
      const key = base.replace(/[-T:]/g, '').slice(0, 10);
      try { cache[key] ??= await (await fetch(`${src}verify/${key}.json`)).json(); } catch { return; }
      $<HTMLElement>('[data-wx-replay]').hidden = false;
      $('[data-wx-replay-meta]').textContent = `${name(curStn)} · ${T.issued} ${base.replace('T', ' ')}`;
      chart($('[data-wx-replay-chart]'), cache[key], curStn);
    }
    site.week?.runs.slice().reverse().forEach((r) => runSelect.add(new Option(when(r.base), r.base)));
    runSelect.addEventListener('change', replay);

    for (const s of ['[data-wx-now]', '[data-wx-mapbox]', '[data-wx-daily]', '[data-wx-hours-wrap]']) $<HTMLElement>(s).hidden = false;
    pinText(); select(curStn); setTime(ti);
  }
</script>

