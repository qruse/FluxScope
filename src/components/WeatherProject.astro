  .wx-tiles, .wx-pins { position: absolute; inset: 0; }
  .wx-tiles img { position: absolute; left: 0; top: 0; width: 256px; height: 256px; max-width: none; pointer-events: none; }
  [data-theme='dark'] .wx-tiles { filter: invert(1) hue-rotate(180deg) brightness(.85) contrast(.9); }
  .wx-pin { position: absolute; left: 0; top: 0; display: grid; grid-template-columns: auto auto; gap: 0 .3rem; margin: 0; padding: .2rem .45rem .25rem; translate: -50% calc(-100% - 7px); border: 1px solid rgba(0, 0, 0, .18); border-top: 4px solid var(--c); border-radius: 6px; background: var(--surface); color: var(--ink); font: inherit; font-size: .74rem; line-height: 1.25; white-space: nowrap; box-shadow: 0 2px 6px rgba(0, 0, 0, .22); cursor: pointer; }
  .wx-pin::after { content: ''; position: absolute; left: 50%; bottom: -6px; width: 8px; height: 8px; translate: -50% 0; rotate: 45deg; background: var(--surface); border-right: 1px solid rgba(0, 0, 0, .18); border-bottom: 1px solid rgba(0, 0, 0, .18); }
  .wx-pin .n { grid-column: 1 / -1; font-weight: 800; text-align: center; }
  .wx-pin .o { color: var(--accent); font-weight: 850; font-variant-numeric: tabular-nums; }
  .wx-pin .k { color: var(--pen); font-weight: 750; font-variant-numeric: tabular-nums; }
  .wx-pin.is-on { outline: 2.5px solid var(--ink); }
  .wx-pin.is-dot { width: 12px; height: 12px; padding: 0; translate: -50% -50%; border: 1.5px solid var(--surface); border-radius: 50%; background: var(--c); font-size: 0; box-shadow: 0 1px 3px rgba(0, 0, 0, .4); }
  .wx-pin.is-dot::after { display: none; }
  .wx-zoom { position: absolute; right: .6rem; top: .6rem; display: grid; z-index: 5; }
