  .wx-now-col .wx-who { margin: 0; color: var(--accent); font-weight: 850; font-size: .8rem; letter-spacing: .06em; }
  .wx-now-col.is-kma .wx-who { color: var(--pen); }
  .wx-now-main { display: flex; align-items: center; gap: .6rem; }
  .wx-big { font-size: 2.6rem; font-weight: 800; letter-spacing: -.04em; font-variant-numeric: tabular-nums; }
  .wx-now-obs { grid-column: 1 / -1; margin: 0; color: var(--ink); font-size: .84rem; font-weight: 750; }
  .wx-mapbox { padding: .8rem; }
  .wx-map-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: .6rem; }
  .wx-seg { display: inline-flex; flex-wrap: wrap; gap: .3rem; }
  .wx-seg button { padding: .4rem .8rem; border: 1px solid var(--line); border-radius: 999px; background: var(--bg); color: var(--ink); font: inherit; font-size: .82rem; font-weight: 700; cursor: pointer; }
  .wx-seg button[aria-pressed='true'] { border-color: var(--ink); background: var(--ink); color: var(--bg); }
