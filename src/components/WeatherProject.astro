  .wx-now-time { color: var(--muted); font-weight: 750; font-size: .9rem; }
  .wx-now-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: .8rem; }
  .wx-now-col { padding: .7rem .9rem; border-left: 3px solid var(--accent); }
