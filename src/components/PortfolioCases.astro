---
// Portfolio case studies: the three main client projects, each as the shipped service, then the three problems
// it had to solve and how. Compiled from the owner's project deck; names of people and employers stay off the page.
// Service screens are redrawn here as light HTML/SVG mock-ups; the report chart is a crop of a real weekly report.
// All styles are inline below so the site-wide CSS bundle stays in budget.
import BaseLayout from '../layouts/BaseLayout.astro';
import LabMark from './LabMark.astro';
import { labSectionPath, labSections } from '../lib/site';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const isKo = lang === 'ko';
const L = (ko: string, en: string) => (isKo ? ko : en);
const portfolioHref = labSectionPath(labSections.find((s) => s.id === 'portfolio')!, lang);

type Bar = { n: string; v: number; t: string; hi?: boolean };
type Visual =
  | { kind: 'timeline' }
  | { kind: 'ema' }
  | { kind: 'bars'; items: { label: string; max: number; rows: Bar[]; note?: string }[] }
  | { kind: 'flow'; inputs: string[]; steps: string[] }
  | { kind: 'squares' }
  | { kind: 'docs' };
type Step = { tag: string; head: string; problem: { t: string; d: string[] }; solution: { t: string; d: [string, string][] }; take: string; visual: Visual };
type Case = {
  id: string; field: string; meta: string; title: string; lede: string; stack: string[];
  metrics: { v: string; k: string; d?: string }[]; features: { t: string; d: string }[]; quote: string; steps: Step[];
};

const cases: Case[] = [
  {
    id: 'leak',
    field: L('이상 탐지 · 상수도', 'Anomaly detection · water supply'),
    meta: L('상수도사업본부 · AI 스타트업 재직 시', 'Municipal waterworks · at the AI startup'),
    title: L('유량 데이터로 누수 찾기', 'Finding leaks in flow data'),
    lede: L('상수도 관망의 유량 데이터로 누수 의심 구역을 실시간으로 알려 주는 탐지 모델과 대시보드. 누수 시작 시점조차 기록되지 않은 현장 데이터를 학습 가능한 형태로 다시 정의하는 것부터 시작함.', 'A detection model and dashboard that flags suspected leak blocks from water-network flow data in real time. It started by redefining field records, which never logged when a leak began, into something a model could learn from.'),
    stack: ['Python', 'XGBoost', 'EMA', 'Feature engineering', 'REST API'],
    metrics: [
      { v: '90%', k: 'Accuracy', d: '+19%p' },
      { v: '0.63', k: 'F1 score', d: '+0.32' },
      { v: '20+', k: L('파생 변수', 'engineered features') },
    ],
    features: [
      { t: L('EMA 기준선 시각화', 'EMA baseline on the chart'), d: L('유량 그래프에 동적 기준선을 함께 그려 현장 담당자가 이상 여부를 바로 판단', 'A moving baseline drawn over the flow so field staff can judge anomalies at a glance') },
      { t: L('AI 탐지 알림 목록', 'AI alert list'), d: L('누수 의심 구간을 실시간 알림으로 제공해 수동 감시 업무를 자동화', 'Suspected leak blocks arrive as live alerts, replacing manual watching') },
      { t: L('REST API 연동', 'REST API'), d: L('분석 결과를 API로 제공해 기존 통합관제시스템과 연동', 'Results served over an API and wired into the existing control system') },
    ],
    quote: L('예측 결과를 담당자가 바로 쓸 수 있는 서비스 형태로 납품', 'Delivered as a service the operators could use the same day, not as a report'),
    steps: [
      {
        tag: L('누수 데이터 정의', 'Defining a leak'),
        head: L('기준이 모호한 현장 기록을 학습 데이터로', 'Turning vague field records into training data'),
        problem: { t: L('누수 시점이 기록되지 않음', 'No record of when leaks began'), d: [
          L('"복구 완료" 기록만 있고 실제 누수 시작 시점은 없음', 'Only "repair finished" was logged, never the start of the leak'),
          L('복구일 기준으로 학습하면 누수가 진행 중인 패턴을 정상으로 잘못 배움', 'Labelling by repair date would teach the model that a leak in progress is normal'),
        ] },
        solution: { t: L('데이터 역추적 라벨링', 'Back-traced labels'), d: [
          [L('구간 재정의', 'Windows'), L('복구 1일 전은 비정상, 복구 1주일 뒤부터는 정상 구간으로 라벨링', 'The day before a repair is abnormal; a week after the repair onward is normal')],
          [L('운영 맥락 결합', 'Context'), L('계절·요일·수압 같은 운영 변수를 붙여 진짜 누수 패턴만 남김', 'Season, weekday and pressure joined in to keep only real leak patterns')],
        ] },
        take: L('데이터가 없는 문제를 분석으로 풀어, 불완전한 기록을 학습 가능한 데이터셋으로 재정의함', 'Missing data became an analysis problem: incomplete records redefined as a learnable dataset'),
        visual: { kind: 'timeline' },
      },
      {
        tag: L('누수 판단 기준', 'The alarm line'),
        head: L('경험으로 그은 직선을 데이터 기반 곡선으로', 'From a hand-drawn straight line to a data-driven curve'),
        problem: { t: L('고정된 직선 기준', 'A fixed straight threshold'), d: [
          L('야간 최소유량(MNF) 제한선을 과거 경험에 기대 직선으로 일괄 설정', 'The minimum-night-flow (MNF) limit was a straight line set from experience'),
          L('계절이나 물 사용량 변화를 반영하지 못해 정상 유량을 누수로 오인하는 일이 잦음', 'It ignored seasons and changing use, so normal flow was often flagged as a leak'),
        ] },
        solution: { t: L('EMA 동적 기준선', 'A moving EMA baseline'), d: [
          ['EMA', L('최근 데이터에 가중치를 더 주는 지수이동평균으로 움직이는 추세선 개발', 'An exponential moving average that weights recent data and follows the trend')],
          [L('계절성 반영', 'Seasonality'), L('직선 대신 데이터 흐름을 따르는 기준선으로 오탐을 크게 줄임', 'A baseline that follows the flow instead of a fixed line cut false alarms sharply')],
        ] },
        take: L('직관에 기대던 기준을 통계적 기준으로 바꿔 알림의 신뢰도를 높임', 'A rule of thumb replaced by a statistical baseline, so alarms could be trusted'),
        visual: { kind: 'ema' },
      },
      {
        tag: L('모델 고도화', 'Model upgrade'),
        head: L('비선형 상호작용까지 보는 분류 모델', 'A classifier that sees non-linear interactions'),
        problem: { t: L('단일 기준선의 한계', 'Limits of a single baseline'), d: [
          L('누수는 유량뿐 아니라 요일·계절·시간대·수압이 비선형으로 얽혀 나타남', 'Leaks show up through non-linear mixes of weekday, season, hour and pressure, not flow alone'),
          L('단일 변수 기준선으로는 미세 누수나 패턴 변화를 잡기 어려움', 'A one-variable threshold misses small leaks and shifting patterns'),
        ] },
        solution: { t: L('AI 분류 모델 도입', 'A machine-learning classifier'), d: [
          ['Feature engineering', L('시간·요일·계절, 이동평균 차이, 수압 변동성 등 20개 이상 파생 변수', '20+ features: hour, weekday, season, moving-average gaps, pressure volatility')],
          ['XGBoost', L('앙상블 모델로 비선형 패턴 분류 성능을 끌어올림', 'A boosted-tree ensemble for non-linear patterns')],
          [L('임계값 최적화', 'Threshold tuning'), L('Precision-Recall 균형을 보고 임계값을 조정해 오탐 최소화', 'Cut-off tuned on the precision-recall trade-off to keep false alarms down')],
        ] },
        take: L('정확도 71% → 90%, F1 0.31 → 0.63', 'Accuracy 71% → 90%, F1 0.31 → 0.63'),
        visual: { kind: 'bars', items: [
          { label: 'Accuracy', max: 100, rows: [{ n: L('기존', 'Before'), v: 71, t: '71%' }, { n: L('개선', 'After'), v: 90, t: '90%', hi: true }] },
          { label: 'F1 score', max: 1, rows: [{ n: L('기존', 'Before'), v: 0.31, t: '0.31' }, { n: L('개선', 'After'), v: 0.63, t: '0.63', hi: true }] },
        ] },
      },
    ],
  },
  {
    id: 'greenhouse',
    field: L('시계열 예측 · 스마트팜', 'Forecasting · smart farming'),
    meta: L('2025 · 스마트팜 기업', '2025 · smart-farm company'),
