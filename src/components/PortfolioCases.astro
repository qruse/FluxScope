        ] },
        solution: { t: L('전문성 확장', 'Extending the expert'), d: [
          [L('컨설팅 로직 이식', 'Logic as a workflow'), L('현업 컨설턴트의 진단 프로세스를 LangGraph 에이전트 워크플로로 구현', 'A working consultant’s diagnosis process rebuilt as a LangGraph agent workflow')],
          [L('상시 컨설팅', 'Always on'), L('시간과 장소 제약 없이 누구나 받을 수 있는 컨설팅', 'Advice for every farm, any time, anywhere')],
        ] },
        take: L('AI는 전문가를 대체하지 않고 노하우를 더 멀리 전달하는 도구', 'AI carries the expert’s know-how further instead of replacing them'),
        visual: { kind: 'flow', inputs: [L('환경·생육 데이터', 'Climate and growth data'), L('컨설턴트 진단 로직', 'Consultant’s diagnosis')], steps: [L('LangGraph 에이전트', 'LangGraph agents'), L('주간 리포트', 'Weekly report')] },
      },
      {
        tag: L('리포트 유연성', 'Flexible reports'),
        head: L('고정 양식 대신 상황에 맞춰 다시 짜는 리포트', 'Reports that re-plan themselves instead of filling a template'),
        problem: { t: L('경직된 템플릿', 'A rigid template'), d: [
          L('모든 농가에 같은 템플릿을 써서 특이사항이나 돌발 변수를 담지 못함', 'Every farm got the same template, with no room for exceptions or surprises'),
          L('수치만 나열할 뿐 현상이 왜 생겼는지 맥락 설명이 부족', 'Numbers were listed without explaining why things happened'),
        ] },
        solution: { t: L('LLM Agent 동적 생성', 'Dynamic generation with agents'), d: [
          [L('동적 목차', 'Dynamic outline'), L('농가 상황과 데이터에 따라 목차와 내용을 실시간으로 재구성', 'The outline and content are rebuilt for each farm’s data and situation')],
          [L('복합 구성', 'Mixed media'), L('설명에 맞는 그래프와 표를 에이전트가 스스로 판단해 배치', 'The agent decides which chart or table explains each point and places it')],
        ] },
        take: L('정성적인 기준과 요구사항까지 반영할 수 있는 리포팅 방식', 'A way of reporting that can follow qualitative criteria and requests'),
        visual: { kind: 'docs' },
      },
    ],
  },
];

const metricLine = (c: Case) => c.metrics.slice(0, 2).map((m) => `${m.k} ${m.v}`).join(' · ');

