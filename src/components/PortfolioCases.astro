<script is:inline>
  // Cases and steps rise in as they scroll into view, and the case bar marks the case being read.
  (() => {
    if (!('IntersectionObserver' in window)) return;
    const root = document.documentElement;
    const links = new Map([...document.querySelectorAll('.cs-nav a')].map((a) => [a.hash.slice(1), a]));
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.add('cs-motion');
      const reveal = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); reveal.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('.cs-head, .cs-service, .cs-step, .cs-sample, .cs-rcard').forEach((el) => reveal.observe(el));
    }
    const spy = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach((a) => a.removeAttribute('aria-current'));
      links.get(e.target.id)?.setAttribute('aria-current', 'true');
    }), { rootMargin: '-35% 0px -60% 0px' });
    document.querySelectorAll('.cs-case').forEach((s) => spy.observe(s));
  })();
</script>

