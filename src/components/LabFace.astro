---
// A tetrahedron seen from above: three faces around the apex. The entry's own face is filled, matching the
// face that the home backdrop turns forward while the entry is on screen.
interface Props { face: number; }
const { face } = Astro.props;
const top = '0,-9', right = '7.8,4.5', left = '-7.8,4.5';
const faces = [`${top} 0,0 ${left}`, `${top} ${right} 0,0`, `${left} 0,0 ${right}`];
---
<svg class="lab-face" viewBox="-10 -10 20 20" aria-hidden="true">
  {faces.map((points, i) => <polygon points={points} class={i === face ? 'is-on' : undefined} />)}
</svg>
