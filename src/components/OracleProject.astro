.or-q h2 { margin: .5rem 0 .5rem; font-size: clamp(1.35rem, 3vw, 2rem); font-weight: 820; line-height: 1.25; letter-spacing: -.035em; word-break: keep-all; }
.or-verdict { margin: 0 0 .6rem; color: var(--muted); font-size: .9rem; line-height: 1.6; word-break: keep-all; }
