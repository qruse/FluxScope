.or-sec { padding-top: 3rem; }
.or-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .4rem 1.4rem; margin-bottom: 1rem; padding-bottom: .7rem; border-bottom: 2px solid var(--ink); }
.or-head h2 { margin: 0; font-size: 1.4rem; font-weight: 820; letter-spacing: -.03em; word-break: keep-all; }
.or-sub { margin: 0; color: var(--muted); font-size: .84rem; word-break: keep-all; font-variant-numeric: tabular-nums; }
.or-chev { display: inline-block; flex: none; width: .5rem; height: .5rem; border-right: 2px solid var(--muted); border-bottom: 2px solid var(--muted); transform: translateY(-2px) rotate(45deg); transition: transform .15s; }
[aria-expanded="true"] > .or-chev, details[open] > summary > .or-chev { transform: translateY(2px) rotate(-135deg); }
.or-board { margin: 0; padding: 0; list-style: none; }
.or-board li { display: grid; grid-template-columns: minmax(9rem, 1fr) minmax(6rem, 2fr) 5rem; grid-template-areas: "who bar big" "who ci big"; gap: .1rem 1rem; align-items: center; padding: .8rem 0; border-bottom: 1px solid var(--line); }
.or-who { grid-area: who; }
.or-who strong { display: block; font-weight: 800; border-left: 4px solid var(--c); padding-left: .6rem; }
.or-who small { display: block; padding-left: .85rem; color: var(--muted); font-size: .72rem; }
.or-big { grid-area: big; text-align: right; font-size: 1.7rem; font-weight: 850; letter-spacing: -.04em; font-variant-numeric: tabular-nums; }
.or-bar { grid-area: bar; position: relative; height: 1.1rem; }
.or-bar i { position: absolute; display: block; }
