---
// HSLab AI Oracle Arena project page (renamed from Oracle Benchmark 2026-11-07; the URL keeps ai-oracle-benchmark). The hslab_oracle repository uploads latest.json, ledger.json and one round-NNNN.json
// to /api/oracle/ every day at 05:00 KST; the page draws the score, the core question and the open round from them.
// The stock arena's detail lives on /projects/ai-duel/, and the page links there instead of repeating it.
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects, projectPath } from '../lib/site';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const isKo = lang === 'ko';
const L = (ko: string, en: string) => (isKo ? ko : en);
const project = projects.find((p) => p.id === 'ai-oracle-benchmark')!;
const steps = [
  [L('문제 점수', 'Question score'), L('확률과 실제 결과의 차이(Brier)를 기준 모델과 비교함. 믿는 확률을 그대로 쓸 때 기대 점수가 가장 높은 채점 방식임.', 'The gap between stated chance and what happened (Brier), compared with the baseline. Stating your true belief has the best expected score.')],
  [L('난이도', 'Difficulty'), L('기준 모델이 결과를 알기 어려워하는 문제일수록 가중치가 큼(0.5~1.5배). 답안을 받기 전에 정해지므로 예측이나 결과에 따라 달라지지 않음.', 'The more open a question looks to the baseline, the more it counts (0.5 to 1.5 times). This is fixed before any forecast, so it cannot depend on a forecast or a result.')],
  [L('표본', 'Sample size'), L('문제가 적은 라운드는 적게 반영함. 처음엔 모두 기준 모델 점수(0)에서 시작하고, 기록이 쌓일수록 자기 값에 가까워짐. 운 좋은 한 주로는 크게 오르지 않음.', 'Rounds with few questions count less. Everyone starts at the baseline (0) and moves toward their own value as the record grows, so one lucky week moves little.')],
  [L('통합', 'One score'), L('분야마다 단위가 달라서, 각 분야의 라운드별 변동 폭을 단위로 환산한 뒤 세 분야를 같은 비중으로 평균 냄. +25는 평균적으로 변동 폭의 4분의 1만큼 기준 모델을 앞선다는 뜻임.', 'Arenas have different units, so each is expressed in its own round-to-round noise, then the three are averaged with equal weight. +25 means a quarter of that noise above the baseline on average.')],
];
const rules = [
  [L('주기', 'Rhythm'), L('매주 토요일 05:00 KST에 예측, 09:00에 잠금. 매일 05:00에 결과 확인과 재채점', 'Forecasts on Saturdays at 05:00 KST, locked at 09:00. Results checked and rescored daily at 05:00')],
  [L('잠금', 'Lock'), L('잠금 뒤에 온 답안은 받지 않음. 답안과 결과는 해시 체인 기록에 순서대로 남음', 'Nothing is accepted after the lock. Forecasts and results go into a hash-chained record in order')],
  [L('미제출', 'Missed'), L('모든 선택지 같은 확률로 채점하고 제출률을 공개함', 'Scored as an equal chance for every option, with coverage shown')],
  [L('무효', 'Void'), L('예정일부터 7일 안에 열리지 않은 경기는 모두에게 무효', 'A match not played within 7 days of its date is void for everyone')],
  [L('경쟁', 'Competition'), L('AI마다 분야별 전략 문서를 매주 스스로 고침. 상대 점수만 보이고 전략과 열린 예측은 안 보임', 'Each AI rewrites its own strategy per arena every week. It sees rivals’ scores, not their strategies or open forecasts')],
  [L('기준 모델', 'Baselines'), L('주식 SPY, 프리미어리그 시장 배당(2라운드부터, 배당이 없으면 Elo), 다른 리그 Elo, 여론조사 과거 주간 등락 비율', 'Stock SPY, Premier League market price (from round 2, Elo where none is out), other leagues Elo, polls the share of past weekly ups and downs')],
  [L('사람 투표', 'Human votes'), L('경기 시작 전까지 경기마다 한 표이고 바꿀 수 있음. AI보다 늦게까지 받고 AI 답안도 볼 수 있어서 Oracle Score에는 넣지 않고 따로 비교함', 'One pick per match until kickoff, changeable. People vote later than the AIs and can see their forecasts, so votes are compared separately and are not in the Oracle Score')],
  [L('데이터', 'Data'), L('한국갤럽 데일리 오피니언, 위키백과 미국 전국 여론조사 목록, Fantasy Premier League, football-data.co.uk(결과·배당), TheSportsDB, MLB Stats API, gol.gg(LoL). LoL은 날짜만 있어서 그날 0시(UTC)에 투표 마감', 'Gallup Korea Daily Opinion, Wikipedia’s list of US national polls, Fantasy Premier League, football-data.co.uk (results and prices), TheSportsDB, MLB Stats API, gol.gg (LoL). LoL pages give dates only, so votes close at 00:00 UTC that day')],
];
const limits = [
  L('한 주 앞을 내다보는 예측이라 경기 직전 소식은 어떤 AI도 볼 수 없음', 'Forecasts look up to a week ahead, so no AI sees late team news'),
  L('네 AI의 웹 검색 도구가 달라서, 점수는 모델 혼자가 아니라 도구를 포함한 모델의 점수임', 'The four AIs have different web search tools, so a score belongs to the model with its tools'),
  L('여론조사는 표본 오차 때문에 실제 여론이 그대로여도 1~2%p씩 흔들림. 정치 분야는 그 흔들림과 진짜 변화를 구분하는 능력을 재는 것이고, 정당이나 인물에 대한 평가가 아님', 'Polls move a point or two from sampling error even when opinion holds still. The politics arena tests telling that noise from real change; it is not a judgement of any party or person'),
  L('재난(지진·태풍·토네이도)은 1라운드 시작 전에 뺐음. 공개 자료만으로는 AI가 과거 빈도나 공식 예보를 거의 그대로 따라 해서, 별도 예측 모델이나 시뮬레이션이 있어야 공정한 시험이 됨', 'Disaster (earthquakes, typhoons, tornadoes) was taken out before round 1 started. With public data alone the AIs mostly repeat history or official outlooks, so a fair test needs its own forecasting model or simulation'),
  L('소비자용 CLI로 돌려서 숨은 시스템 설정이 모델마다 다를 수 있음', 'Models run through consumer CLIs, so hidden system settings can differ'),
];
---
<BaseLayout lang={lang} title={project.name} description={isKo ? project.summaryKo : project.summary}>
  <header class="or-hero">
    <div class="shell">
      <div class="section-kicker">{L('프로젝트', 'Project')}</div>
      <h1>{project.name}</h1>
      <p class="or-lede">{L('네 AI가 매주 주식, 경기 결과, 여론조사를 예측하고, 현실이 채점함.', 'Four AIs forecast stocks, matches and polls every week. Reality keeps score.')}</p>
    </div>
  </header>

  <div class="shell or-body" data-or data-lang={lang} data-duel={projectPath('ai-duel', lang)}>
    <section class="or-status" data-or-status></section>

    <section class="or-sec" data-or-score-sec hidden>
      <div class="or-head"><h2>Oracle Score</h2><p class="or-sub" data-or-score-note></p></div>
      <div data-or-board></div>
    </section>

    <section class="or-sec" data-or-arena-sec hidden>
      <div class="or-head"><h2>{L('세 분야', 'Three arenas')}</h2><p class="or-sub">{L('0이 기준 모델, 괄호는 95% 구간', '0 is the baseline; brackets are the 95% interval')}</p></div>
      <div class="or-arenas" data-or-arenas></div>
    </section>

    <section class="or-sec or-round">
      <div class="or-head"><h2 data-or-round-title>{L('이번 라운드', 'This round')}</h2><p class="or-sub" data-or-round-meta></p></div>
      <p class="or-base"><b>{L('기준 모델 = 0점', 'Baseline = 0 points')}</b>{L('AI 없이 낸 확률. 프리미어리그는 2라운드부터 베팅 시장 평균 배당, 나머지 리그는 과거 전적 Elo, 여론조사는 과거 주간 등락 비율, 주식은 SPY. AI는 이걸 이겨야 점수가 오름', 'Chances made without AI: from round 2 the betting market’s average price for the Premier League, Elo from past results for other leagues, the share of past weekly ups and downs for polls, SPY for stock. An AI scores only by beating it')}</p>
      <div class="or-tabs" role="tablist" data-or-tabs></div>
      <p class="or-hint" data-or-hint></p>
      <div data-or-questions></div>
    </section>

    <section class="or-sec" data-or-split-sec hidden>
      <div class="or-head"><h2>{L('네 AI가 가장 갈린 문제', 'Where the four AIs disagree most')}</h2></div>
      <div data-or-split></div>
    </section>

    <div data-ad></div>

    <section class="or-q" aria-label={L('핵심 질문', 'The core question')}>
      <p class="or-q-label">{L('핵심 질문', 'The core question')}</p>
      <h2>{L('더 지능적인 AI가 실제 미래도 더 정확하게 예측하는가?', 'Does a more intelligent AI also predict the real future more accurately?')}</h2>
      <p class="or-verdict" data-or-verdict>{L('불러오는 중…', 'Loading…')}</p>
      <div data-or-scatter></div>
    </section>

    <section class="or-sec" data-or-rounds-sec hidden>
      <div class="or-head"><h2>{L('라운드 기록', 'Round history')}</h2><p class="or-sub">{L('기준 모델 대비 점수, 주식은 SPY 대비 수익률', 'Points against the baseline; stock is return against SPY')}</p></div>
      <div data-or-rounds></div>
    </section>

    <section class="or-sec">
      <div class="or-head"><h2>{L('AI가 직접 쓰는 전략과 회고', 'Strategy and reviews, written by the AIs')}</h2></div>
      <div class="or-tabs" role="tablist" data-or-doc-tabs></div>
      <div data-or-docs></div>
    </section>

    <details class="or-sec or-method">
      <summary class="or-head"><h2>{L('문제 구성·점수 계산·규칙', 'Questions, scoring and rules')}</h2><i class="or-chev"></i></summary>
      <div class="or-next-rows">
        <div><b>{L('스포츠', 'Sports')}</b><span>{L('프리미어리그', 'Premier League')}</span><span>{L('메이저리그', 'MLB')}</span><span>{L('한국프로야구', 'KBO')}</span><span>{L('e스포츠 (LoL)', 'Esports (LoL)')}</span></div>
        <div><b>{L('정치', 'Politics')}</b><span>{L('대통령 직무 긍정률', 'Korean presidential approval')}</span><span>{L('민주당·국민의힘 지지도', 'Korean party support')}</span><span>{L('트럼프 지지율', 'Trump approval')}</span><span>{L('미국 정당 지지', 'US generic ballot')}</span></div>
        <div><b>{L('주식', 'Stock')}</b><span>{L('AI 주식 대결 수익률', 'AI stock duel returns')}</span></div>
      </div>
      <p class="or-small">{L('메이저리그·한국프로야구는 시즌 중에만 문제가 나옴(봄부터). e스포츠는 LCK·Worlds·MSI 경기. 정치는 2라운드부터: 한국은 매주 금요일 한국갤럽 발표, 미국은 그 주에 끝난 전국 조사 평균이 직전 2주보다 오를지·그대로일지·내릴지. 미국 정당 지지는 다음 하원 선거 조사가 나오기 시작하면 추가됨. 재난 분야는 11/7 1라운드 시작 전에 뺐음', 'MLB and KBO appear only in season, from spring. Esports covers LCK, Worlds and MSI. Politics from round 2: will Gallup Korea’s Friday numbers, and the mean of US national polls ending that week against the two weeks before, go up, stay or go down. US generic-ballot questions join once polls for the next House election start. The disaster arena was taken out on 11/7, before round 1 started')}</p>
      <h3>{L('점수 계산', 'Scoring')}</h3>
      <ol class="or-steps">{steps.map(([k, v]) => <li><b>{k}</b><span>{v}</span></li>)}</ol>
      <p class="or-small" data-or-check></p>
      <dl class="or-rules">{rules.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      <p class="or-small" data-or-humans></p>
      <p class="or-small" data-or-index></p>
      <h3>{L('한계', 'Limits')}</h3>
      <ul class="or-limits">{limits.map((x) => <li>{x}</li>)}</ul>
      <h3>{L('직접 검증', 'Check it yourself')}</h3>
      <p class="or-small" data-or-ledger></p>
    </details>

    <p class="or-disclaimer">{L('본 서비스는 AI 모델의 예측 성능을 비교하는 연구 및 교육 목적의 플랫폼입니다. 정치 분야는 여론조사 수치 예측이며 특정 정당이나 인물에 대한 평가나 지지가 아닙니다. 스포츠 예측은 베팅 권유가 아니고, 주식 분야는 모의투자이며 투자 권유가 아닙니다.', 'This service is a research and education platform comparing the forecasting performance of AI models. The politics arena forecasts poll numbers; it is not a judgement of, or support for, any party or person. Sports forecasts are not betting advice, and the stock arena is paper trading, not investment advice.')}</p>
    <section class="comments" id="comments" data-comments data-lang={lang} data-page={projectPath('ai-oracle-benchmark', lang)}
      data-intro={L('방법론 비판 환영', 'Criticism of the method is welcome')}></section>
  </div>
  <script is:inline src="/comments.js" defer></script>

<script is:inline>
(() => {
  const root = document.querySelector('[data-or]');
  if (!root) return;
  const ko = root.dataset.lang === 'ko';
  const T = ko
    ? { fail: '데이터를 불러오지 못했음. 잠시 뒤 다시 열어 주세요.', updated: '갱신', noRound: '아직 열린 라운드 없음', roundStart: (n) => `라운드 ${n} 시작까지`, roundEnd: (n) => `라운드 ${n} 끝까지`, scoring: '채점 중', done: '결과 나온 문제', firstScore: '첫 점수 예정', nextForecast: '다음 예측', provisional: '잠정 순위 · 표본 부족', final: '표본 기준 넘김', nolead: '확실한 1위 없음', lead: (a) => `${a} 1위 확실`, beat: '기준 모델을 이길 확률', baseline: '기준 모델', stock: '주식', sports: '스포츠', disaster: '재난', stockMore: '주식은 주식 대결 페이지', stockHint: '네 AI가 각자 2만 달러로 하는 미국 주식 모의투자. 큰 숫자는 시작 이후 수익률, 아래는 각자 시작일부터 SPY 대비.', vsSpy: 'SPY 대비', waitTrade: '첫 거래 대기', idle: (s) => `이번 라운드에 경기 없음: ${s}. 시즌이 끝났거나 대진이 아직 안 나옴`, arenaRounds: '끝난 라운드', noQ: '이 분야의 문제가 아직 없음.', easy: '쉬움', medium: '보통', hard: '어려움', void: '무효', missed: '미제출', home: '홈', draw: '무', away: '원정', yes: '예', no: '아니오', roundN: (n) => `라운드 ${n}`, none: '아직 없음', strategy: '운용 전략', journal: '최근 회고', hyp: '이번 주 가설', seeAi: 'AI별 예측과 이유', x: '지능 지수', y: 'Oracle Score', noIndex: '지수 없음', verdictWait: '아직 모름.', verdictN: (n, p) => `모델 ${n}개로는 순서가 완벽히 맞아도 통계 결론을 못 냄(최소 p값 ${p.toFixed(2)}). 모델을 더 늘려야 함.`, verdictData: '결과가 더 쌓여야 함.', verdictRho: (r, p) => `지금까지 순위 상관 ${r.toFixed(2)}, 양의 상관일 확률 ${Math.round(p * 100)}%.`, idx: (s, d) => `지능 지수: ${s} (${d} 확인). 우리가 잰 값이 아니라 외부 지표이고, 추론 강도와 상관없이 모델마다 가장 높은 공개 점수를 씀. 여기서는 예산 때문에 더 낮은 강도로 돌림.`, check: (u, r) => `같은 순서인지 확인: 난이도 가중치 없이 ${u}, 라운드별 평균 순위로 ${r}. 다르면 순위를 믿으면 안 됨.`, ledgerText: (n, h, v) => `기록 ${n}건, 최신 해시 ${h}, 체인 ${v ? '정상' : '오류'}. 문제·답안·결과는 공개 파일로 내려받아 다시 계산할 수 있음: `, cover: '제출률', sportsHint: '숫자와 막대는 네 AI의 평균 확률. 팀을 누르면 내 예측 투표. 시간은 KST.', byAi: 'AI별', chance: '확률', pts: '점수', politics: '정치', up: '오름', same: '그대로', down: '내림', politicsHint: '숫자와 막대는 네 AI의 평균 확률. 한국은 금요일 한국갤럽 발표, 미국은 그 주에 끝난 전국 조사 평균으로 채점.', disasterHint: '확률 0~100%. 눈금은 기준 모델, 숫자는 AI 평균.', votes: (n) => `사람 ${n}표`, voteFail: '투표하지 못했음. 잠시 뒤 다시 시도해 주세요.', voteClosed: '투표가 끝났음.', humansNone: (m) => `사람 투표: 경기마다 ${m}표 이상 모이면 AI와 나란히 채점함. 점수에는 들어가지 않음.`, humans: (n, v, p, best) => `사람 투표(점수 미포함): ${n}경기 ${v}표, 기준 모델 대비 ${p}. 같은 경기에서 AI는 ${best}.` }
    : { fail: 'Could not load the data. Please try again later.', updated: 'Updated', noRound: 'No open round yet', roundStart: (n) => `until round ${n} starts`, roundEnd: (n) => `until round ${n} ends`, scoring: 'Scoring', done: 'questions settled', firstScore: 'first scores expected', nextForecast: 'next forecast', provisional: 'Provisional · small sample', final: 'Past the sample threshold', nolead: 'No clear leader', lead: (a) => `${a} clearly first`, beat: 'Chance of beating the baseline', baseline: 'Baseline', stock: 'Stock', sports: 'Sports', disaster: 'Disaster', stockMore: 'Stock has its own page', stockHint: 'Each AI paper-trades US stocks with $20,000. The big number is the return since its start; below, against SPY from its own start.', vsSpy: 'vs SPY', waitTrade: 'Awaiting first trade', idle: (s) => `No games this round: ${s}. Out of season, or the matchups are not out yet`, arenaRounds: 'Rounds finished', noQ: 'No questions in this arena yet.', easy: 'Easy', medium: 'Medium', hard: 'Hard', void: 'Void', missed: 'Missed', home: 'Home', draw: 'Draw', away: 'Away', yes: 'Yes', no: 'No', roundN: (n) => `Round ${n}`, none: 'None yet', strategy: 'Strategy · machine-translated from Korean', journal: 'Latest review · machine-translated from Korean', hyp: 'This week’s hypotheses (in Korean)', seeAi: 'Each AI’s forecast and reasons', x: 'Intelligence index', y: 'Oracle Score', noIndex: 'No index score', verdictWait: 'Not known yet.', verdictN: (n, p) => `With ${n} models, even a perfect order cannot support a conclusion (smallest possible p value ${p.toFixed(2)}). More models are needed.`, verdictData: 'More results are needed.', verdictRho: (r, p) => `So far the rank correlation is ${r.toFixed(2)}, with a ${Math.round(p * 100)}% chance that it is positive.`, idx: (s, d) => `Intelligence index: ${s}, read ${d}. It is an outside measure, not ours: each model's best published score at any effort. The models run at lower effort here because of the budget.`, check: (u, r) => `Same order? Without difficulty weights: ${u}. By mean rank per round: ${r}. If these differ, the order should not be trusted.`, ledgerText: (n, h, v) => `${n} records, latest hash ${h}, chain ${v ? 'valid' : 'BROKEN'}. Questions, forecasts and results can be downloaded and recomputed: `, cover: 'Coverage', sportsHint: 'Numbers and bar are the four AIs’ average chance. Tap a side to cast your pick. Times are KST.', byAi: 'By AI', chance: 'Chance', pts: 'Points', politics: 'Politics', up: 'Up', same: 'Same', down: 'Down', politicsHint: 'Numbers and bar are the four AIs’ average chance. Korea is settled by Gallup Korea’s Friday release, the US by the mean of national polls ending that week.', disasterHint: 'Chance from 0 to 100%. The tick is the baseline, the number is the AI average.', votes: (n) => `${n} human votes`, voteFail: 'The vote did not go through. Please try again.', voteClosed: 'Voting has closed.', humansNone: (m) => `Human votes: a match is scored beside the AIs once it has ${m} votes. They are not part of the score.`, humans: (n, v, p, best) => `Human votes (not in the score): ${n} matches, ${v} votes, ${p} against the baseline. On the same matches the AIs got ${best}.` };
  const COL = { fable: '#0f8b8d', opus: 'var(--pen)', sol: 'var(--accent)', argon: '#7b4fc9', baseline: '#8d989e' };
  const $ = (q) => root.querySelector(q);
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const num = (v, d = 1) => (v == null ? '–' : `${v > 0 ? '+' : ''}${Number(v).toFixed(d)}`);
  const tx = (o) => (o ? esc((ko ? o.ko : o.en) || o.ko || o.en || '') : '');
  // AI-written Markdown links become real ones, after escaping, http(s) only. The attribute name is split because the site's link checker reads the page's text.
  const links = (h) => h.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, (_, t, u) => `<a ${'hr' + 'ef'}="${u}" rel="nofollow ugc noopener" target="_blank">${t}</a>`);
  const rich = (o) => links(tx(o)).replace(/\*\*(.+?)\*\*/g, '<b>$1</b>');
  const kst = (iso) => { const t = new Date(Date.parse(iso) + 9 * 3600e3), z = (n) => String(n).padStart(2, '0'); return `${t.getUTCMonth() + 1}/${t.getUTCDate()} ${z(t.getUTCHours())}:${z(t.getUTCMinutes())}`; };
  const mdOf = (ms) => { const t = new Date(ms + 9 * 3600e3); return `${t.getUTCMonth() + 1}/${t.getUTCDate()}`; };
  const dayOf = (ms) => Math.floor((ms + 9 * 3600e3) / 864e5);
  const SHORT = { fable: 'Fable', opus: 'Opus', sol: 'Sol', argon: 'Argon' };
  const nameOf = (d, id) => (id === 'baseline' ? T.baseline : d.table.find((r) => r.id === id)?.name || id);

  fetch('/api/oracle/latest.json', { cache: 'no-store' }).then((r) => (r.ok ? r.json() : Promise.reject(r.status))).then(draw).catch(() => { $('[data-or-verdict]').textContent = T.fail; });

  function draw(d) {
    const started = Object.values(d.arena_rounds).some((n) => n > 0);
    status(d, started);
    verdict(d, started);
    if (started) scatter(d); else indexStrip(d);
    $('[data-or-score-sec]').hidden = !started;
    $('[data-or-arena-sec]').hidden = !started;
    if (started) { board(d); arenas(d); }
    split(d);
    questions(d);
    rounds(d);
    docs(d);
    method(d, started);
    humans(d);
  }

  // Where the round stands: time left, questions settled, when the next number appears, and one cell per day of the round.
  function status(d, started) {
    const c = d.current, meta = `${T.updated} ${String(d.updated).replace('T', ' ').slice(0, 16)} · v${d.method_version}`;
    if (!c) { $('[data-or-status]').innerHTML = `<p class="or-sub">${T.noRound} · ${esc(meta)}</p>`; return; }
    const now = Date.now(), s = Date.parse(c.start), e = Date.parse(c.end);
    const dd = (t) => { const n = dayOf(t) - dayOf(now); return n > 0 ? `D-${n}` : 'D-day'; };
    const main = now < s ? [dd(s), T.roundStart(c.round)] : now < e ? [dd(e), T.roundEnd(c.round)] : [T.scoring, T.roundN(c.round)];
    const settled = c.questions.filter((q) => q.status !== 'open').length;
    const next = started ? [mdOf(e), T.nextForecast] : [mdOf(e + 20 * 3600e3), T.firstScore];
    const tile = ([n, l]) => `<div><b>${esc(n)}</b><span>${esc(l)}</span></div>`;
    const days = Math.max(1, Math.round((e - s) / 864e5));
    const cells = Array.from({ length: days }, (_, i) => { const a = s + i * 864e5; return `<i class="${now >= a + 864e5 ? 'is-past' : now >= a ? 'is-now' : ''}"></i>`; }).join('');
    $('[data-or-status]').innerHTML = `<div class="or-tiles">${tile(main)}${tile([`${settled}/${c.questions.length}`, T.done])}${tile(next)}</div>
      <div class="or-days" aria-hidden="true">${cells}</div><div class="or-days-l"><span>${mdOf(s)}</span><span>${esc(meta)}</span><span>${mdOf(e)}</span></div>`;
  }

  function humans(d) {
    const h = d.humans || {};
    const vs = Object.entries(h.vs || {}).map(([id, v]) => `${SHORT[id]} ${num(v, 3)}`).join(', ');
    $('[data-or-humans]').textContent = h.questions ? T.humans(h.questions, h.votes, num(h.mean_points, 3), vs) : T.humansNone(h.min_votes || 5);
  }

  // Visitors' picks. The tally starts from the server and the visitor's own pick is remembered in this browser only.
  const store = { get(k) { try { return localStorage.getItem(k); } catch { return null; } }, set(k, v) { try { localStorage.setItem(k, v); } catch {} } };
  let tally = {};
  const pickKey = (round, id) => `oracle-pick-${round}-${id}`;
  const optName = (q, o) => (o === 'home' ? q.home || T.home : o === 'away' ? q.away || T.away : T[o] || o);
  const aiMean = (q, ids, o) => { const got = ids.map((id) => q.forecasts?.[id]).filter(Boolean); return got.length ? got.reduce((t, p) => t + p[o], 0) / got.length : null; };
  // One cell per outcome, as wide as the AIs' average chance. A cell is also the vote button while the match is open.
  function voteBox(q, round, ids) {
    const open = q.status === 'open' && Date.now() < Date.parse(q.start);
    const counts = tally[q.id] || q.crowd?.counts || {};
    const total = q.options.reduce((t, o) => t + (counts[o] || 0), 0);
    const mine = store.get(pickKey(round, q.id));
    const ps = Object.fromEntries(q.options.map((o) => [o, aiMean(q, ids, o) ?? 1 / q.options.length]));
    const top = q.options.reduce((a, o) => (ps[o] > ps[a] ? o : a), q.options[0]);
    // Fixed columns (home left, draw in the middle, away right) so names line up from match to match; the bar below carries the size.
    const cells = q.options.map((o) => {
      const hit = q.status === 'resolved' && q.outcome === o;
      return `<button type="button" data-choice="${esc(o)}" ${open ? '' : 'disabled'} aria-pressed="${mine === o}" class="is-${esc(o)}${hit ? ' is-hit' : ''}${o === top ? ' is-top' : ''}"><span>${hit ? '✓ ' : ''}${esc(optName(q, o))}</span><b>${Math.round(ps[o] * 100)}%</b></button>`;
    }).join('');
    const bar = q.options.map((o) => `<i class="is-${esc(o)}" style="width:${(ps[o] * 100).toFixed(1)}%"></i>`).join('');
    const crowd = total ? `${T.votes(total)}: ${q.options.map((o) => `${esc(optName(q, o))} ${Math.round(((counts[o] || 0) / total) * 100)}%`).join(' · ')}` : '';
    return `<div class="or-vote" data-q="${esc(q.id)}"><div class="or-opts n${q.options.length}">${cells}</div><div class="or-pbar" aria-hidden="true">${bar}</div><small>${crowd}</small></div>`;
  }
  function bindVotes(c, redraw) {
    root.querySelectorAll('.or-vote button:not([disabled])').forEach((b) => b.addEventListener('click', async () => {
      const id = b.closest('.or-vote').dataset.q;
      const choice = b.dataset.choice;
      const small = b.closest('.or-vote').querySelector('small');
      try {
        const r = await fetch('/api/oracle/vote', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ round: c.round, question: id, choice }) });
        const data = await r.json();
        if (r.status === 409) { small.textContent = T.voteClosed; return; }
        if (!r.ok) throw new Error(data.error);
        tally = data.tally || tally;
        store.set(pickKey(c.round, id), choice);
        redraw();
      } catch { small.textContent = T.voteFail; }
    }));
  }

  function verdict(d, started) {
    const q = d.question;
    let text = T.verdictWait;
    if (!q.can_conclude) text += ' ' + T.verdictN(q.n, q.best_possible_p);
    else if (!started) text += ' ' + T.verdictData;
    if (started && q.rho != null && q.p_positive != null) text += ' ' + T.verdictRho(q.rho, q.p_positive);
    $('[data-or-verdict]').textContent = text;
    $('[data-or-index]').innerHTML = T.idx('<a hr' + `ef="${esc(q.source.url)}" rel="noopener" target="_blank">${esc(q.source.name)}</a>`, esc(q.source.read));
  }

  // Before any score: only the index is known, so draw just that instead of empty intervals around zero.
  function indexStrip(d) {
    const rows = d.table.filter((r) => r.intelligence != null);
    const W = Math.max(320, Math.min(760, $('[data-or-scatter]').clientWidth || 760)), H = 96, L = 44, R = 44;
    const xs = rows.map((r) => r.intelligence), x0 = Math.min(...xs) - 2, x1 = Math.max(...xs) + 2;
    const x = (v) => L + ((v - x0) / (x1 - x0)) * (W - L - R);
    const dots = rows.map((r) => {
      const same = rows.filter((o) => o.intelligence === r.intelligence), off = (same.indexOf(r) - (same.length - 1) / 2) * 16, cx = x(r.intelligence) + off;
      const anchor = same.length > 1 ? (off < 0 ? 'end' : 'start') : 'middle';
      const tx0 = same.length > 1 ? cx + (off < 0 ? 4 : -4) : cx;
      return `<g><title>${esc(r.name)}: ${T.x} ${r.intelligence} (${esc(r.intelligence_effort)})</title><text x="${tx0}" y="26" text-anchor="${anchor}" class="lbl">${SHORT[r.id]}</text><circle cx="${cx}" cy="44" r="7" fill="${COL[r.id]}" stroke="var(--surface)" stroke-width="2"/></g>`;
    }).join('');
    const ticks = [...new Set(xs)].map((v) => `<text x="${x(v)}" y="70" text-anchor="middle">${v}</text>`).join('');
    $('[data-or-scatter]').innerHTML = `<div class="or-chart"><svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${T.x}"><line x1="${L - 20}" x2="${W - R + 20}" y1="44" y2="44" class="base"/>${dots}${ticks}<text x="${W / 2}" y="92" text-anchor="middle" class="ax">${T.x} →</text></svg></div>`;
  }

  // Oracle Score with its 95% interval against the outside intelligence index. A model without an index score sits apart.
  function scatter(d) {
    const W = Math.max(320, Math.min(760, $('[data-or-scatter]').clientWidth || 760)), H = 300;
    const P = W < 500 ? { l: 44, r: 62, t: 18, b: 44 } : { l: 58, r: 110, t: 18, b: 44 };
    const withIdx = d.table.filter((r) => r.intelligence != null), without = d.table.filter((r) => r.intelligence == null);
    const xs = withIdx.map((r) => r.intelligence);
    const x0 = Math.min(...xs) - 3, x1 = Math.max(...xs) + 3;
    const ys = d.table.flatMap((r) => r.ci).concat(0);
    let lo = Math.min(...ys), hi = Math.max(...ys);
    const pad = Math.max((hi - lo) * 0.1, 5); lo -= pad; hi += pad;
    const x = (v) => P.l + ((v - x0) / (x1 - x0)) * (W - P.l - P.r - (W < 500 ? 34 : 70));
    const y = (v) => P.t + (1 - (v - lo) / (hi - lo)) * (H - P.t - P.b);
    const noX = W - P.r - 16;
    // Models tied on the index straddle their tick, so neither reads as a higher score; the left one's label goes left.
    const offset = {};
    withIdx.forEach((r) => {
      const same = withIdx.filter((o) => o.intelligence === r.intelligence);
      offset[r.id] = (same.indexOf(r) - (same.length - 1) / 2) * 14;
    });
    const point = (r, cx) => `<g><title>${esc(r.name)}: ${num(r.score)} [${num(r.ci[0])}, ${num(r.ci[1])}]${r.intelligence != null ? `, ${T.x} ${r.intelligence} (${esc(r.intelligence_effort)})` : ''}</title>`
      + `<line x1="${cx}" x2="${cx}" y1="${y(r.ci[0])}" y2="${y(r.ci[1])}" stroke="${COL[r.id]}" stroke-width="2"/><circle cx="${cx}" cy="${y(r.score)}" r="6" fill="${COL[r.id]}" stroke="var(--surface)" stroke-width="2"/>`
      + `<text x="${offset[r.id] < 0 ? cx - 11 : cx + 11}" y="${y(r.score) + 4}"${offset[r.id] < 0 ? ' text-anchor="end"' : ''} class="lbl">${SHORT[r.id]}</text></g>`;
    const step = [5, 10, 20, 25, 50, 100, 200].find((s) => (hi - lo) / s <= 5) || 500;
    const ticks = [];
    for (let v = Math.ceil(lo / step) * step; v <= hi; v += step) if (v !== 0) ticks.push(`<text x="${P.l - 8}" y="${y(v) + 4}" text-anchor="end">${v}</text>`);
    const seen = [...new Set(xs)].map((v) => `<text x="${x(v)}" y="${H - 22}" text-anchor="middle">${v}</text>`).join('');
    $('[data-or-scatter]').innerHTML = `<div class="or-chart"><svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${T.x} / ${T.y}">
      ${ticks.join('')}<line x1="${P.l}" x2="${W - 8}" y1="${y(0)}" y2="${y(0)}" class="z"/><text x="${W - 8}" y="${y(0) - 6}" text-anchor="end">${T.baseline} 0</text>
      ${seen}<text x="${x((x0 + x1) / 2)}" y="${H - 4}" text-anchor="middle" class="ax">${T.x} →</text>${without.length ? `<text x="${noX}" y="${H - 22}" text-anchor="middle">${T.noIndex}</text>` : ''}
      <text transform="translate(14 ${y((lo + hi) / 2)}) rotate(-90)" text-anchor="middle" class="ax">${T.y}</text>
      ${withIdx.map((r) => point(r, x(r.intelligence) + offset[r.id])).join('')}${without.map((r, i) => point(r, noX - i * 34)).join('')}
    </svg></div>`;
  }

  function board(d) {
    const rows = [...d.table].sort((a, b) => b.score - a.score);
    const lo = Math.min(-10, ...rows.flatMap((r) => r.ci)), hi = Math.max(10, ...rows.flatMap((r) => r.ci));
    const at = (v) => ((v - lo) / (hi - lo)) * 100;
    const lead = rows.find((r) => rows.every((o) => o === r || (d.beats[r.id]?.[o.id] ?? 0) >= 0.95));
    $('[data-or-score-note]').textContent = `${d.provisional ? T.provisional : T.final} · ${lead ? T.lead(lead.name) : T.nolead}`;
    $('[data-or-board]').innerHTML = `<ol class="or-board">${rows.map((r) => `<li style="--c:${COL[r.id]}">
      <div class="or-who"><strong>${esc(r.name)}</strong><small>${esc(r.cli)} · ${esc(r.effort)}</small></div>
      <div class="or-big">${num(r.score)}</div>
      <div class="or-bar" title="95%: ${num(r.ci[0])} ~ ${num(r.ci[1])}"><i class="zero" style="left:${at(0)}%"></i><i class="ci" style="left:${at(r.ci[0])}%;width:${at(r.ci[1]) - at(r.ci[0])}%"></i><i class="dot" style="left:${at(r.score)}%"></i></div>
      <div class="or-ci">[${num(r.ci[0], 0)}, ${num(r.ci[1], 0)}] · ${T.beat} ${Math.round(r.p_beats_baseline * 100)}%${r.coverage != null && r.coverage < 1 ? ` · ${T.cover} ${Math.round(r.coverage * 100)}%` : ''}</div>
    </li>`).join('')}</ol>`;
  }

  function arenas(d) {
    const copy = { stock: '<a hr' + `ef="${esc(root.dataset.duel)}">${T.stockMore} →</a>` };
    $('[data-or-arenas]').innerHTML = ['stock', 'sports', 'politics'].map((a) => {
      const rows = [...d.table].sort((p, q) => q.arenas[a].score - p.arenas[a].score);
      return `<article><h3>${T[a]}</h3><p class="or-sub">${T.arenaRounds} ${d.arena_rounds[a] || 0}</p><ul>${rows.map((r) => `<li style="--c:${COL[r.id]}"><i></i><span>${SHORT[r.id]}</span><b>${d.arena_rounds[a] ? num(r.arenas[a].score) : '–'}</b><small>${d.arena_rounds[a] ? `[${num(r.arenas[a].ci[0], 0)}, ${num(r.arenas[a].ci[1], 0)}]` : ''}</small></li>`).join('')}</ul>${copy[a] ? `<p class="or-link">${copy[a]}</p>` : ''}</article>`;
    }).join('');
  }

  // A question's title without what the page already says around it: the league on a match, the round's dates on a weather question.
  const qTitle = (q) => {
    const t = tx(q.title);
    return q.arena === 'sports' ? t.replace(/^[^:]+:\s*/, '') : t.replace(/:\s*\d{2}\/\d{2}~\d{2}\/\d{2}\s*/, ': ').replace(/,\s*[A-Z][a-z]{2} \d{1,2} to [A-Z][a-z]{2} \d{1,2}$/, '');
  };
  // Each AI's chance as a dot on a 0-100% line, with the baseline as a tick.
  const plot = (q, o, ids) => `<span class="or-plot">${q.baseline?.[o] != null ? `<i class="or-plot-b" style="left:${q.baseline[o] * 100}%" title="${T.baseline} ${Math.round(q.baseline[o] * 100)}%"></i>` : ''}${ids.map((id) => (q.forecasts?.[id] ? `<i class="or-plot-d" style="left:${q.forecasts[id][o] * 100}%;--c:${COL[id]}" title="${SHORT[id]} ${Math.round(q.forecasts[id][o] * 100)}%"></i>` : '')).join('')}</span>`;
  const legend = (d) => `<p class="or-legend">${d.table.map((r) => `<span style="--c:${COL[r.id]}"><i></i>${SHORT[r.id]}</span>`).join('')}<span class="is-base"><i></i>${T.baseline}</span></p>`;

  // The three open questions with the widest gap between two AIs, on the outcome where the gap is widest.
  function split(d) {
    const ids = d.table.map((r) => r.id);
    const rows = (d.current?.questions || []).filter((q) => q.status === 'open').map((q) => {
      const best = q.options.map((o) => { const v = ids.filter((id) => q.forecasts?.[id]).map((id) => [q.forecasts[id][o], id]).sort((a, b) => a[0] - b[0]); return v.length > 1 ? { o, lo: v[0], hi: v[v.length - 1], gap: v[v.length - 1][0] - v[0][0] } : null; }).filter(Boolean).sort((a, b) => b.gap - a.gap)[0];
      return best && { q, ...best };
    }).filter((r) => r && r.gap >= 0.05).sort((a, b) => b.gap - a.gap).slice(0, 3);
    $('[data-or-split-sec]').hidden = !rows.length;
    if (!rows.length) return;
    $('[data-or-split]').innerHTML = legend(d) + rows.map((r) => `<div class="or-split"><div class="or-split-t"><strong>${qTitle(r.q)}</strong>${r.q.options.includes('yes') ? '' : `<small>${r.o === 'draw' ? T.draw : `${esc(optName(r.q, r.o))} ${ko ? '승' : 'win'}`}</small>`}</div>${plot(r.q, r.o, ids)}<div class="or-split-n"><span>${SHORT[r.lo[1]]} <b>${Math.round(r.lo[0] * 100)}%</b></span><span>${SHORT[r.hi[1]]} <b>${Math.round(r.hi[0] * 100)}%</b></span></div></div>`).join('');
  }

  function tabs(el, items, onPick) {
    el.hidden = items.length < 2;
    el.innerHTML = items.map(([id, label], i) => `<button type="button" role="tab" aria-selected="${i === 0}" data-id="${id}">${esc(label)}</button>`).join('');
    el.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => {
      el.querySelectorAll('button').forEach((x) => x.setAttribute('aria-selected', x === b));
      onPick(b.dataset.id);
    }));
    onPick(items[0][0]);
  }

  function questions(d) {
    const c = d.current;
    if (!c) { $('[data-or-questions]').innerHTML = `<p class="or-sub">${T.noRound}</p>`; return; }
    const ids = d.table.map((r) => r.id);
    const opened = new Set();
    $('[data-or-round-title]').textContent = T.roundN(c.round);
    $('[data-or-round-meta]').textContent = `${kst(c.start)} ~ ${kst(c.end)} KST`;
    fetch(`/api/oracle/votes?round=${c.round}`, { cache: 'no-store' }).then((r) => (r.ok ? r.json() : null)).then((v) => { if (v?.tally) { tally = v.tally; show(active); } }).catch(() => {});
    let active = 'sports';
    const panel = (q, arena) => {
      // One column per outcome, named once in the header, so each row is just numbers.
      const shown = q.options.includes('yes') ? ['yes'] : q.options;
      const scored = Object.keys(q.points || {}).length > 0;
      const head = `<thead><tr><th></th>${shown.map((o) => `<th class="or-num">${shown.length > 1 ? esc(optName(q, o)) : T.chance}</th>`).join('')}${scored ? `<th class="or-num">${T.pts}</th>` : ''}</tr></thead>`;
      const row = (id, name, p) => {
        const got = p ? shown.map((o) => `<td class="or-num">${Math.round(p[o] * 100)}%</td>`).join('') : `<td class="or-num" colspan="${shown.length}">${T.missed}</td>`;
        const pts = q.points?.[id];
        return `<tr><th style="--c:${COL[id]}"><i></i>${esc(name)}</th>${got}${scored ? `<td class="or-num or-pts ${pts > 0 ? 'is-up' : pts < 0 ? 'is-down' : ''}">${pts == null || id === 'baseline' ? '' : num(pts, 3)}</td>` : ''}</tr>`;
      };
      const why = ids.map((id) => { const f = c.forecasts?.[id]?.[arena]?.forecasts?.[q.id]; return f?.why && tx(f.why) ? `<li style="--c:${COL[id]}"><b>${SHORT[id]}</b> ${rich(f.why)}${tx(f.uncertainty) ? ` <small>${rich(f.uncertainty)}</small>` : ''}</li>` : ''; }).join('');
      return `<div class="or-panel" ${opened.has(q.id) ? '' : 'hidden'}><div class="or-table"><table>${head}<tbody>${ids.map((id) => row(id, SHORT[id], q.forecasts?.[id])).join('')}${row('baseline', T.baseline, q.baseline)}</tbody></table></div>${why ? `<ul class="or-why">${why}</ul>` : ''}<p class="or-small">${T[q.difficulty]} · ${tx(q.rule)}</p></div>`;
    };
    const chev = (q) => `aria-expanded="${opened.has(q.id)}" data-tog="${esc(q.id)}"`;
    // The stage in brackets at the end of a title ("(Worlds 2026 Main Event, Semifinals)") goes next to the time.
    const stageOf = (q) => tx(q.title).match(/\(([^()]+)\)\s*$/)?.[1] || '';
    const sportsItem = (q) => `<div class="or-item or-match"><div class="or-match-top"><small class="or-when">${kst(q.start)}${stageOf(q) ? ` · ${stageOf(q)}` : ''}</small>${q.status === 'void' ? `<em>${T.void}</em>` : ''}<button type="button" class="or-tog" ${chev(q)}>${esc(T.byAi)}<i class="or-chev"></i></button></div>${voteBox(q, c.round, ids)}${panel(q, 'sports')}</div>`;
    const pollItem = (q) => `<div class="or-item or-match"><div class="or-match-top"><strong class="or-qt">${qTitle(q)}</strong>${q.status === 'void' ? `<em>${T.void}</em>` : ''}<button type="button" class="or-tog" ${chev(q)}>${esc(T.byAi)}<i class="or-chev"></i></button></div>${voteBox(q, c.round, ids)}${q.detail ? `<small class="or-when">${esc(q.detail)}</small>` : ''}${panel(q, 'politics')}</div>`;
    const chanceItem = (q) => {
      const m = aiMean(q, ids, 'yes');
      const done = q.status === 'resolved' ? `<em class="is-done">✓ ${esc(optName(q, q.outcome))}</em>` : q.status === 'void' ? `<em>${T.void}</em>` : '';
      return `<div class="or-item"><button type="button" class="or-row" ${chev(q)}><span class="or-row-t">${qTitle(q)}${done}</span>${plot(q, 'yes', ids)}<b class="or-pct">${m == null ? '–' : `${Math.round(m * 100)}%`}</b><i class="or-chev"></i></button>${panel(q, 'disaster')}</div>`;
    };
    const show = (arena) => {
      active = arena;
      if (arena === 'stock') { $('[data-or-hint]').innerHTML = esc(T.stockHint); stockCards(); return; }
      const qs = c.questions.filter((q) => q.arena === arena);
      const groups = [...new Set(qs.map((q) => q.category))];
      $('[data-or-hint]').innerHTML = arena === 'sports' ? esc(T.sportsHint) : arena === 'politics' ? esc(T.politicsHint) : esc(T.disasterHint) + legend(d);
      const idle = arena === 'sports' ? ['epl', 'mlb', 'kbo', 'lol'].filter((k) => !groups.includes(k)).map((k) => tx(d.categories?.[k]) || k) : [];
      $('[data-or-questions]').innerHTML = (idle.length ? `<p class="or-idle">${T.idle(idle.join(' · '))}</p>` : '') + (!qs.length ? `<p class="or-sub">${T.noQ}</p>` : groups.map((cat) => `<h3 class="or-cat">${tx(d.categories?.[cat]) || esc(cat)}</h3><div class="or-qlist is-${arena}">${qs.filter((q) => q.category === cat).map(arena === 'sports' ? sportsItem : arena === 'politics' ? pollItem : chanceItem).join('')}</div>`).join(''));
      bindVotes(c, () => show(active));
    };
    $('[data-or-questions]').addEventListener('click', (e) => {
      const b = e.target.closest('[data-tog]');
      if (!b) return;
      const on = !opened.has(b.dataset.tog);
      if (on) opened.add(b.dataset.tog); else opened.delete(b.dataset.tog);
      b.setAttribute('aria-expanded', on);
      b.closest('.or-item').querySelector('.or-panel').hidden = !on;
    });
    const count = (a) => c.questions.filter((q) => q.arena === a).length;
    const items = [['sports', `${T.sports} ${count('sports')}`], ['politics', `${T.politics} ${count('politics')}`], ['disaster', `${T.disaster} ${count('disaster')}`]].filter(([a]) => count(a)).concat([['stock', T.stock]]);
    tabs($('[data-or-tabs]'), items, show);
  }

  // The stock arena is the AI portfolio duel: its cards are drawn from the duel's own public data.
  let duel = null;
  function stockCards() {
    const box = $('[data-or-questions]');
    const go = (s) => {
      if (!s?.agents) { box.innerHTML = `<p class="or-sub">${T.fail}</p>`; return; }
      const bh = s.bench?.history || [], last = bh[bh.length - 1];
      const pct = (v) => (v == null ? '–' : `${v > 0 ? '+' : ''}${(v * 100).toFixed(1)}%`);
      const cls = (v) => (v > 0 ? 'is-up' : v < 0 ? 'is-down' : '');
      const since = (sym, day) => { const b = bh.find((x) => x.date >= day)?.[sym]; return b && last ? last[sym] / b - 1 : null; };
      const DUEL_COL = { gpt: COL.sol, opus: COL.opus, fable: COL.fable, argon: COL.argon };
      const cards = s.agents.map((a) => {
        const h = a.history || [], nav = h.length ? h[h.length - 1].nav : a.capital_usd;
        const r = h.length ? nav / a.capital_usd - 1 : null, spy = a.start ? since('SPY', a.start) : null;
        const edge = r != null && spy != null ? r - spy : null;
        return { a, r, edge, nav };
      }).sort((x, y) => (y.edge ?? -9) - (x.edge ?? -9));
      const bench = ['SPY', 'QQQ'].map((sym) => { const v = bh.length ? last[sym] / bh[0][sym] - 1 : null; return `<span>${sym} <b class="${cls(v)}">${pct(v)}</b></span>`; }).join('');
      box.innerHTML = `<div class="or-stock">${cards.map(({ a, r, edge, nav }) => `<div class="or-scard" style="--c:${DUEL_COL[a.id] || COL.baseline}"><p class="or-scard-n"><i></i>${esc(a.name)}</p><p class="or-scard-r ${cls(r)}">${r == null ? `<small>${T.waitTrade}</small>` : pct(r)}</p><p class="or-scard-s">${T.vsSpy} <b class="${cls(edge)}">${edge == null ? '–' : `${edge > 0 ? '+' : ''}${(edge * 100).toFixed(1)}%p`}</b></p><p class="or-scard-s">$${Math.round(nav).toLocaleString('en-US')}</p></div>`).join('')}</div><p class="or-stock-b">${bench}${s.updated ? `<small>${T.updated} ${esc(String(s.updated).slice(0, 16).replace('T', ' '))}</small>` : ''}</p><p class="or-link"><a ${'hr' + 'ef'}="${esc(root.dataset.duel)}">${T.stockMore} →</a></p>`;
    };
    if (duel) return go(duel);
    box.innerHTML = '<p class="or-sub">…</p>';
    fetch('/api/duel/latest.json', { cache: 'no-store' }).then((r) => (r.ok ? r.json() : null)).then((s) => { duel = s; go(s); }).catch(() => go(null));
  }

  function rounds(d) {
    const any = d.rounds.some((r) => Object.values(r.arenas).some((a) => a.value));
    $('[data-or-rounds-sec]').hidden = !any;
    if (!any) return;
    const ids = d.table.map((r) => r.id);
    const cell = (a, id) => (a.value?.[id] == null ? '–' : (a.from ? `${num(a.value[id] * 100, 1)}%` : num(a.value[id], 3)));
    const body = [...d.rounds].reverse().slice(0, 6).flatMap((r) => ['stock', 'sports', 'politics'].filter((k) => r.arenas[k]?.value).map((k) => `<tr><td>${r.round}</td><td>${T[k]}${r.arenas[k].final ? '' : ' *'}</td>${ids.map((id) => `<td class="${r.arenas[k].value[id] > 0 ? 'is-up' : r.arenas[k].value[id] < 0 ? 'is-down' : ''}">${cell(r.arenas[k], id)}</td>`).join('')}</tr>`)).join('');
    $('[data-or-rounds]').innerHTML = `<div class="or-table or-scroll"><table><thead><tr><th>#</th><th></th>${ids.map((id) => `<th>${SHORT[id]}</th>`).join('')}</tr></thead><tbody>${body}</tbody></table></div>`;
  }

  function md(src) {
    const inline = (s) => links(esc(s)).replace(/\*\*(.+?)\*\*/g, '<b>$1</b>').replace(/`([^`]+)`/g, '<code>$1</code>');
    const out = []; let list = null;
    const end = () => { if (list) { out.push(`</${list}>`); list = null; } };
    for (const raw of String(src || '').split('\n')) {
      const h = raw.match(/^(#{1,4})\s+(.*)/), ul = raw.match(/^\s*[-*]\s+(.*)/), ol = raw.match(/^\s*\d+\.\s+(.*)/);
      if (h) { end(); out.push(`<h5>${inline(h[2])}</h5>`); }
      else if (ul || ol) { const t = ul ? 'ul' : 'ol'; if (list !== t) { end(); out.push(`<${t}>`); list = t; } out.push(`<li>${inline((ul || ol)[1])}</li>`); }
      else if (!raw.trim()) end();
      else { end(); out.push(`<p>${inline(raw)}</p>`); }
    }
    end();
    return out.join('');
  }

  function docs(d) {
    tabs($('[data-or-doc-tabs]'), [['sports', T.sports], ['politics', T.politics]], (arena) => {
      $('[data-or-docs]').innerHTML = d.table.map((r) => {
        const x = d.docs[r.id]?.[arena] || {};
        const box = (title, text) => `<h4>${title}</h4><div class="or-md">${text ? md(text) : `<p>${T.none}</p>`}</div>`;
        const hyp = x.hypotheses?.length ? `<h4>${T.hyp}</h4><ol class="or-hyp">${x.hypotheses.map((h) => `<li>${esc(h.text)}<small>${esc(h.check)}</small></li>`).join('')}</ol>` : '';
        const sum = x.summary && tx(x.summary);
        return `<details class="or-doc" style="--c:${COL[r.id]}"><summary><i></i><strong>${esc(r.name)}</strong><span class="or-teaser">${sum || ''}</span><i class="or-chev"></i></summary>${sum ? `<p class="or-sum">${sum}</p>` : ''}${hyp}${box(T.journal, (!ko && x.journal_en) || x.journal)}${box(T.strategy, (!ko && x.strategy_en) || x.strategy)}</details>`;
      }).join('');
    });
  }

  function method(d, started) {
    const order = (key) => [...d.table].sort((a, b) => key(b) - key(a)).map((r) => SHORT[r.id]).join(' > ');
    $('[data-or-check]').textContent = started ? T.check(order((r) => r.check.no_difficulty_weight), order((r) => r.check.mean_rank ?? 0)) : '';
    const h = d.ledger.head ? `${d.ledger.head.slice(0, 16)}…` : '–';
    const n = d.current?.round;
    const files = ['latest.json', 'ledger.json'].concat(n ? [`round-${String(n).padStart(4, '0')}.json`] : []);
    // Split so the static link checker does not read data files built at run time as page links.
    $('[data-or-ledger]').innerHTML = esc(T.ledgerText(d.ledger.entries, h, d.ledger.valid)) + files.map((f) => '<a hr' + `ef="${'/api/oracle/' + f}">${f}</a>`).join(' · ');
  }
})();
</script>

