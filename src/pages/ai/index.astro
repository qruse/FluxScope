---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { categoryPath, publishedPosts } from '../../lib/site';

const aiCategories = ['agi', 'physical-ai', 'other-ai'] as const;
const posts = publishedPosts(await getCollection('posts'), 'ko').filter((post) =>
  aiCategories.includes(post.data.category as any)
);
---
<BaseLayout lang="ko" title="AI (인공지능)" description="AGI, 피지컬 AI, 임베디드 및 멀티모달 인공지능 이야기를 모았습니다.">
  <header class="page-top">
    <div class="shell">
      <div class="section-kicker">대분류 탐색 / AI</div>
      <h1>인공지능<span class="brand-dot">.</span></h1>
      <p>AGI, 피지컬 AI, 온디바이스 및 멀티모달 모델까지 변화하는 인공지능 기술의 본질과 엔지니어링 실무를 심층 분석합니다.</p>
      <div class="sub-category-pills">
        <a href={categoryPath('agi', 'ko')} class="pill pill-violet"># AGI</a>
        <a href={categoryPath('physical-ai', 'ko')} class="pill pill-orange"># 피지컬 AI</a>
        <a href={categoryPath('other-ai', 'ko')} class="pill pill-green"># 기타 AI</a>
      </div>
    </div>
  </header>
  <section class="listing">
    <div class="shell">
      <div class="post-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
      {posts.length === 0 && <p class="empty-state">새로운 글이 준비 중입니다.</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .sub-category-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.6rem;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.85rem;
    font-size: 0.76rem;
    font-weight: 750;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .pill:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }
  .pill-violet:hover { border-color: #8b5cf6; color: #8b5cf6; }
  .pill-orange:hover { border-color: #f97316; color: #f97316; }
  .pill-green:hover { border-color: #10b981; color: #10b981; }
</style>
