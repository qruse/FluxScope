---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout lang="ko" title="검색" description="HSL의 블로그에서 글을 검색하세요.">
  <header class="page-top"><div class="shell"><div class="section-kicker">기사 검색</div><h1>검색<span class="brand-dot">.</span></h1><p>아티클 아카이브를 검색합니다. 브라우저 내에서 즉시 색인 및 검색이 실행됩니다.</p></div></header>
  <section class="listing"><div class="shell">
    <div class="search-box"><label class="sr-only" for="search-input">기사 검색</label><input id="search-input" class="search-input" type="search" placeholder="“평가”, “워크플로우”, “데이터” 검색..." autocomplete="off" /><p id="search-status" class="search-status" role="status">검색어를 입력하면 실시간으로 결과가 표시됩니다.</p></div>
    <ul id="search-results" class="search-results"></ul>
  </div></section>
  <script>
    const input = document.querySelector<HTMLInputElement>('#search-input');
    const status = document.querySelector<HTMLElement>('#search-status');
    const list = document.querySelector<HTMLUListElement>('#search-results');
    let timer: ReturnType<typeof setTimeout>;
    let requestId = 0;
    input?.addEventListener('input', () => {
      clearTimeout(timer);
      const query = input.value.trim();
      const current = ++requestId;
      if (!query) {
        if (list) list.replaceChildren();
        if (status) status.textContent = '검색어를 입력하면 실시간으로 결과가 표시됩니다.';
        return;
      }
      if (status) status.textContent = '검색 중…';
      timer = setTimeout(async () => {
        try {
          const bundle = `${import.meta.env.BASE_URL}pagefind/pagefind.js`;
          const pagefind = await import(/* @vite-ignore */ bundle);
          await pagefind.options({ baseUrl: import.meta.env.BASE_URL });
          const search = await pagefind.search(query);
          const results = await Promise.all(search.results.slice(0, 12).map((item: { data: () => Promise<{ url: string; meta: { title: string }; plain_excerpt: string }> }) => item.data()));
          const dynamic = await fetch(`/api/search?lang=ko&q=${encodeURIComponent(query)}`).then((response) => response.ok ? response.json() : { posts: [] }).catch(() => ({ posts: [] }));
          if (current !== requestId || !list || !status) return;
          list.replaceChildren(...[...dynamic.posts.map((post: { url: string; title: string; description: string }) => ({ url: post.url, meta: { title: post.title }, plain_excerpt: post.description })), ...results].map((result) => {
            const li = document.createElement('li');
            const link = document.createElement('a');
            link.href = result.url;
            link.textContent = result.meta.title;
            const excerpt = document.createElement('p');
            excerpt.textContent = result.plain_excerpt;
            li.append(link, excerpt);
            return li;
          }));
          status.textContent = `${search.results.length + dynamic.posts.length}개의 결과를 찾았습니다.`;
        } catch (_) {
          if (status) status.textContent = '검색 기능은 프로덕션 빌드(npm run build) 후에 활성화됩니다.';
        }
      }, 180);
    });
  </script>
</BaseLayout>
