---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Search" description="Search all FluxScope articles on AI, cars, and smart farming.">
  <header class="page-top"><div class="shell"><div class="section-kicker">Find a story</div><h1>Search<span class="brand-dot">.</span></h1><p>Search the article archive. The index is stored with the site and runs in your browser.</p></div></header>
  <section class="listing"><div class="shell">
    <div class="search-box"><label class="sr-only" for="search-input">Search articles</label><input id="search-input" class="search-input" type="search" placeholder="Try “risk”, “braking”, or “soil”" autocomplete="off" /><p id="search-status" class="search-status" role="status">Start typing to search articles.</p></div>
    <ul id="search-results" class="search-results"></ul>
  </div></section>
  <script>
    const input = document.querySelector<HTMLInputElement>('#search-input');
    const status = document.querySelector<HTMLElement>('#search-status');
    const list = document.querySelector<HTMLUListElement>('#search-results');
    let timer: ReturnType<typeof setTimeout>;
    let requestId = 0;
    input?.addEventListener('input', () => {
      clearTimeout(timer);
      const query = input.value.trim();
      const current = ++requestId;
      if (!query) {
        if (list) list.replaceChildren();
        if (status) status.textContent = 'Start typing to search articles.';
        return;
      }
      if (status) status.textContent = 'Searching…';
      timer = setTimeout(async () => {
        try {
          const bundle = `${import.meta.env.BASE_URL}pagefind/pagefind.js`;
          const pagefind = await import(/* @vite-ignore */ bundle);
          const search = await pagefind.search(query);
          const results = await Promise.all(search.results.slice(0, 12).map((item: { data: () => Promise<{ url: string; meta: { title: string }; plain_excerpt: string }> }) => item.data()));
          if (current !== requestId || !list || !status) return;
          list.replaceChildren(...results.map((result) => {
            const li = document.createElement('li');
            const link = document.createElement('a');
            link.href = result.url;
            link.textContent = result.meta.title;
            const excerpt = document.createElement('p');
            excerpt.textContent = result.plain_excerpt;
            li.append(link, excerpt);
            return li;
          }));
          status.textContent = `${search.results.length} result${search.results.length === 1 ? '' : 's'} found.`;
        } catch (_) {
          if (status) status.textContent = 'Search is available after a production build. Run npm run build, then npm run preview.';
        }
      }, 180);
    });
  </script>
</BaseLayout>
