---
import { getCollection } from 'astro:content';
import PortfolioPost from '../../../components/PortfolioPost.astro';

export async function getStaticPaths() {
  const entries = await getCollection('portfolio', (e) => e.data.lang === 'en');
  return entries.map((entry) => ({ params: { slug: entry.id.split('/').pop() }, props: { entry } }));
}
const { entry } = Astro.props;
---
<PortfolioPost entry={entry} lang="en" />