---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { majorCategories, majorCategoryPath, publishedPosts } from '../../lib/site';

const allEnPosts = publishedPosts(await getCollection('posts'), 'en');

// AGI head post large
const headPost = allEnPosts.find((p) => p.data.category === 'agi') || allEnPosts[0];

// Sub posts 1 and 2 on the right
const subPosts = allEnPosts.filter((p) => p.id !== headPost.id).slice(0, 2);
---
<BaseLayout lang="en">
  <!-- 1. Lead Section: AGI Head Post Large + 2 Sub Posts on Right -->
  <section class="lead-section">
    <div class="shell">
      <div class="lead-grid">
        <div class="head-post">
          <PostCard post={headPost} featured={true} />
        </div>
        <div class="sub-posts">
          {subPosts.map((post) => (
            <PostCard post={post} compact={true} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Major Category Horizontal Scroll Slider (AI, Mobility, IT Devices) -->
  {Object.entries(majorCategories).map(([slug, major], index) => {
    const majorKey = slug as keyof typeof majorCategories;
    const categoryPosts = allEnPosts.filter((post) =>
      (major.subcategories as readonly string[]).includes(post.data.category)
    );
    return (
      <section class="topic-scroll-section">
        <div class="shell">
          <div class="section-head">
            <div>
              <div class="section-kicker">0{index + 1} / TOPIC</div>
              <h2>{major.name}</h2>
            </div>
            <a class="quiet-link" href={majorCategoryPath(majorKey, 'en')}>
              View all ↗
            </a>
          </div>
          <div class="horizontal-scroll-container">
            <div class="horizontal-scroll-track">
              {categoryPosts.map((post) => (
                <div class="scroll-item">
                  <PostCard post={post} />
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    );
  })}
</BaseLayout>
