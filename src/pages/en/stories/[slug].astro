---
import { getCollection } from 'astro:content';
import StoryPost from '../../../components/StoryPost.astro';

export async function getStaticPaths() {
  const entries = await getCollection('stories', (e) => e.data.lang === 'en');
  return entries.map((entry) => ({ params: { slug: entry.id.split('/').pop() }, props: { entry } }));
}
const { entry } = Astro.props;
---
<StoryPost entry={entry} lang="en" />
