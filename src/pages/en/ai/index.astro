---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { publishedPosts } from '../../../lib/site';

const posts = publishedPosts(await getCollection('posts'), 'en').filter((post) => post.data.category === 'ai');
---
<BaseLayout lang="en" title="AI" description="Models, robotics, on-device AI, and practical applications.">
  <header class="page-top">
    <div class="shell">
      <div class="section-kicker">Topic / AI</div>
      <h1>AI<span class="brand-dot">.</span></h1>
      <p>Models, robotics, on-device AI, and practical applications in one place.</p>
    </div>
  </header>
  <section class="listing">
    <div class="shell">
      <div class="post-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
      {posts.length === 0 && <p class="empty-state">New posts coming soon.</p>}
    </div>
  </section>
</BaseLayout>
