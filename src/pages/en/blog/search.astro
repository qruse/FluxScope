---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout noindex lang="en" title="Search" description="Search articles on HSL's Blog.">
  <header class="page-top"><div class="shell"><div class="section-kicker">Find a story</div><h1>Search<span class="brand-dot" aria-hidden="true"></span></h1><p>Search the article archive. The index is stored with the site and runs in your browser.</p></div></header>
  <section class="listing"><div class="shell">
    <div class="search-box"><label class="sr-only" for="search-input">Search articles</label><input id="search-input" class="search-input" type="search" placeholder="Try “risk”, “evaluation”, or “workflow”" autocomplete="off" /><p id="search-status" class="search-status" role="status">Start typing to search articles.</p></div>
    <ul id="search-results" class="search-results"></ul>
  </div></section>
  <script>
    const input = document.querySelector<HTMLInputElement>('#search-input');
    const status = document.querySelector<HTMLElement>('#search-status');
    const list = document.querySelector<HTMLUListElement>('#search-results');
    let timer: ReturnType<typeof setTimeout>;
    let requestId = 0;
    input?.addEventListener('input', () => {
      clearTimeout(timer);
      const query = input.value.trim();
      const current = ++requestId;
      if (!query) {
        if (list) list.replaceChildren();
        if (status) status.textContent = 'Start typing to search articles.';
        return;
      }
      if (status) status.textContent = 'Searching…';
      timer = setTimeout(async () => {
        try {
          const dynamic = await fetch(`/api/search?lang=en&q=${encodeURIComponent(query)}`).then((response) => response.ok ? response.json() : { posts: [] }).catch(() => ({ posts: [] }));
          if (current !== requestId || !list || !status) return;
          list.replaceChildren(...dynamic.posts.map((post: { url: string; title: string; description: string }) => ({ url: post.url, meta: { title: post.title }, plain_excerpt: post.description })).map((result: { url: string; meta: { title: string }; plain_excerpt: string }) => {
            const li = document.createElement('li');
            const link = document.createElement('a');
            link.href = result.url;
            link.textContent = result.meta.title;
            const excerpt = document.createElement('p');
            excerpt.textContent = result.plain_excerpt;
            li.append(link, excerpt);
            return li;
          }));
          const count = dynamic.posts.length;
          status.textContent = `${count} result${count === 1 ? '' : 's'} found.`;
        } catch (_) {
          if (status) status.textContent = 'Search failed. Please try again in a moment.';
        }
      }, 180);
    });
  </script>
</BaseLayout>
