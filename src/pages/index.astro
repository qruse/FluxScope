---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { majorCategories, majorCategoryPath, publishedPosts } from '../lib/site';

const allKoPosts = publishedPosts(await getCollection('posts'), 'ko');

// Lead: one slot per major category. The Worker swaps in a newer D1 post by category.
const latestIn = (category: keyof typeof majorCategories) => allKoPosts.find((p) => p.data.category === category);
const subSlots = (['mobility', 'it-devices'] as const).map((category) => ({ category, post: latestIn(category) }));
const headPost = latestIn('ai');
---
<BaseLayout lang="ko">
  <!-- 1. 리드 섹션 -->
  <h1 class="sr-only">HSL의 블로그: AI, 자동차, IT 기기 노트</h1>
  <section class="lead-section">
    <div class="shell">
      <div class="lead-grid">
        <div class="head-post" data-dynamic-lead="ai" data-lead-variant="featured" data-published={headPost?.data.publishedAt.toISOString()}>
          {headPost && <PostCard post={headPost} featured={true} />}
        </div>
        <div class="sub-posts">
          {subSlots.map(({ category, post }) => (
            <div class="sub-slot" data-dynamic-lead={category} data-lead-variant="compact" data-published={post?.data.publishedAt.toISOString()}>
              {post && <PostCard post={post} compact={true} />}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Category shortcuts; the full topic sliders below appear once a category has three posts -->
  <section class="topics home-topics">
    <div class="shell">
      <div class="topic-grid">
        {Object.entries(majorCategories).map(([slug, major], index) => {
          const majorKey = slug as keyof typeof majorCategories;
          const count = allKoPosts.filter((post) => post.data.category === majorKey).length;
          return (
            <a class="topic" href={majorCategoryPath(majorKey, 'ko')}>
              <div class="topic-top"><span>0{index + 1} / TOPIC</span><span aria-hidden="true">↗</span></div>
              <div>
                <h3>{major.nameKo}</h3>
                <p class="topic-count">글 <span data-dynamic-count={majorKey} data-static-count={count}>{count}</span>개</p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 2. 대분류별(AI / 모빌리티 / IT기기) 포스트 가로 스크롤 섹션 -->
  {Object.entries(majorCategories).map(([slug, major], index) => {
    const majorKey = slug as keyof typeof majorCategories;
    const categoryPosts = allKoPosts.filter((post) => post.data.category === majorKey);
    return (
      <section class="topic-scroll-section">
        <div class="shell">
          <div class="section-head">
            <div>
              <div class="section-kicker">0{index + 1} / TOPIC</div>
              <h2>{major.nameKo}</h2>
            </div>
            <a class="quiet-link" href={majorCategoryPath(majorKey, 'ko')}>
              전체보기 ↗
            </a>
          </div>
          <div class="horizontal-scroll-container">
            <div class="horizontal-scroll-track" data-dynamic-category={majorKey}>
              {categoryPosts.map((post) => (
                <div class="scroll-item">
                  <PostCard post={post} />
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    );
  })}
</BaseLayout>
