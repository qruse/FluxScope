---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { categories, categoryPath, publishedPosts } from '../lib/site';

const allKoPosts = publishedPosts(await getCollection('posts'), 'ko');

// AGI 헤드 포스트 하나 크게 (AGI 글 우선)
const headPost = allKoPosts.find((p) => p.data.category === 'agi') || allKoPosts[0];

// 우측 서브 포스트 1, 2 (헤드 포스트 제외한 글들)
const subPosts = allKoPosts.filter((p) => p.id !== headPost.id).slice(0, 2);
---
<BaseLayout lang="ko">
  <!-- 1. 리드 섹션: AGI 헤드 포스트 크게 + 우측 서브 포스트 1, 2 -->
  <section class="lead-section">
    <div class="shell">
      <div class="lead-grid">
        <div class="head-post">
          <PostCard post={headPost} featured={true} />
        </div>
        <div class="sub-posts">
          {subPosts.map((post) => (
            <PostCard post={post} compact={true} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 2. 각 주제별 포스트 가로로 넘기는 스타일 -->
  {Object.entries(categories).map(([slug, category], index) => {
    const categoryKey = slug as keyof typeof categories;
    const categoryPosts = allKoPosts.filter((post) => post.data.category === categoryKey);
    return (
      <section class="topic-scroll-section">
        <div class="shell">
          <div class="section-head">
            <div>
              <div class="section-kicker">0{index + 1} / TOPIC</div>
              <h2>{category.nameKo} ({category.name})</h2>
              <p>{category.descriptionKo}</p>
            </div>
            <a class="quiet-link" href={categoryPath(categoryKey, 'ko')}>
              전체보기 ↗
            </a>
          </div>
          <div class="horizontal-scroll-container">
            <div class="horizontal-scroll-track">
              {categoryPosts.map((post) => (
                <div class="scroll-item">
                  <PostCard post={post} />
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    );
  })}
</BaseLayout>
