---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { majorCategories, majorCategoryPath, publishedPosts } from '../lib/site';

const allKoPosts = publishedPosts(await getCollection('posts'), 'ko');

const headPost = allKoPosts.find((p) => p.data.category === 'ai') || allKoPosts[0];

// 우측 서브 포스트 1, 2 (헤드 포스트 제외한 글들)
const subPosts = allKoPosts.filter((p) => p.id !== headPost.id).slice(0, 2);
---
<BaseLayout lang="ko">
  <!-- 1. 리드 섹션 -->
  <section class="lead-section">
    <div class="shell">
      <div class="lead-grid">
        <div class="head-post">
          <PostCard post={headPost} featured={true} />
        </div>
        <div class="sub-posts">
          {subPosts.map((post) => (
            <PostCard post={post} compact={true} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 2. 대분류별(AI / 모빌리티 / IT기기) 포스트 가로 스크롤 섹션 -->
  {Object.entries(majorCategories).map(([slug, major], index) => {
    const majorKey = slug as keyof typeof majorCategories;
    const categoryPosts = allKoPosts.filter((post) => post.data.category === majorKey);
    return (
      <section class="topic-scroll-section">
        <div class="shell">
          <div class="section-head">
            <div>
              <div class="section-kicker">0{index + 1} / TOPIC</div>
              <h2>{major.nameKo}</h2>
            </div>
            <a class="quiet-link" href={majorCategoryPath(majorKey, 'ko')}>
              전체보기 ↗
            </a>
          </div>
          <div class="horizontal-scroll-container">
            <div class="horizontal-scroll-track">
              {categoryPosts.map((post) => (
                <div class="scroll-item">
                  <PostCard post={post} />
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    );
  })}
</BaseLayout>
